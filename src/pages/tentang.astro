---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Tentang Galacode | Digital Growth Studio"
  description="Galacode adalah Digital Growth Studio yang bantu bisnis bikin website yang dirancang buat narik calon pelanggan, mempermudah proses beli, dan dukung pertumbuhan usaha."
>
  <Header />

  <main class="overflow-x-hidden pt-24 md:pt-28">

    <!-- ============================================================ -->
    <!-- SECTION 1: HERO (Brand Identity)                             -->
    <!-- ============================================================ -->
    <section id="hero" class="relative py-16 md:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden bg-background">
      <div class="absolute top-[10%] left-[5%] w-[380px] sm:w-[550px] h-[380px] sm:h-[550px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/20 via-secondary/10 to-transparent rounded-full blur-[80px] -z-10 pointer-events-none transform-gpu"></div>
      <div class="absolute bottom-[5%] right-[5%] w-[320px] sm:w-[480px] h-[320px] sm:h-[480px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-accent/15 via-primary/5 to-transparent rounded-full blur-[70px] -z-10 pointer-events-none transform-gpu"></div>

      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Copy -->
        <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-primary/25 bg-primary/10 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.15em] text-primary">
              GALACODE • DIGITAL GROWTH STUDIO
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-black text-text-primary leading-[1.12] tracking-tight text-balance">
            Lebih dari Sekadar Bikin Website. <span class="text-primary">Kami Bantu Bisnis Anda Tumbuh.</span>
          </h1>

          <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-xl mx-auto lg:mx-0">
            Galacode adalah <strong class="text-text-primary">Digital Growth Studio</strong> yang fokus membantu bisnis ngubah pengunjung website jadi calon pelanggan lewat desain yang jelas, alur pakai yang gampang, dan struktur yang mengarah ke penjualan.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
            <a href="/contact" class="w-full sm:w-auto inline-flex justify-center items-center gap-2.5 bg-primary hover:bg-accent text-primary-foreground font-bold text-sm sm:text-base min-h-[52px] py-3.5 px-7 rounded-xl shadow-lg shadow-primary/20 transition-all duration-300 md:hover:scale-[1.03] active:scale-95">
              <span>Diskusi Soal Bisnis Anda</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href="/layanan" class="w-full sm:w-auto inline-flex justify-center items-center gap-2 border border-border/70 text-text-primary font-bold text-sm sm:text-base min-h-[52px] py-3.5 px-7 rounded-xl bg-surface hover:bg-surface-elevated transition-all duration-300 shadow-sm">
              Lihat Solusi Kami
            </a>
          </div>
        </div>

        <!-- Right Visual: Studio Growth Philosophy Card -->
        <div class="lg:col-span-6">
          <div class="bg-surface-elevated border border-border/80 rounded-3xl p-6 sm:p-8 shadow-soft-lg space-y-6">
            <div class="flex items-center justify-between border-b border-border/60 pb-4">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
                <span class="ml-2 text-xs font-mono text-text-muted">cara-pikir-galacode.ts</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-primary/10 text-primary border border-primary/20">Fokus Pertumbuhan</span>
            </div>

            <div class="bg-surface rounded-2xl p-5 font-mono text-xs text-text-secondary space-y-2 border border-border/60 overflow-x-auto">
              <div class="text-text-muted">// Kenapa website harus punya tujuan bisnis yang jelas</div>
              <div><span class="text-primary font-bold">const</span> strategiWebsite = &#123;</div>
              <div class="pl-4">tujuan: <span class="text-green-500">"Narik &amp; Konversi Pengunjung"</span>,</div>
              <div class="pl-4">desain: <span class="text-accent font-bold">"Jelas &amp; Enak Dibaca"</span>,</div>
              <div class="pl-4">pengalaman: <span class="text-secondary font-bold">"Bikin Proses Beli Gampang"</span>,</div>
              <div class="pl-4">siapTracking: <span class="text-green-500">true</span></div>
              <div>&#125;;</div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="p-4 rounded-xl bg-background border border-border/60">
                <div class="text-[10px] font-bold uppercase tracking-wider text-text-muted">Fokus Utama</div>
                <div class="text-sm font-extrabold text-text-primary mt-1">Peluang Penjualan</div>
              </div>
              <div class="p-4 rounded-xl bg-background border border-border/60">
                <div class="text-[10px] font-bold uppercase tracking-wider text-text-muted">Pendekatan</div>
                <div class="text-sm font-extrabold text-text-primary mt-1">Custom Sesuai Bisnis</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SECTION 2: WHY PURPOSE MATTERS                               -->
    <!-- ============================================================ -->
    <section id="purpose" class="py-20 md:py-28 bg-surface border-t border-border/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

          <div class="lg:col-span-5 space-y-5">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-border bg-background text-[11px] font-bold uppercase tracking-wider text-primary">
              Cara Pandang Kami
            </span>
            <h2 class="text-3xl sm:text-4xl font-black text-text-primary leading-tight tracking-tight">
              Kenapa Website Harus Punya <span class="text-primary">Tujuan Bisnis yang Jelas?</span>
            </h2>
            <p class="text-base text-text-secondary leading-relaxed">
              Banyak website dibuat cuma biar usaha "kelihatan ada web-nya". Akhirnya website sepi interaksi karena nggak dirancang buat jawab keraguan calon pembeli atau ngarahin mereka buat pesan.
            </p>
            <p class="text-base text-text-secondary leading-relaxed">
              Di Galacode, kami lihat website sebagai bagian dari mesin pertumbuhan bisnis. Setiap halaman harus punya peran: ngejelasin penawaran dengan cepat, bikin calon klien yakin, dan bikin mereka gampang buat menghubungi atau order.
            </p>
          </div>

          <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-sm">01</div>
              <h3 class="text-lg font-bold text-text-primary">Pahami Bisnisnya Dulu, Baru Desain</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                Kami nggak langsung nyodorin template. Kami gali dulu gimana bisnis Anda dapat pelanggan, pertanyaan apa yang paling sering masuk di chat, dan alur beli yang paling pas buat pelanggan Anda.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-black text-sm">02</div>
              <h3 class="text-lg font-bold text-text-primary">Desain Rapi &amp; Fungsional</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                Tampilan yang bagus bikin kesan pertama kuat, tapi fungsionalitas yang bikin pengunjung betah dan lanjut bertindak. Dua-duanya harus jalan bareng.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center font-black text-sm">03</div>
              <h3 class="text-lg font-bold text-text-primary">Enak Dipakai Pengunjung</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                Info produk, harga, dan cara pesan disusun biar gampang dipahami dalam hitungan detik — terutama pas dibuka dari HP.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-sm">04</div>
              <h3 class="text-lg font-bold text-text-primary">Realistis &amp; Berorientasi Konversi</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                Kami nggak kasih janji manis soal omzet naik instan. Yang kami pastikan, website Anda punya fondasi teknis, CTA, dan alur yang beneran ngedukung konversi.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SECTION 3: VISION, MISSION & PRINCIPLES                      -->
    <!-- ============================================================ -->
    <section id="vision-mission" class="py-20 md:py-28 bg-background border-t border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <div class="lg:col-span-6 bg-surface-elevated border border-border/80 rounded-3xl p-8 sm:p-10 relative overflow-hidden shadow-soft">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary via-secondary to-accent"></div>
            <div class="space-y-5">
              <span class="inline-flex px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider">Visi Kami</span>
              <blockquote class="text-2xl sm:text-3xl font-black text-text-primary leading-snug">
                "Bantu bisnis punya sistem digital yang bukan cuma numpang lewat di internet, tapi aktif ngedukung datangnya pelanggan dan peluang penjualan."
              </blockquote>
            </div>
          </div>

          <div class="lg:col-span-6 space-y-4">
            <span class="inline-flex px-3 py-1 rounded-full bg-secondary/10 text-secondary text-xs font-bold uppercase tracking-wider">Misi Kami</span>
            <div class="space-y-3">
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface border border-border/60">
                <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-xs shrink-0">1</div>
                <p class="text-sm text-text-secondary leading-relaxed">Ngerancang website yang komunikatif dan fokus sama tujuan bisnis masing-masing klien.</p>
              </div>
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface border border-border/60">
                <div class="w-7 h-7 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-bold text-xs shrink-0">2</div>
                <p class="text-sm text-text-secondary leading-relaxed">Bikin proses calon pelanggan nyari info, konsultasi, sampai order jadi jauh lebih simpel.</p>
              </div>
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface border border-border/60">
                <div class="w-7 h-7 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center font-bold text-xs shrink-0">3</div>
                <p class="text-sm text-text-secondary leading-relaxed">Menjaga standar kecepatan, tampilan mobile, dasar SEO, dan kesiapan tracking tetap optimal.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 4 Core Principles -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary">Punya Tujuan Jelas</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">Setiap bagian halaman punya fungsi yang jelas di alur perjalanan calon pelanggan.</p>
          </div>
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary">Transparan dari Awal</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">Cakupan kerja, fitur, dan biaya dijelasin terbuka sejak diskusi pertama.</p>
          </div>
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary">Rapi &amp; Ringan</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">Kode bersih, loading cepat, dan nyaman dibuka di desktop maupun HP.</p>
          </div>
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary">Siap Berkembang</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">Struktur website gampang ditambah fitur atau halaman baru seiring bisnis Anda besar.</p>
          </div>
        </div>

      </div>
    </section>

    <CTA />

  </main>

  <Footer />
</Layout>
