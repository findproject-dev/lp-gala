---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Data real proyek dari Portfolio
const previewProjects = [
  {
    name: "Gala Cafe",
    category: "Landing Page & Booking",
    desc: "Halaman promosi dan sistem pemesanan online dengan tampilan interaktif yang optimal di HP.",
    image: "/images/cover-findfein.png",
    demoUrl: "https://gala-cafe.vercel.app/",
    highlight: "Booking System",
  },
  {
    name: "Findsnaps",
    category: "Katalog & UMKM",
    desc: "Katalog menu interaktif dengan filter kategori produk dan pemesanan cepat via WhatsApp.",
    image: "/images/cover-findsnaps.png",
    demoUrl: "https://gala-photography-chi.vercel.app/",
    highlight: "Order WhatsApp",
  },
  {
    name: "Findwell",
    category: "Company Profile",
    desc: "Website profil perusahaan konstruksi modern dengan galeri portfolio proyek berkualitas tinggi.",
    image: "/images/cover-findwell.png",
    demoUrl: "https://web-construction-eight.vercel.app/",
    highlight: "High Performance",
  },
];
---

<Layout
  title="Tentang Galacode | Digital Development Studio"
  description="Galacode adalah digital development studio yang membantu bisnis membangun website dan sistem digital untuk memperkenalkan usaha, menjangkau pelanggan, serta mempermudah operasional bisnis."
>
  <Header />

  <main class="overflow-x-hidden pt-24 md:pt-28">

    <!-- ============================================================ -->
    <!-- SECTION 1: HERO (Two-Column Visual Studio Layout)            -->
    <!-- ============================================================ -->
    <section id="hero" class="relative min-h-[90vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-16 md:py-24 overflow-hidden bg-background">
      <!-- Ambient Glows -->
      <div class="absolute top-[10%] left-[5%] w-[380px] sm:w-[550px] h-[380px] sm:h-[550px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/20 via-secondary/10 to-transparent rounded-full blur-[80px] -z-10 pointer-events-none transform-gpu animate-pulse-slow"></div>
      <div class="absolute bottom-[5%] right-[5%] w-[320px] sm:w-[480px] h-[320px] sm:h-[480px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-accent/15 via-primary/5 to-transparent rounded-full blur-[70px] -z-10 pointer-events-none transform-gpu"></div>
      <div class="absolute inset-0 -z-10 opacity-[0.03] bg-[radial-gradient(circle,_#6D5EF7_1px,_transparent_1px)] bg-[size:32px_32px]"></div>

      <div class="max-w-7xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center relative z-10">
        
        <!-- Left Column: Studio Copy & Action (5 cols) -->
        <div class="lg:col-span-5 flex flex-col text-center lg:text-left space-y-6">
          <!-- Studio Eyebrow Tag -->
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-primary/25 bg-primary/10 shadow-sm animate-fade-in-up">
              <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
              <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.15em] text-primary">
                GALACODE • DIGITAL DEVELOPMENT STUDIO
              </span>
            </div>
          </div>

          <!-- Main Headline -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-black text-text-primary leading-[1.12] tracking-tight text-balance animate-fade-in-up" style="animation-delay: 100ms;">
            Building Digital Solutions <br class="hidden sm:inline" />
            <span class="text-primary bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">for a Better Business.</span>
          </h1>

          <!-- Concise Subtitle -->
          <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-xl mx-auto lg:mx-0 animate-fade-in-up" style="animation-delay: 200ms;">
            Galacode membantu bisnis membangun website dan sistem digital untuk memperkenalkan usaha, menjangkau pelanggan baru, serta menyederhanakan aktivitas bisnis Anda.
          </p>

          <!-- Dual CTAs -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2 animate-fade-in-up" style="animation-delay: 300ms;">
            <a 
              href="/contact" 
              class="group relative w-full sm:w-auto inline-flex justify-center items-center gap-2.5 bg-primary hover:bg-secondary text-primary-foreground font-bold text-sm sm:text-base min-h-[52px] py-3.5 px-7 rounded-xl shadow-lg shadow-primary/25 transition-all duration-300 md:hover:scale-[1.03] active:scale-95 overflow-hidden"
            >
              <span class="relative z-10">Konsultasi Gratis</span>
              <svg class="relative z-10 w-4 h-4 md:group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a 
              href="/portfolio" 
              class="w-full sm:w-auto inline-flex justify-center items-center gap-2 border border-border/70 text-text-primary font-bold text-sm sm:text-base min-h-[52px] py-3.5 px-7 rounded-xl bg-surface hover:bg-surface-elevated hover:border-border transition-all duration-300 md:hover:scale-[1.02] active:scale-95 shadow-sm"
            >
              Lihat Portfolio
            </a>
          </div>

          <!-- Micro Feature Badges -->
          <div class="pt-4 border-t border-border/50 flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs font-semibold text-text-muted animate-fade-in-up" style="animation-delay: 400ms;">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span>Nyaman di HP & PC</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span>Kecepatan Tinggi</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span>Struktur Rapi & Bersih</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Multi-Device Digital Showcase (7 cols) -->
        <div class="lg:col-span-7 relative flex items-center justify-center pt-4 lg:pt-0">
          
          <!-- Desktop Mockup Frame -->
          <div class="w-full max-w-[580px] bg-surface-elevated border border-border/70 rounded-2xl sm:rounded-3xl shadow-soft-lg overflow-hidden transition-all duration-500 group relative z-10 md:animate-float">
            <!-- Window Topbar -->
            <div class="px-4 py-3 border-b border-border/50 bg-surface/90 flex items-center justify-between gap-2">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
              </div>
              <!-- URL Bar -->
              <div class="flex-1 max-w-xs mx-auto bg-background/80 border border-border/60 rounded-lg px-3 py-1 flex items-center gap-2 text-[11px] text-text-muted">
                <svg class="w-3 h-3 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                <span class="truncate font-mono">https://galacode.id/demo/live</span>
              </div>
              <div class="w-8"></div>
            </div>

            <!-- Realistic Web UI Inside Window -->
            <div class="p-5 sm:p-7 space-y-5 bg-gradient-to-b from-surface-elevated to-surface">
              <!-- Mini Header / Nav inside browser -->
              <div class="flex items-center justify-between pb-4 border-b border-border/40">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-lg bg-primary flex items-center justify-center text-primary-foreground text-[10px] font-black">G</div>
                  <span class="text-xs font-bold tracking-wider text-text-primary">STUDIO PREVIEW</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="hidden sm:inline-block px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-green-500/10 text-green-500 border border-green-500/20">● Online</span>
                  <div class="w-16 sm:w-20 h-4 bg-primary/20 rounded-md"></div>
                </div>
              </div>

              <!-- Hero banner simulation inside mockup -->
              <div class="p-4 sm:p-5 rounded-xl bg-background border border-border/60 space-y-3 relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl"></div>
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-primary/10 text-[10px] font-bold text-primary">
                  Website Usaha
                </div>
                <h4 class="text-sm sm:text-base font-extrabold text-text-primary leading-tight">
                  Tingkatkan Kredibilitas Usaha dengan Website Rapi
                </h4>
                <p class="text-xs text-text-muted line-clamp-2">
                  Membantu calon pelanggan menemukan produk, membaca profil resmi, dan menghubungi Anda dalam 1 klik.
                </p>
                <div class="flex items-center gap-2 pt-1">
                  <div class="px-3 py-1.5 bg-primary text-primary-foreground text-[11px] font-bold rounded-lg shadow-sm">Pesan Sekarang</div>
                  <div class="px-3 py-1.5 bg-surface border border-border text-[11px] font-bold text-text-primary rounded-lg">Pelajari Produk</div>
                </div>
              </div>

              <!-- 3 Service Cards Simulation -->
              <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
                <div class="p-2.5 sm:p-3 rounded-xl bg-background border border-border/50 text-center space-y-1.5">
                  <div class="w-7 h-7 mx-auto rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
                  </div>
                  <div class="text-[11px] font-bold text-text-primary truncate">Web Profil</div>
                  <div class="text-[9px] text-text-muted">Resmi & Jelas</div>
                </div>

                <div class="p-2.5 sm:p-3 rounded-xl bg-background border border-border/50 text-center space-y-1.5">
                  <div class="w-7 h-7 mx-auto rounded-lg bg-accent/10 text-accent flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  </div>
                  <div class="text-[11px] font-bold text-text-primary truncate">Katalog Menu</div>
                  <div class="text-[9px] text-text-muted">Order Cepat</div>
                </div>

                <div class="p-2.5 sm:p-3 rounded-xl bg-background border border-border/50 text-center space-y-1.5">
                  <div class="w-7 h-7 mx-auto rounded-lg bg-secondary/10 text-secondary flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
                  </div>
                  <div class="text-[11px] font-bold text-text-primary truncate">Sistem Booking</div>
                  <div class="text-[9px] text-text-muted">Otomatisasi</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Overlapping Floating Smartphone Mockup -->
          <div class="hidden sm:block absolute -bottom-6 -right-3 md:-right-6 w-36 sm:w-44 bg-surface-elevated border-2 border-border/80 rounded-[2rem] shadow-2xl p-2.5 z-20 animate-float-delayed">
            <!-- Dynamic Island / Speaker notch -->
            <div class="w-12 h-3 bg-black/60 rounded-full mx-auto mb-2"></div>
            <!-- Mobile Screen Simulator -->
            <div class="bg-background rounded-[1.25rem] p-3 space-y-2 border border-border/40 text-[10px]">
              <div class="flex items-center justify-between">
                <span class="font-extrabold text-primary text-[9px]">GALACODE</span>
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
              </div>
              <div class="h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center font-bold text-text-primary text-[9px] text-center p-1">
                Katalog Produk Siap Pesan
              </div>
              <div class="space-y-1">
                <div class="h-2 w-3/4 bg-border/80 rounded"></div>
                <div class="h-2 w-1/2 bg-border/50 rounded"></div>
              </div>
              <div class="py-1.5 bg-green-500/10 border border-green-500/20 text-green-500 rounded-lg text-center font-bold text-[9px]">
                💬 Order WhatsApp
              </div>
            </div>
          </div>

          <!-- Performance Score Floating Pill -->
          <div class="absolute -top-3 -left-3 sm:-left-6 bg-surface-elevated/95 backdrop-blur-md border border-border/80 px-4 py-2.5 rounded-2xl shadow-lg flex items-center gap-3 z-20 animate-float-fast">
            <div class="w-9 h-9 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center font-black text-green-500 text-sm">
              99
            </div>
            <div>
              <div class="text-[10px] font-extrabold uppercase tracking-wider text-green-500">Google Lighthouse</div>
              <div class="text-xs font-bold text-text-primary">Kecepatan Optimal</div>
            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- ============================================================ -->
    <!-- SECTION 2: WHO WE ARE (Editorial + Studio Workbench Visual) -->
    <!-- ============================================================ -->
    <section id="who-we-are" class="py-20 md:py-28 bg-surface border-t border-border/50 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Left: Editorial Content (5 cols) -->
          <div class="lg:col-span-5 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-border bg-background shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
              <span class="text-[11px] font-bold uppercase tracking-wider text-text-primary">Siapa Kami?</span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-text-primary leading-[1.15] tracking-tight">
              Partner Digital untuk Membantu <span class="text-primary">Bisnis Berkembang.</span>
            </h2>

            <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
              Galacode adalah studio pengembangan website dan sistem digital. Kami tidak memakai pendekatan template generik satu-desain-untuk-semua. 
            </p>

            <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
              Setiap website atau sistem kami rancang khusus berdasarkan kebutuhan riil bisnis Anda: mulai dari bisnis yang baru memulai kehadiran online, memperbarui website lama yang usang, hingga membangun sistem otomatisasi operasional.
            </p>

            <!-- 3 Situational Focus Pills -->
            <div class="space-y-3 pt-2">
              <div class="flex items-start gap-3 p-3 rounded-xl bg-background border border-border/60">
                <div class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-text-primary">Belum Punya Website</h4>
                  <p class="text-xs text-text-muted">Membangun tempat resmi bisnis di internet agar langsung terpercaya di mata calon pelanggan.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-background border border-border/60">
                <div class="w-6 h-6 rounded-lg bg-accent/10 text-accent flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-text-primary">Website Lama Perlu Pembaruan</h4>
                  <p class="text-xs text-text-muted">Redesign tampilan usang agar modern, cepat dibuka, dan nyaman saat diakses dari HP.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-background border border-border/60">
                <div class="w-6 h-6 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-text-primary">Butuh Sistem Operasional</h4>
                  <p class="text-xs text-text-muted">Mengembangkan sistem booking, manajemen data, dan form pesanan otomatis via web.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Studio Workbench / Architecture Visual (7 cols) -->
          <div class="lg:col-span-7">
            <div class="relative bg-background border border-border/80 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-soft-lg space-y-6">
              
              <!-- Top Header of Workbench -->
              <div class="flex items-center justify-between border-b border-border/60 pb-4">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
                  <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
                  <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
                  <span class="ml-2 text-xs font-mono text-text-muted">galacode-architecture.ts</span>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-primary/10 text-primary border border-primary/20">Production Ready</span>
              </div>

              <!-- Interactive-looking Code & Visual Blueprint Split -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-stretch">
                <!-- Clean Code Block -->
                <div class="bg-surface rounded-xl p-4 font-mono text-xs text-text-secondary space-y-2 border border-border/60 overflow-x-auto">
                  <div class="text-text-muted">// Galacode Design Approach</div>
                  <div><span class="text-primary font-bold">const</span> solution = &#123;</div>
                  <div class="pl-4">clientGoal: <span class="text-green-500">"Kredibilitas Nyata"</span>,</div>
                  <div class="pl-4">responsive: <span class="text-accent font-bold">true</span>,</div>
                  <div class="pl-4">loadingSpeed: <span class="text-secondary font-bold">"&lt; 1 detik"</span>,</div>
                  <div class="pl-4">simplicity: <span class="text-green-500">"Mudah Digunakan"</span>,</div>
                  <div class="pl-4">architecture: <span class="text-primary">"Astro + Tailwind"</span></div>
                  <div>&#125;;</div>
                  <div class="pt-2 text-green-500">// Result: Bisnis Rapi & Efisien</div>
                </div>

                <!-- Visual Metrics & Quality Cards -->
                <div class="space-y-3 flex flex-col justify-between">
                  <div class="p-3.5 rounded-xl bg-surface border border-border/60 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] font-bold text-text-muted uppercase">Desain Eksklusif</div>
                      <div class="text-sm font-extrabold text-text-primary">Bukan Template Generik</div>
                    </div>
                    <span class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">✓</span>
                  </div>

                  <div class="p-3.5 rounded-xl bg-surface border border-border/60 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] font-bold text-text-muted uppercase">Pengalaman Pengguna</div>
                      <div class="text-sm font-extrabold text-text-primary">Sangat Nyaman di Layar HP</div>
                    </div>
                    <span class="w-7 h-7 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-bold text-xs">✓</span>
                  </div>

                  <div class="p-3.5 rounded-xl bg-surface border border-border/60 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] font-bold text-text-muted uppercase">Dukungan Teknis</div>
                      <div class="text-sm font-extrabold text-text-primary">Transparan & Bertanggung Jawab</div>
                    </div>
                    <span class="w-7 h-7 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center font-bold text-xs">✓</span>
                  </div>
                </div>
              </div>

              <!-- Bottom Tagline Pill -->
              <div class="p-3 bg-surface rounded-xl border border-border/50 flex items-center justify-between text-xs">
                <span class="text-text-muted">Fokus: <strong class="text-text-primary">Solusi Bisnis Nyata</strong></span>
                <span class="text-primary font-semibold">Bukan Jargon Rumit →</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ============================================================ -->
    <!-- SECTION 3: MENGAPA BISNIS MEMBUTUHKAN WEBSITE? (Visual Cards)-->
    <!-- ============================================================ -->
    <section id="why-website" class="py-20 md:py-28 bg-background border-t border-border/40 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Section Header -->
        <div class="max-w-3xl mx-auto text-center mb-14 md:mb-18 space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-primary/25 bg-primary/10 shadow-sm">
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary">Kebutuhan Bisnis</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-text-primary tracking-tight">
            Mengapa Bisnis Anda <span class="text-primary">Membutuhkan Website?</span>
          </h2>
          <p class="text-base sm:text-lg text-text-secondary leading-relaxed text-balance">
            Di era digital, calon pelanggan mencari informasi di internet sebelum memutuskan membeli. Website resmi memastikan bisnis Anda tampil meyakinkan saat mereka mencarinya.
          </p>
        </div>

        <!-- 4 Visual Benefit Cards -->
