---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PricingHero from "../components/pricing/PricingHero.astro";
import PricingPackages from "../components/pricing/PricingPackages.astro";
import PricingComparison from "../components/pricing/PricingComparison.astro";
import PricingIncluded from "../components/pricing/PricingIncluded.astro";
import PricingFAQ from "../components/pricing/PricingFAQ.astro";
import PricingCTA from "../components/pricing/PricingCTA.astro";
---

<Layout title="Pricing - GALACODE">
  <!-- 
    Background setup for the Pricing page: 
    - Soft gradient base
    - Subtle noise texture
    - Large blurred gradient orbs for premium lighting and visual depth 
  -->
  <div class="relative min-h-screen bg-background overflow-hidden">
    <!-- Noise texture overlay -->
    <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none bg-[url('/noise.png')] bg-repeat" style="transform: translateZ(0);"></div>
    
    <!-- Blurred gradient orbs -->
    <div class="absolute top-0 -left-1/4 w-[1000px] h-[1000px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-border/50 to-transparent rounded-full blur-[32px] pointer-events-none opacity-50 transform-gpu"></div>
    <div class="absolute top-1/4 -right-1/4 w-[800px] h-[800px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/30 to-transparent rounded-full blur-[32px] pointer-events-none opacity-60 transform-gpu"></div>
    <div class="absolute bottom-1/4 left-1/3 w-[600px] h-[600px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-border/40 to-transparent rounded-full blur-[32px] pointer-events-none opacity-40 transform-gpu"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <Header />
      
      <main class="flex-grow pt-32 pb-24 space-y-32 md:space-y-48">
        <PricingHero />
        <PricingPackages />
        <PricingComparison />
        <PricingIncluded />
        <PricingFAQ />
        <PricingCTA />
      </main>
    </div>
  </div>
</Layout>
