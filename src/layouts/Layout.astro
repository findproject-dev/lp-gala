---
import "../styles/global.css";
import { t, getLocalizedPath, stripLocalePrefix, type Locale, type TranslationKey } from "../i18n";

interface Props {
	title?: string;
	description?: string;
	lang?: Locale;
	pageKey?: "home" | "tentang" | "layanan" | "portfolio" | "pricing" | "faq" | "contact";
}

const {
	lang = "id",
	pageKey = "home",
	title = t(lang, `meta.${pageKey}.title` as TranslationKey),
	description = t(lang, `meta.${pageKey}.description` as TranslationKey),
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://galacode.id";
const basePath = stripLocalePrefix(Astro.url.pathname);
const idPath = getLocalizedPath(basePath, "id");
const enPath = getLocalizedPath(basePath, "en");
const canonicalPath = getLocalizedPath(basePath, lang);

const idUrl = `${siteOrigin}${idPath}`;
const enUrl = `${siteOrigin}${enPath}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;
---

<!doctype html>
<html lang={lang} data-page-key={pageKey}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="id" href={idUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={idUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Preload Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Poller+One&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Poller+One&display=swap" rel="stylesheet">
		</noscript>
		
		<!-- Theme & Language Initialization -->
		<script is:inline>
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'light'; // Default to Galaxy Light
			};
			const theme = getTheme();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			window.localStorage.setItem('theme', theme);

			// Language persistence across visits & refreshes
			(function () {
				var pathname = window.location.pathname;
				var isEnRoute = pathname === '/en' || pathname === '/en/' || pathname.startsWith('/en/');
				if (isEnRoute) {
					localStorage.setItem('galacode_lang', 'en');
				} else {
					var savedLang = localStorage.getItem('galacode_lang');
					if (savedLang === 'en') {
						var targetPath = pathname === '/' ? '/en' : '/en' + pathname;
						window.location.replace(targetPath + window.location.search + window.location.hash);
					}
				}
			})();
		</script>
	</head>
	<body class="bg-background text-text-primary font-inter antialiased selection:bg-primary/20 selection:text-text-primary relative min-h-screen">
		<!-- Noise Overlay -->
		<div class="pointer-events-none fixed inset-0 z-50 opacity-[0.04] bg-[url('/noise.png')] bg-repeat" style="transform: translateZ(0);"></div>
		
		<!-- Stars Background -->
		<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
			<div class="absolute top-[15%] left-[20%] w-1 h-1 bg-white rounded-full opacity-40 animate-twinkle transform-gpu"></div>
			<div class="absolute top-[45%] left-[80%] w-1.5 h-1.5 bg-white rounded-full opacity-30 animate-twinkle transform-gpu" style="animation-delay: 1s;"></div>
			<div class="absolute top-[75%] left-[30%] w-1 h-1 bg-white rounded-full opacity-50 animate-twinkle transform-gpu" style="animation-delay: 2.5s;"></div>
			<div class="absolute top-[25%] left-[70%] w-1 h-1 bg-white rounded-full opacity-20 animate-twinkle transform-gpu" style="animation-delay: 1.5s;"></div>
			<div class="absolute top-[85%] left-[85%] w-1 h-1 bg-white rounded-full opacity-40 animate-twinkle transform-gpu" style="animation-delay: 0.5s;"></div>
			<div class="absolute top-[10%] left-[50%] w-1.5 h-1.5 bg-white rounded-full opacity-30 animate-twinkle transform-gpu" style="animation-delay: 3s;"></div>
		</div>

		<div class="relative z-10">
			<slot />
		</div>

		<script>
			import Lenis from 'lenis';

			// Initialize Lenis for premium smooth inertia scrolling
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			if (!prefersReducedMotion.matches) {
				const lenis = new Lenis({
					lerp: 0.1,
					wheelMultiplier: 0.8,
					smoothWheel: true,
					smoothTouch: false,
				});

				function raf(time: number) {
					lenis.raf(time);
					requestAnimationFrame(raf);
				}

				requestAnimationFrame(raf);
			}
		</script>

		<!-- Global Animation Optimization Script -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				if (prefersReducedMotion.matches) return;

				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							(entry.target as HTMLElement).style.animationPlayState = 'running';
						} else {
							(entry.target as HTMLElement).style.animationPlayState = 'paused';
						}
					});
				}, { rootMargin: '100px' });

				const animatedElements = document.querySelectorAll(
					'.animate-twinkle, .animate-float, .animate-pulse, .animate-pulse-slow, md\\:animate-float, .animate-float-delayed, .animate-float-fast'
				);
				
				animatedElements.forEach(el => {
					observer.observe(el);
				});
			});
		</script>
	</body>
</html>
