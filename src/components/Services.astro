---
// src/components/Services.astro — Solusi yang Kami Bangun
import { t, getLocalizedPath, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;
---

<section id="services" class="bg-surface py-24 md:py-32 relative border-t border-glass-5">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="services-header max-w-3xl mx-auto text-center mb-14 md:mb-20">
      <span class="inline-flex items-center gap-2 px-3 md:px-4 py-1.5 rounded-full border border-primary/20 bg-primary/10 text-primary font-bold tracking-widest uppercase text-[10px] md:text-xs mb-5" data-i18n="services.badge">
        {t(lang, "services.badge")}
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight text-balance mb-4" data-i18n-html="services.headline" set:html={t(lang, "services.headline")} />
      <p class="mt-4 md:mt-5 text-base sm:text-lg text-text-secondary leading-relaxed text-balance px-2 md:px-0" data-i18n="services.subtitle">
        {t(lang, "services.subtitle")}
      </p>
    </div>

    <!-- Services Grid: 2x2 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">

      <!-- Service 1: Lead Generation Website -->
      <div class="services-card group relative bg-background border border-border/70 rounded-2xl md:rounded-3xl p-7 md:p-8 flex flex-col overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-primary/40 md:hover:shadow-soft-lg active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/8 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="flex items-start justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary md:group-hover:scale-110 md:group-hover:bg-primary/20 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-primary bg-primary/10 border border-primary/20 px-2.5 py-1 rounded-full">01</span>
          </div>

          <div class="space-y-3 flex-1">
            <h3 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight" data-i18n="services.1.title">{t(lang, "services.1.title")}</h3>
            <p class="text-text-secondary text-sm md:text-base leading-relaxed" data-i18n="services.1.desc">
              {t(lang, "services.1.desc")}
            </p>

            <div class="space-y-2 pt-2">
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.1.b1">{t(lang, "services.1.b1")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.1.b2">{t(lang, "services.1.b2")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.1.b3">{t(lang, "services.1.b3")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.1.b4">{t(lang, "services.1.b4")}</span>
              </div>
            </div>

            <div class="mt-4 p-3.5 bg-primary/5 border border-primary/15 rounded-xl text-sm text-text-secondary leading-relaxed">
              <strong class="text-text-primary" data-i18n="services.suitablePrefix">{t(lang, "services.suitablePrefix")}</strong> <span data-i18n="services.1.suitable">{t(lang, "services.1.suitable")}</span>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-border/40 flex items-center justify-between gap-4">
            <a href={getLocalizedPath("/contact", lang)} data-base-href="/contact" class="inline-flex items-center gap-2 text-sm font-bold text-primary md:hover:text-accent transition-colors">
              <span data-i18n="services.discussCta">{t(lang, "services.discussCta")}</span>
              <svg class="w-4 h-4 md:group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href={`${getLocalizedPath("/layanan", lang)}#lead-generation`} data-base-href="/layanan#lead-generation" class="text-xs font-semibold text-text-muted hover:text-text-primary transition-colors" data-i18n="services.detailLink">{t(lang, "services.detailLink")}</a>
          </div>
        </div>
      </div>

      <!-- Service 2: Booking Website -->
      <div class="services-card group relative bg-background border border-border/70 rounded-2xl md:rounded-3xl p-7 md:p-8 flex flex-col overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-accent/40 md:hover:shadow-soft-lg active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-accent/8 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="flex items-start justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent md:group-hover:scale-110 md:group-hover:bg-accent/20 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-accent bg-accent/10 border border-accent/20 px-2.5 py-1 rounded-full">02</span>
          </div>

          <div class="space-y-3 flex-1">
            <h3 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight" data-i18n="services.2.title">{t(lang, "services.2.title")}</h3>
            <p class="text-text-secondary text-sm md:text-base leading-relaxed" data-i18n="services.2.desc">
              {t(lang, "services.2.desc")}
            </p>

            <div class="space-y-2 pt-2">
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></div>
                <span data-i18n="services.2.b1">{t(lang, "services.2.b1")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></div>
                <span data-i18n="services.2.b2">{t(lang, "services.2.b2")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></div>
                <span data-i18n="services.2.b3">{t(lang, "services.2.b3")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></div>
                <span data-i18n="services.2.b4">{t(lang, "services.2.b4")}</span>
              </div>
            </div>

            <div class="mt-4 p-3.5 bg-accent/5 border border-accent/15 rounded-xl text-sm text-text-secondary leading-relaxed">
              <strong class="text-text-primary" data-i18n="services.suitablePrefix">{t(lang, "services.suitablePrefix")}</strong> <span data-i18n="services.2.suitable">{t(lang, "services.2.suitable")}</span>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-border/40 flex items-center justify-between gap-4">
            <a href={getLocalizedPath("/contact", lang)} data-base-href="/contact" class="inline-flex items-center gap-2 text-sm font-bold text-accent md:hover:text-primary transition-colors">
              <span data-i18n="services.discussCta">{t(lang, "services.discussCta")}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href={`${getLocalizedPath("/layanan", lang)}#booking`} data-base-href="/layanan#booking" class="text-xs font-semibold text-text-muted hover:text-text-primary transition-colors" data-i18n="services.detailLink">{t(lang, "services.detailLink")}</a>
          </div>
        </div>
      </div>

      <!-- Service 3: Sales Website -->
      <div class="services-card group relative bg-background border border-border/70 rounded-2xl md:rounded-3xl p-7 md:p-8 flex flex-col overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-secondary/40 md:hover:shadow-soft-lg active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-secondary/8 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="flex items-start justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary md:group-hover:scale-110 md:group-hover:bg-secondary/20 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-secondary bg-secondary/10 border border-secondary/20 px-2.5 py-1 rounded-full">03</span>
          </div>

          <div class="space-y-3 flex-1">
            <h3 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight" data-i18n="services.3.title">{t(lang, "services.3.title")}</h3>
            <p class="text-text-secondary text-sm md:text-base leading-relaxed" data-i18n="services.3.desc">
              {t(lang, "services.3.desc")}
            </p>

            <div class="space-y-2 pt-2">
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0"></div>
                <span data-i18n="services.3.b1">{t(lang, "services.3.b1")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0"></div>
                <span data-i18n="services.3.b2">{t(lang, "services.3.b2")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0"></div>
                <span data-i18n="services.3.b3">{t(lang, "services.3.b3")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0"></div>
                <span data-i18n="services.3.b4">{t(lang, "services.3.b4")}</span>
              </div>
            </div>

            <div class="mt-4 p-3.5 bg-secondary/5 border border-secondary/15 rounded-xl text-sm text-text-secondary leading-relaxed">
              <strong class="text-text-primary" data-i18n="services.suitablePrefix">{t(lang, "services.suitablePrefix")}</strong> <span data-i18n="services.3.suitable">{t(lang, "services.3.suitable")}</span>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-border/40 flex items-center justify-between gap-4">
            <a href={getLocalizedPath("/contact", lang)} data-base-href="/contact" class="inline-flex items-center gap-2 text-sm font-bold text-secondary md:hover:text-primary transition-colors">
              <span data-i18n="services.discussCta">{t(lang, "services.discussCta")}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href={`${getLocalizedPath("/layanan", lang)}#sales`} data-base-href="/layanan#sales" class="text-xs font-semibold text-text-muted hover:text-text-primary transition-colors" data-i18n="services.detailLink">{t(lang, "services.detailLink")}</a>
          </div>
        </div>
      </div>

      <!-- Service 4: Business Website -->
      <div class="services-card group relative bg-background border border-border/70 rounded-2xl md:rounded-3xl p-7 md:p-8 flex flex-col overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-primary/40 md:hover:shadow-soft-lg active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/8 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="flex items-start justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary md:group-hover:scale-110 md:group-hover:bg-primary/20 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-primary bg-primary/10 border border-primary/20 px-2.5 py-1 rounded-full">04</span>
          </div>

          <div class="space-y-3 flex-1">
            <h3 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight" data-i18n="services.4.title">{t(lang, "services.4.title")}</h3>
            <p class="text-text-secondary text-sm md:text-base leading-relaxed" data-i18n="services.4.desc">
              {t(lang, "services.4.desc")}
            </p>

            <div class="space-y-2 pt-2">
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.4.b1">{t(lang, "services.4.b1")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.4.b2">{t(lang, "services.4.b2")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.4.b3">{t(lang, "services.4.b3")}</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-text-secondary">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span data-i18n="services.4.b4">{t(lang, "services.4.b4")}</span>
              </div>
            </div>

            <div class="mt-4 p-3.5 bg-primary/5 border border-primary/15 rounded-xl text-sm text-text-secondary leading-relaxed">
              <strong class="text-text-primary" data-i18n="services.suitablePrefix">{t(lang, "services.suitablePrefix")}</strong> <span data-i18n="services.4.suitable">{t(lang, "services.4.suitable")}</span>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-border/40 flex items-center justify-between gap-4">
            <a href={getLocalizedPath("/contact", lang)} data-base-href="/contact" class="inline-flex items-center gap-2 text-sm font-bold text-primary md:hover:text-accent transition-colors">
              <span data-i18n="services.discussCta">{t(lang, "services.discussCta")}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href={`${getLocalizedPath("/layanan", lang)}#business`} data-base-href="/layanan#business" class="text-xs font-semibold text-text-muted hover:text-text-primary transition-colors" data-i18n="services.detailLink">{t(lang, "services.detailLink")}</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom CTA -->
    <div class="services-bottom text-center mt-14 md:mt-20 px-4 md:px-0">
      <p class="text-sm text-text-muted mb-2 font-medium" data-i18n="services.bottom.eyebrow">{t(lang, "services.bottom.eyebrow")}</p>
      <h3 class="text-2xl md:text-3xl font-bold text-text-primary text-balance mb-3 md:mb-4" data-i18n="services.bottom.title">
        {t(lang, "services.bottom.title")}
      </h3>
      <p class="max-w-xl mx-auto text-base text-text-secondary text-balance mb-7" data-i18n="services.bottom.desc">
        {t(lang, "services.bottom.desc")}
      </p>
      <a href={getLocalizedPath("/contact", lang)} data-base-href="/contact" class="inline-flex justify-center items-center gap-2.5 bg-primary hover:bg-accent text-primary-foreground font-bold py-4 px-10 rounded-xl min-h-[56px] shadow-md transition-all duration-300 md:hover:scale-105 active:scale-95 w-full sm:w-auto">
        <span data-i18n="services.bottom.cta">{t(lang, "services.bottom.cta")}</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>

  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const header = document.querySelector(".services-header");
    const cards = document.querySelectorAll(".services-card");
    const bottom = document.querySelector(".services-bottom");

    if (header) (header as HTMLElement).style.opacity = "0";
    if (bottom) (bottom as HTMLElement).style.opacity = "0";
    cards.forEach(c => (c as HTMLElement).style.opacity = "0");

    let animated = false;
    if (header) {
      inView(header, () => {
        if (animated) return;
        animated = true;

        const isMobile = window.innerWidth < 768;
        const yOffset = isMobile ? 16 : 28;

        animate(header, { opacity: [0, 1], y: [yOffset, 0] }, { duration: 0.6, easing: [0.22, 1, 0.36, 1] });

        setTimeout(() => {
          animate(".services-card", { opacity: [0, 1], y: [yOffset, 0] }, { duration: 0.6, delay: stagger(isMobile ? 0.05 : 0.1), easing: [0.22, 1, 0.36, 1] });
        }, 200);

        if (bottom) {
          setTimeout(() => {
            animate(bottom, { opacity: [0, 1], y: [yOffset, 0] }, { duration: 0.6, easing: [0.22, 1, 0.36, 1] });
          }, 650);
        }
      }, { margin: "-15% 0px" });
    }
  }
</script>
