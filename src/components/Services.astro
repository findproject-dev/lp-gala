---
// src/components/Services.astro
---

<section id="services" class="bg-background py-24 md:py-32 relative border-t border-glass-5">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header Area -->
    <div class="services-header max-w-3xl mx-auto text-center mb-12 md:mb-20">
      <span class="inline-flex items-center gap-2 px-3 md:px-4 py-1.5 rounded-full border border-primary/20 bg-primary/10 text-primary font-semibold tracking-wider uppercase text-[10px] md:text-xs mb-4 shadow-[0_0_15px_rgba(37,99,235,0.1)]">
        Pilihan Website
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight text-balance mb-4 md:mb-0">
        Pilih Sesuai <span class="text-primary block md:inline mt-1 md:mt-0">Kebutuhan Bisnis</span>
      </h2>
      <p class="mt-4 md:mt-6 text-base sm:text-lg text-text-secondary leading-relaxed text-balance px-2 md:px-0">
        Setiap bisnis punya alur beda. Pilih struktur website yang paling pas dengan cara kerja Anda.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">

      <!-- Card -->
      <div class="services-card group relative bg-surface-elevated border border-border rounded-2xl p-6 md:p-8 transition-all duration-300 ease-out md:hover:-translate-y-1 md:hover:shadow-md md:hover:border-primary/40 active:scale-[0.98] active:bg-surface-elevated/80 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-2xl bg-glass-5 border border-border flex items-center justify-center mb-5 md:mb-6 text-primary md:group-hover:scale-110 md:group-hover:bg-primary/10 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="m14 14 3-3-3-3"/><path d="M3 11v8a2 2 0 0 0 2 2h4"/><path d="M3 11V6a2 2 0 0 1 2-2h4"/><path d="M9 14 6 11 9 8"/></svg>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">Halaman Promo Khusus</h3>
          <div class="space-y-3">
             <p class="text-text-secondary leading-relaxed text-sm">
               Fokus pada satu produk unggulan. Tampil detail dengan tombol pesan langsung ke WhatsApp.
             </p>
             <div class="flex flex-wrap gap-2 pt-2">
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Satu Halaman</span>
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Tujuan Spesifik</span>
             </div>
          </div>
        </div>
      </div>

      <!-- Card -->
      <div class="services-card group relative bg-surface-elevated border border-border rounded-2xl p-6 md:p-8 transition-all duration-300 ease-out md:hover:-translate-y-1 md:hover:shadow-md md:hover:border-primary/40 active:scale-[0.98] active:bg-surface-elevated/80 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-2xl bg-glass-5 border border-border flex items-center justify-center mb-5 md:mb-6 text-primary md:group-hover:scale-110 md:group-hover:bg-primary/10 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">Profil Usaha Lengkap</h3>
          <div class="space-y-3">
             <p class="text-text-secondary leading-relaxed text-sm">
               Tampilkan info legal, alamat, dan daftar layanan resmi untuk yakinkan mitra atau klien baru.
             </p>
             <div class="flex flex-wrap gap-2 pt-2">
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Identitas Bisnis</span>
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Lengkap</span>
             </div>
          </div>
        </div>
      </div>

      <!-- Card -->
      <div class="services-card group relative bg-surface-elevated border border-border rounded-2xl p-6 md:p-8 transition-all duration-300 ease-out md:hover:-translate-y-1 md:hover:shadow-md md:hover:border-primary/40 active:scale-[0.98] active:bg-surface-elevated/80 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-2xl bg-glass-5 border border-border flex items-center justify-center mb-5 md:mb-6 text-primary md:group-hover:scale-110 md:group-hover:bg-primary/10 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">Katalog & Order</h3>
          <div class="space-y-3">
             <p class="text-text-secondary leading-relaxed text-sm">
               Daftar produk rapi dengan filter. Mudahkan pembeli memilih dan langsung order ke Anda.
             </p>
             <div class="flex flex-wrap gap-2 pt-2">
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">List Barang</span>
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Pilih & Pesan</span>
             </div>
          </div>
        </div>
      </div>

      <!-- Card -->
      <div class="services-card group relative bg-surface-elevated border border-border rounded-2xl p-6 md:p-8 transition-all duration-300 ease-out md:hover:-translate-y-1 md:hover:shadow-md md:hover:border-primary/40 active:scale-[0.98] active:bg-surface-elevated/80 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-2xl bg-glass-5 border border-border flex items-center justify-center mb-5 md:mb-6 text-primary md:group-hover:scale-110 md:group-hover:bg-primary/10 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.16 3.84a2.76 2.76 0 0 0-3.92 0l-12.4 12.4a2 2 0 0 0-.5.98l-.78 4.71a.75.75 0 0 0 .9.9l4.72-.78a2 2 0 0 0 .98-.5l12.4-12.4a2.76 2.76 0 0 0 0-3.92Z"/><path d="m16.5 7.5 4 4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">Galeri & Rekam Jejak</h3>
          <div class="space-y-3">
             <p class="text-text-secondary leading-relaxed text-sm">
               Kumpulkan foto hasil proyek Anda dalam satu galeri rapi sebagai bukti nyata rekam jejak bisnis.
             </p>
             <div class="flex flex-wrap gap-2 pt-2">
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Galeri Foto</span>
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Riwayat Proyek</span>
             </div>
          </div>
        </div>
      </div>

      <!-- Card -->
      <div class="services-card group relative bg-surface-elevated border border-border rounded-2xl p-6 md:p-8 transition-all duration-300 ease-out md:hover:-translate-y-1 md:hover:shadow-md md:hover:border-primary/40 active:scale-[0.98] active:bg-surface-elevated/80 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-2xl bg-glass-5 border border-border flex items-center justify-center mb-5 md:mb-6 text-primary md:group-hover:scale-110 md:group-hover:bg-primary/10 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">Info Bisnis & Cabang</h3>
          <div class="space-y-3">
             <p class="text-text-secondary leading-relaxed text-sm">
               Pusat info lokasi, jam buka, dan peta petunjuk arah agar pelanggan mudah berkunjung langsung.
             </p>
             <div class="flex flex-wrap gap-2 pt-2">
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Peta Lokasi</span>
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Jadwal Buka</span>
             </div>
          </div>
        </div>
      </div>
      
      <!-- Card -->
      <div class="services-card group relative bg-surface-elevated border border-border rounded-2xl p-6 md:p-8 transition-all duration-300 ease-out md:hover:-translate-y-1 md:hover:shadow-md md:hover:border-primary/40 active:scale-[0.98] active:bg-surface-elevated/80 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-2xl bg-glass-5 border border-border flex items-center justify-center mb-5 md:mb-6 text-primary md:group-hover:scale-110 md:group-hover:bg-primary/10 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7v10"/><path d="M11 7v10"/><path d="m15 14 3-3-3-3"/></svg>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">Sistem Khusus / Kustom</h3>
          <div class="space-y-3">
             <p class="text-text-secondary leading-relaxed text-sm">
               Butuh fitur spesial seperti pendaftaran member atau isi form? Kami bisa buatkan sistem kustomnya.
             </p>
             <div class="flex flex-wrap gap-2 pt-2">
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Sesuai Alur</span>
                <span class="px-2 py-1 bg-surface border border-glass-5 rounded-md text-[10px] font-bold text-text-muted uppercase">Bisa Kustomisasi</span>
             </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom CTA -->
    <div class="services-bottom text-center mt-12 md:mt-24 px-4 md:px-0">
      <h3 class="text-2xl md:text-3xl font-bold text-text-primary text-balance mb-3 md:mb-4">
        Belum yakin mana yang cocok?
      </h3>
      <p class="max-w-xl mx-auto text-base sm:text-lg text-text-secondary text-balance mb-6 md:mb-8">
        Bicarakan cara kerja bisnis Anda. Kami bantu pilihkan struktur yang paling efisien dan sesuai budget.
      </p>
      <a href="/contact" class="inline-flex justify-center items-center gap-2 bg-primary hover:bg-accent text-primary-foreground font-bold py-4 px-8 rounded-xl min-h-[56px] shadow-md transition-all duration-300 md:hover:scale-105 md:hover:shadow-sm active:scale-95 w-full sm:w-auto">
        Konsultasi Sekarang
      </a>
    </div>

  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const header = document.querySelector(".services-header");
    const cards = document.querySelectorAll(".services-card");
    const bottom = document.querySelector(".services-bottom");

    if (header) header.style.opacity = "0";
    if (bottom) bottom.style.opacity = "0";
    cards.forEach(c => (c as HTMLElement).style.opacity = "0");

    let animated = false;
    inView(header, () => {
      if (animated) return;
      animated = true;

      const isMobile = window.innerWidth < 768;
      const yOffset = isMobile ? 16 : 32;

      // Animate header
      if (header) {
        animate(
          header,
          { opacity: [0, 1], y: [yOffset, 0] },
          { duration: 0.6, easing: [0.22, 1, 0.36, 1] }
        );
      }

      // Animate cards staggered
      setTimeout(() => {
        animate(
          ".services-card",
          { opacity: [0, 1], y: [yOffset, 0] },
          { duration: 0.6, delay: stagger(isMobile ? 0.05 : 0.1), easing: [0.22, 1, 0.36, 1] }
        );
      }, 200);

      // Animate bottom CTA
      if (bottom) {
        setTimeout(() => {
          animate(
            bottom,
            { opacity: [0, 1], y: [yOffset, 0] },
            { duration: 0.6, easing: [0.22, 1, 0.36, 1] }
          );
        }, 600);
      }

    }, { margin: "-15% 0px" });
  }
</script>
