---
// src/components/portfolio/PortfolioModal.astro
---

<dialog id="portfolio-modal" class="fixed inset-0 w-full h-[100dvh] max-w-none max-h-none m-0 bg-transparent p-0 backdrop:bg-background/90 open:flex justify-center items-end sm:items-center opacity-0 transition-opacity duration-300 z-50">
  
  <div class="modal-content relative w-full max-w-5xl bg-background border border-border shadow-2xl rounded-t-[2rem] sm:rounded-[2rem] h-[95vh] sm:h-[90vh] flex flex-col overflow-hidden transform translate-y-full sm:translate-y-0 sm:scale-95 transition-all duration-300 ease-out">
    
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 md:px-8 md:py-6 border-b border-border bg-surface shrink-0 relative z-10 sticky top-0">
      <div>
        <span class="modal-category hidden text-[10px] md:text-xs font-bold uppercase tracking-wider text-primary mb-1"></span>
        <h2 class="modal-title text-lg md:text-2xl font-bold text-text-primary"></h2>
      </div>
      <button id="close-modal-btn" class="p-2 -mr-2 rounded-full hover:bg-glass-10 text-text-secondary hover:text-text-primary transition-colors focus-visible:outline-primary" aria-label="Tutup">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Scrollable Body (Case Study Layout) -->
    <div class="overflow-y-auto flex-grow p-4 sm:p-6 md:p-10 custom-scrollbar bg-surface/30">
      
      <!-- Top Banner / Large Preview -->
      <div class="w-full aspect-[16/9] md:aspect-[21/9] bg-surface-elevated border border-border rounded-2xl md:rounded-3xl mb-8 md:mb-12 overflow-hidden relative shadow-sm">
        <div class="absolute inset-0 bg-primary/5"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-text-muted">
           <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 opacity-40"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
           <span class="text-xs md:text-sm font-semibold uppercase tracking-widest opacity-40">Project Interface Preview</span>
        </div>
      </div>

      <!-- Main Case Study Content -->
      <div class="max-w-4xl mx-auto space-y-8 md:space-y-12">
        
        <!-- Section: Overview & Tech -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-10">
          <div class="md:col-span-2 space-y-3">
            <div class="inline-flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              <h3 class="text-lg md:text-xl font-bold text-text-primary">Project Overview</h3>
            </div>
            <p class="modal-overview text-text-secondary leading-relaxed text-sm md:text-base"></p>
          </div>
          <div class="bg-surface-elevated border border-border rounded-2xl p-5 shadow-sm">
            <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-4 text-center">Technology Used</h4>
            <div class="modal-tech flex flex-wrap justify-center gap-2"></div>
          </div>
        </div>

        <!-- Section: Objective & Solution Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
          <div class="bg-red-500/5 border border-red-500/10 rounded-2xl p-6 relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-red-500"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
            </div>
            <h3 class="text-base md:text-lg font-bold text-text-primary mb-3 flex items-center gap-2 relative z-10">
              <span class="w-2 h-2 rounded-full bg-red-400"></span> Business Objective
            </h3>
            <p class="modal-challenge text-sm text-text-secondary leading-relaxed relative z-10"></p>
          </div>
          <div class="bg-green-500/5 border border-green-500/10 rounded-2xl p-6 relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green-500"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3 class="text-base md:text-lg font-bold text-text-primary mb-3 flex items-center gap-2 relative z-10">
              <span class="w-2 h-2 rounded-full bg-green-400"></span> Business Benefits
            </h3>
            <p class="modal-solution text-sm text-text-secondary leading-relaxed relative z-10"></p>
          </div>
        </div>

        <!-- Section: Features & Performance -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 items-start">
          
          <div class="space-y-4">
            <div class="inline-flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
              <h3 class="text-lg md:text-xl font-bold text-text-primary">Website Features</h3>
            </div>
            <div class="bg-surface-elevated border border-border rounded-2xl p-5 shadow-sm">
              <div class="modal-features flex flex-wrap gap-2.5"></div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="inline-flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <h3 class="text-lg md:text-xl font-bold text-text-primary">Performance</h3>
            </div>
            <div class="bg-surface-elevated border border-border rounded-2xl p-5 shadow-sm space-y-5">
              <div>
                <div class="flex justify-between text-xs font-semibold mb-2">
                  <span class="text-text-secondary uppercase tracking-wider">Lighthouse Score</span>
                  <span class="modal-perf-text text-green-400 font-bold"></span>
                </div>
                <div class="w-full bg-surface rounded-full h-2 border border-border overflow-hidden relative">
                  <div class="modal-perf-bar absolute top-0 left-0 bottom-0 bg-green-500 w-full rounded-full origin-left transform scale-x-0 transition-transform duration-1000 ease-out"></div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4 pt-2">
                <div class="text-center p-3 bg-surface border border-border rounded-xl">
                  <span class="block text-[10px] text-text-muted uppercase tracking-wider mb-1">Load Time</span>
                  <span class="text-base font-bold text-primary">&lt; 0.8s</span>
                </div>
                <div class="text-center p-3 bg-surface border border-border rounded-xl">
                  <span class="block text-[10px] text-text-muted uppercase tracking-wider mb-1">SEO Health</span>
                  <span class="text-base font-bold text-green-400">100%</span>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Section: Responsive Preview (Visual representation) -->
        <div class="bg-surface-elevated border border-border rounded-2xl md:rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-center gap-6 shadow-sm">
          <div class="flex-grow space-y-3">
            <h3 class="text-lg md:text-xl font-bold text-text-primary flex items-center gap-2">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
              Responsive Preview
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed">Antarmuka otomatis beradaptasi secara sempurna di layar desktop, tablet, maupun ponsel pintar. Memastikan pelanggan Anda selalu mendapatkan pengalaman pengguna terbaik.</p>
          </div>
          <div class="flex items-end gap-3 shrink-0 text-border">
            <svg class="w-16 h-16 drop-shadow-lg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><rect width="20" height="14" x="2" y="5" rx="2" ry="2"/></svg>
            <svg class="w-12 h-12 drop-shadow-lg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/></svg>
            <svg class="w-8 h-8 drop-shadow-lg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><rect width="12" height="20" x="6" y="2" rx="2" ry="2"/></svg>
          </div>
        </div>

      </div>
    </div>

    <!-- Sticky Footer CTA -->
    <div class="px-6 py-5 md:px-8 border-t border-border bg-surface-elevated shrink-0 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <h3 class="text-sm md:text-base font-bold text-text-primary mb-1">Tertarik dengan studi kasus ini?</h3>
        <p class="text-xs md:text-sm text-text-secondary">Kami bisa membangun solusi serupa untuk Anda.</p>
      </div>
      <a href="/contact" class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-text-primary text-background font-bold py-3 px-6 rounded-xl transition-all hover:scale-105 active:scale-95 shadow-md focus-visible:outline-primary">
        Diskusikan Project Anda
      </a>
    </div>

  </div>
</dialog>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("portfolio-modal") as HTMLDialogElement;
    const closeBtn = document.getElementById("close-modal-btn");
    const detailBtns = document.querySelectorAll(".portfolio-detail-btn");
    const modalContent = modal?.querySelector(".modal-content") as HTMLElement;

    if (!modal) return;

    // Open Modal
    detailBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const card = btn.closest(".portfolio-card");
        if (card) {
           const title = card.querySelector("h3")?.innerText || "";
           const cat = card.querySelector(".mb-5 span")?.innerText || "";
           const desc = card.querySelector("p")?.innerText || "";
           
           const modalTitle = modal.querySelector(".modal-title");
           const modalCat = modal.querySelector(".modal-category");
           const modalDesc = modal.querySelector(".modal-overview");
           
           if(modalTitle) modalTitle.textContent = title;
           if(modalCat) modalCat.textContent = cat;
           if(modalDesc) modalDesc.textContent = desc;

           // Dynamic Challenge, Solution, Perf
           const challengeStr = card.getAttribute("data-challenge") || "";
           const solutionStr = card.getAttribute("data-solution") || "";
           const perfStr = card.getAttribute("data-perf") || "99";

           const modalChallenge = modal.querySelector(".modal-challenge");
           const modalSolution = modal.querySelector(".modal-solution");
           const modalPerfText = modal.querySelector(".modal-perf-text");
           const modalPerfBar = modal.querySelector(".modal-perf-bar");

           if(modalChallenge) modalChallenge.textContent = challengeStr;
           if(modalSolution) modalSolution.textContent = solutionStr;
           
           // Sync Tech Badges
           const modalTech = modal.querySelector(".modal-tech");
           const cardTechSpans = card.querySelectorAll(".gap-4 > div:first-child span");
           if (modalTech && cardTechSpans.length > 0) {
             modalTech.innerHTML = "";
             cardTechSpans.forEach(span => {
                const clone = span.cloneNode(true) as HTMLElement;
                // Adjust class for modal context
                clone.className = "px-3 py-1.5 bg-surface border border-border text-text-primary rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm";
                modalTech.appendChild(clone);
             });
           }

           // Sync Feature Badges
           const modalFeatures = modal.querySelector(".modal-features");
           const cardFeatureSpans = card.querySelectorAll(".gap-4 > div:last-child span");
           if (modalFeatures && cardFeatureSpans.length > 0) {
             modalFeatures.innerHTML = "";
             cardFeatureSpans.forEach(span => {
                const clone = span.cloneNode(true) as HTMLElement;
                // Adjust class for modal context
                clone.className = "px-3 py-1.5 bg-glass-5 border border-glass-10 text-text-secondary rounded-lg text-xs font-semibold uppercase tracking-wider flex items-center gap-2";
                modalFeatures.appendChild(clone);
             });
           }

           // Trigger CSS transition and animate Performance Bar
           modal.showModal();
           document.body.style.overflow = "hidden"; // Prevent background scroll
           
           if(modalPerfText) modalPerfText.textContent = `0/100`;
           if(modalPerfBar) (modalPerfBar as HTMLElement).style.transform = `scaleX(0)`;

           requestAnimationFrame(() => {
             modal.classList.remove("opacity-0");
             modal.classList.add("opacity-100");
             
             if(modalContent) {
               // Slide up for mobile, scale for desktop
               modalContent.classList.remove("translate-y-full", "sm:scale-95");
               modalContent.classList.add("translate-y-0", "sm:scale-100");
             }

             // Animate perf bar slightly after modal opens
             setTimeout(() => {
               if(modalPerfText) modalPerfText.textContent = `${perfStr}/100`;
               if(modalPerfBar) (modalPerfBar as HTMLElement).style.transform = `scaleX(${parseInt(perfStr) / 100})`;
             }, 300);
           });
        }
      });
    });

    const closeModal = () => {
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0");
      if(modalContent) {
        modalContent.classList.remove("translate-y-0", "sm:scale-100");
        modalContent.classList.add("translate-y-full", "sm:scale-95");
      }
      
      setTimeout(() => {
        modal.close();
        document.body.style.overflow = ""; // Restore background scroll
      }, 300); // match duration-300
    };

    closeBtn?.addEventListener("click", closeModal);

    // Close on click outside
    modal.addEventListener("click", (e) => {
      const rect = modalContent.getBoundingClientRect();
      const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
      if (!isInDialog) {
        closeModal();
      }
    });
    
    // Native escape key support logic is handled by <dialog>, but we need to run our custom exit animation
    modal.addEventListener("cancel", (e) => {
      e.preventDefault(); // prevent immediate native close
      closeModal(); // run animated close
    });
  });
</script>
