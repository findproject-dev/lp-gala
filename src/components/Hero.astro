---
---
<section class="relative min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 py-20 overflow-hidden bg-background">
  <!-- Background Glows -->
  <div class="absolute top-[20%] left-[10%] w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/30 to-transparent rounded-full blur-[32px] sm:blur-[48px] -z-10 opacity-70 animate-pulse-slow transform-gpu"></div>
  <div class="absolute bottom-[10%] right-[10%] w-[400px] sm:w-[600px] h-[400px] sm:h-[600px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-accent/20 to-transparent rounded-full blur-[32px] sm:blur-[48px] -z-10 opacity-70 transform-gpu"></div>
  <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay pointer-events-none z-0"></div> <!-- Subtle noise texture if exists -->

  <div class="max-w-7xl w-full grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-12 lg:gap-16 items-center relative z-10">
    
    <!-- Left Column: Content -->
    <div class="flex flex-col space-y-6 sm:space-y-8 lg:space-y-10 text-center lg:text-left pt-12 md:pt-0">
      <!-- Super title -->
      <div class="space-y-4">
        <div class="inline-flex items-center justify-center lg:justify-start gap-2 px-4 py-2 rounded-full border border-border bg-surface shadow-sm animate-fade-in-up">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-ping"></span>
          <span class="text-[10px] sm:text-xs md:text-sm font-semibold uppercase tracking-[0.15em] text-primary">
            GALACODE • JASA PEMBUATAN WEBSITE
          </span>
        </div>
        
        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-text-primary leading-tight sm:leading-[1.1] tracking-tight animate-fade-in-up" style="animation-delay: 100ms;">
          Website Rapi untuk <span class="text-primary block sm:inline mt-1 sm:mt-0">Operasional Bisnis</span>
        </h1>
      </div>
      
      <!-- Description -->
      <p class="text-base sm:text-lg md:text-xl text-text-secondary leading-relaxed max-w-[90%] sm:max-w-2xl mx-auto lg:mx-0 text-balance animate-fade-in-up" style="animation-delay: 200ms;">
        Terima beres. Website dirancang rapi, informatif, dan langsung siap Anda gunakan.
      </p>

      <!-- CTA -->
      <div class="flex flex-col md:flex-row items-center justify-center lg:justify-start gap-3 md:gap-5 pt-4 sm:pt-2 animate-fade-in-up" style="animation-delay: 300ms;">
        <a href="#portfolio" class="group relative px-8 py-4 bg-primary hover:bg-accent text-primary-foreground font-bold rounded-xl overflow-hidden transition-all duration-300 md:hover:scale-105 active:scale-95 md:hover:shadow-md w-full md:w-auto flex justify-center items-center gap-2 min-h-[56px]">
          <div class="absolute inset-0 bg-glass-20 translate-y-full md:group-hover:translate-y-0 transition-transform duration-300 ease-out hidden md:block"></div>
          <span class="relative z-10">Cek Portofolio</span>
          <svg class="w-5 h-5 relative z-10 md:group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/contact" class="px-8 py-4 border border-border/60 text-text-primary font-bold rounded-xl bg-surface/80 md:hover:bg-surface/95 active:bg-surface/90 transition-all duration-300 active:scale-95 w-full md:w-auto text-center min-h-[56px] flex items-center justify-center shadow-sm">
          Diskusi Kebutuhan
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="pt-10 lg:pt-12 border-t border-glass-10 animate-fade-in-up" style="animation-delay: 400ms;">
        <p class="text-xs sm:text-sm text-text-muted mb-5 font-medium uppercase tracking-wider text-center lg:text-left">Standar Pengerjaan Kami</p>
        <div class="flex flex-wrap justify-center lg:justify-start gap-3 sm:gap-4">
          <div class="group flex items-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 rounded-full bg-surface border border-border md:hover:border-border/80 md:hover:bg-glass-5 transition-all duration-300 shadow-sm md:hover:shadow-soft-lg active:bg-glass-10 active:border-border">
            <svg class="w-4 sm:w-5 h-4 sm:h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-[11px] sm:text-xs md:text-sm font-medium text-text-secondary md:group-hover:text-text-primary transition-colors">Pengerjaan Tepat Waktu</span>
          </div>
          <div class="group flex items-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 rounded-full bg-surface border border-border md:hover:border-border/80 md:hover:bg-glass-5 transition-all duration-300 shadow-sm md:hover:shadow-soft-lg active:bg-glass-10 active:border-border">
            <svg class="w-4 sm:w-5 h-4 sm:h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            <span class="text-[11px] sm:text-xs md:text-sm font-medium text-text-secondary group-hover:text-text-primary transition-colors">Eksklusif & Private</span>
          </div>
          <div class="group flex items-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 rounded-full bg-surface border border-border md:hover:border-border/80 md:hover:bg-glass-5 transition-all duration-300 shadow-sm md:hover:shadow-soft-lg active:bg-glass-10 active:border-border">
            <svg class="w-4 sm:w-5 h-4 sm:h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-[11px] sm:text-xs md:text-sm font-medium text-text-secondary md:group-hover:text-text-primary transition-colors">Langsung Siap Pakai</span>
          </div>
          <div class="group flex items-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 rounded-full bg-surface border border-border md:hover:border-border/80 md:hover:bg-glass-5 transition-all duration-300 shadow-sm md:hover:shadow-soft-lg active:bg-glass-10 active:border-border">
            <svg class="w-4 sm:w-5 h-4 sm:h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span class="text-[11px] sm:text-xs md:text-sm font-medium text-text-secondary md:group-hover:text-text-primary transition-colors">Bantuan Teknis</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Visuals / Mockups -->
    <div class="relative flex justify-center items-center mt-16 md:mt-12 lg:mt-0 lg:h-[600px] perspective-[1000px] animate-fade-in-up" style="animation-delay: 200ms;">
      
      <!-- Main Desktop Mockup -->
      <div class="relative w-full max-w-[550px] md:animate-float group z-10" style="transform-style: preserve-3d;">
        <div class="aspect-[16/10] bg-surface/95 border border-border/60 rounded-[1.5rem] md:rounded-[2rem] shadow-xl overflow-hidden relative transition-transform duration-500 md:group-hover:rotate-x-12 md:group-hover:rotate-y-[-5deg] md:group-hover:scale-[1.02] active:scale-[0.98]">
          
          <!-- Mockup Inner Glow -->
          <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-accent/5 opacity-50 md:group-hover:opacity-100 transition-opacity duration-500 hidden md:block"></div>
          
          <!-- Browser Top Bar -->
          <div class="p-3 sm:p-4 md:p-6 border-b border-glass-5 bg-glass-20 flex items-center gap-1.5 sm:gap-2 relative z-10">
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-red-500/80"></div>
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-green-500/80"></div>
            <div class="ml-2 sm:ml-4 h-4 sm:h-6 w-full max-w-[150px] sm:max-w-[200px] bg-glass-5 rounded-md flex items-center px-2 sm:px-3">
              <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-primary/50"></div>
              <div class="ml-2 h-1.5 sm:h-2 w-12 sm:w-16 bg-glass-20 rounded-full"></div>
            </div>
          </div>
          
          <!-- Mockup Content Area -->
          <div class="p-4 sm:p-6 md:p-8 space-y-4 sm:space-y-6 relative z-10">
             <div class="space-y-3 sm:space-y-4">
                <div class="h-6 sm:h-8 w-3/4 bg-gradient-to-r from-primary/30 to-transparent rounded-lg"></div>
                <div class="h-3 sm:h-4 w-full bg-glass-5 rounded-lg"></div>
                <div class="h-3 sm:h-4 w-5/6 bg-glass-5 rounded-lg"></div>
             </div>
             <div class="aspect-video w-full bg-surface/90 rounded-xl md:rounded-2xl border border-border/60 shadow-lg overflow-hidden relative">
                <div class="absolute inset-0 bg-[conic-gradient(at_top_right,_var(--tw-gradient-stops))] from-primary/20 via-transparent to-accent/10 opacity-50"></div>
                <div class="absolute bottom-2 sm:bottom-4 left-2 right-2 sm:left-4 sm:right-4 flex gap-2 sm:gap-3">
                  <div class="h-10 sm:h-16 w-1/3 bg-glass-10 rounded-lg sm:rounded-xl"></div>
                  <div class="h-10 sm:h-16 w-1/3 bg-glass-10 rounded-lg sm:rounded-xl"></div>
                  <div class="h-10 sm:h-16 w-1/3 bg-glass-10 rounded-lg sm:rounded-xl"></div>
                </div>
             </div>
          </div>
        </div>
      </div>
      
      <!-- Floating Mobile Mockup (Hidden on Mobile to reduce complexity) -->
      <div class="hidden md:block absolute -bottom-6 -left-2 sm:-bottom-8 sm:-left-8 md:-left-12 w-24 sm:w-32 md:w-44 aspect-[9/19] bg-surface-elevated border md:border border-border rounded-[1.5rem] md:rounded-[2.5rem] shadow-lg md:shadow-md overflow-hidden transform -rotate-12 animate-float-delayed z-20 transition-transform duration-500 md:hover:rotate-0 md:hover:scale-110 active:scale-[0.95]">
           <div class="absolute top-0 inset-x-0 h-4 md:h-6 bg-black flex justify-center z-10">
             <div class="w-1/3 h-2.5 md:h-4 bg-[#333] rounded-b-lg md:rounded-b-xl"></div>
           </div>
           
           <div class="absolute inset-0 bg-gradient-to-b from-border/5 to-background/90 z-0"></div>
           
           <div class="p-3 md:p-4 pt-8 md:pt-12 space-y-3 md:space-y-4 relative z-10">
              <div class="h-2.5 md:h-4 w-2/3 bg-primary/40 rounded-sm md:rounded-md"></div>
              <div class="h-16 md:h-24 w-full bg-glass-5 border border-border rounded-lg md:rounded-xl flex items-center justify-center">
                <div class="w-8 h-8 md:w-12 md:h-12 rounded-full border-2 border-primary/50 flex items-center justify-center">
                  <svg class="w-4 h-4 md:w-6 md:h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
                </div>
              </div>
              <div class="space-y-1.5 md:space-y-2">
                <div class="h-2 md:h-3 w-full bg-glass-10 rounded-sm"></div>
                <div class="h-2 md:h-3 w-5/6 bg-glass-10 rounded-sm"></div>
              </div>
           </div>
      </div>

      <!-- Performance Badge (Hidden on Mobile to reduce complexity) -->
      <div class="hidden md:flex absolute top-4 -right-2 sm:top-12 sm:-right-4 md:-right-8 bg-surface-elevated border border-border p-3 sm:p-4 md:p-5 rounded-xl md:rounded-2xl shadow-md md:shadow-lg items-center gap-3 md:gap-4 animate-float-fast z-30 transform rotate-6 transition-all duration-300 md:hover:rotate-0 md:hover:scale-110 active:scale-[0.95]">
        <div class="relative w-10 h-10 md:w-12 md:h-12 flex items-center justify-center shrink-0">
          <svg class="absolute inset-0 w-full h-full text-green-500/20 transform -rotate-90" viewBox="0 0 36 36">
            <path class="stroke-current" fill="none" stroke-width="3" stroke-dasharray="100, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
          </svg>
          <svg class="absolute inset-0 w-full h-full text-green-500 transform -rotate-90" viewBox="0 0 36 36">
            <path class="stroke-current transition-all duration-1000 ease-out" fill="none" stroke-width="3" stroke-dasharray="99, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
          </svg>
          <span class="text-xs md:text-sm font-black text-primary-foreground relative z-10">99</span>
        </div>
        <div>
          <p class="text-[8px] md:text-[10px] text-green-400 uppercase font-bold tracking-wider">Performance</p>
          <p class="text-xs md:text-sm font-black text-text-primary">Lighthouse</p>
        </div>
        
        <!-- Sparkle effect -->
        <div class="absolute -top-2 -right-2 w-4 h-4 md:w-6 md:h-6 text-yellow-400 animate-pulse">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
        </div>
      </div>
      
    </div>

  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
  }
  @keyframes float-delayed {
    0%, 100% { transform: translateY(0px) rotate(-12deg); }
    50% { transform: translateY(-20px) rotate(-8deg); }
  }
  @keyframes float-fast {
    0%, 100% { transform: translateY(0px) rotate(6deg); }
    50% { transform: translateY(-10px) rotate(8deg); }
  }
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.05); }
  }

  
  @media (min-width: 768px) {
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
    .animate-float-delayed {
      animation: float-delayed 7s ease-in-out infinite;
    }
    .animate-float-fast {
      animation: float-fast 5s ease-in-out infinite;
    }
  }
  
  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }
  .animate-pulse-slow {
    animation: pulse-slow 8s infinite ease-in-out;
  }
</style>
