---
import { t, getLocalizedPath, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;
---
<section class="relative min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 py-20 overflow-hidden bg-background">
  <!-- Background Glows -->
  <div class="absolute top-[15%] left-[5%] w-[400px] sm:w-[600px] h-[400px] sm:h-[600px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/25 to-transparent rounded-full blur-[48px] sm:blur-[64px] -z-10 opacity-60 animate-pulse-slow transform-gpu"></div>
  <div class="absolute bottom-[10%] right-[5%] w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-accent/15 to-transparent rounded-full blur-[40px] sm:blur-[56px] -z-10 opacity-60 transform-gpu"></div>
  <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay pointer-events-none z-0"></div>

  <div class="max-w-7xl w-full grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] gap-14 lg:gap-20 items-center relative z-10">

    <!-- Left Column: Content -->
    <div class="flex flex-col space-y-7 lg:space-y-9 text-center lg:text-left pt-14 md:pt-0">

      <!-- Eyebrow Tag -->
      <div class="inline-flex items-center justify-center lg:justify-start gap-2 px-4 py-2 rounded-full border border-border bg-surface shadow-sm animate-fade-in-up self-center lg:self-start">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-ping"></span>
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.15em] text-primary" data-i18n="hero.eyebrow">
          {t(lang, "hero.eyebrow")}
        </span>
      </div>

      <!-- Headline -->
      <div class="space-y-3 animate-fade-in-up" style="animation-delay: 100ms;">
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[4.15rem] font-black text-text-primary leading-[1.07] tracking-tight text-balance" data-i18n-html="hero.headline" set:html={t(lang, "hero.headline")} />
      </div>

      <!-- Description -->
      <p class="text-base sm:text-lg md:text-xl text-text-secondary leading-relaxed max-w-[90%] sm:max-w-xl mx-auto lg:mx-0 text-balance animate-fade-in-up" style="animation-delay: 200ms;" data-i18n="hero.description">
        {t(lang, "hero.description")}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-2 animate-fade-in-up" style="animation-delay: 300ms;">
        <a href={getLocalizedPath("/contact", lang)} data-base-href="/contact" class="group relative px-8 py-4 bg-primary hover:bg-accent text-primary-foreground font-bold rounded-xl overflow-hidden transition-all duration-300 md:hover:scale-105 active:scale-95 md:hover:shadow-lg w-full sm:w-auto flex justify-center items-center gap-2.5 min-h-[56px]">
          <div class="absolute inset-0 bg-glass-20 translate-y-full md:group-hover:translate-y-0 transition-transform duration-300 ease-out hidden md:block"></div>
          <span class="relative z-10" data-i18n="hero.ctaPrimary">{t(lang, "hero.ctaPrimary")}</span>
          <svg class="w-5 h-5 relative z-10 md:group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href={getLocalizedPath("/portfolio", lang)} data-base-href="/portfolio" class="px-8 py-4 border border-border/60 text-text-primary font-bold rounded-xl bg-surface/80 md:hover:bg-surface/95 active:bg-surface/90 transition-all duration-300 active:scale-95 w-full sm:w-auto text-center min-h-[56px] flex items-center justify-center shadow-sm" data-i18n="hero.ctaSecondary">
          {t(lang, "hero.ctaSecondary")}
        </a>
      </div>

      <!-- Trust Signals -->
      <div class="pt-8 lg:pt-10 border-t border-glass-10 animate-fade-in-up" style="animation-delay: 400ms;">
        <p class="text-xs sm:text-sm text-text-muted mb-4 font-semibold uppercase tracking-widest text-center lg:text-left" data-i18n="hero.trustLabel">{t(lang, "hero.trustLabel")}</p>
        <div class="flex flex-wrap justify-center lg:justify-start gap-3">
          <div class="group flex items-center gap-2 px-3.5 sm:px-4 py-2.5 rounded-full bg-surface border border-border md:hover:border-primary/30 md:hover:bg-glass-5 transition-all duration-300 shadow-sm">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            <span class="text-[11px] sm:text-xs font-semibold text-text-secondary group-hover:text-text-primary transition-colors" data-i18n="hero.trust1">{t(lang, "hero.trust1")}</span>
          </div>
          <div class="group flex items-center gap-2 px-3.5 sm:px-4 py-2.5 rounded-full bg-surface border border-border md:hover:border-primary/30 md:hover:bg-glass-5 transition-all duration-300 shadow-sm">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <span class="text-[11px] sm:text-xs font-semibold text-text-secondary group-hover:text-text-primary transition-colors" data-i18n="hero.trust2">{t(lang, "hero.trust2")}</span>
          </div>
          <div class="group flex items-center gap-2 px-3.5 sm:px-4 py-2.5 rounded-full bg-surface border border-border md:hover:border-primary/30 md:hover:bg-glass-5 transition-all duration-300 shadow-sm">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-[11px] sm:text-xs font-semibold text-text-secondary group-hover:text-text-primary transition-colors" data-i18n="hero.trust3">{t(lang, "hero.trust3")}</span>
          </div>
          <div class="group flex items-center gap-2 px-3.5 sm:px-4 py-2.5 rounded-full bg-surface border border-border md:hover:border-primary/30 md:hover:bg-glass-5 transition-all duration-300 shadow-sm">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-[11px] sm:text-xs font-semibold text-text-secondary group-hover:text-text-primary transition-colors" data-i18n="hero.trust4">{t(lang, "hero.trust4")}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Business Growth Visual -->
    <div class="relative flex justify-center items-center mt-12 lg:mt-0 lg:h-[640px] animate-fade-in-up" style="animation-delay: 150ms;">

      <!-- Main Dashboard Mockup -->
      <div class="relative w-full max-w-[520px] md:animate-float group z-10">
        <div class="bg-surface/95 border border-border/60 rounded-[1.5rem] md:rounded-[2rem] shadow-2xl overflow-hidden">

          <!-- Browser Bar -->
          <div class="px-4 py-3.5 border-b border-glass-5 bg-glass-20 flex items-center gap-2">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-400/80"></span>
            </div>
            <div class="flex-1 mx-3 h-6 bg-glass-5 rounded-md flex items-center px-3 gap-2">
              <svg class="w-3 h-3 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              <span class="text-[10px] text-text-muted font-mono truncate">bisnisanda.com</span>
            </div>
          </div>

          <!-- Dashboard Content -->
          <div class="p-5 sm:p-6 space-y-4 bg-gradient-to-b from-surface-elevated/80 to-surface">

            <!-- Conversion Widget -->
            <div class="grid grid-cols-3 gap-3">
              <div class="col-span-2 p-4 bg-background rounded-xl border border-border/60 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-text-muted" data-i18n="hero.mockup.flowLabel">{t(lang, "hero.mockup.flowLabel")}</span>
                  <span class="text-[10px] font-bold text-green-500 bg-green-500/10 px-2 py-0.5 rounded-full" data-i18n="hero.mockup.flowStatus">{t(lang, "hero.mockup.flowStatus")}</span>
                </div>
                <div class="text-lg sm:text-xl font-black text-text-primary leading-tight" data-i18n="hero.mockup.flowTitle">{t(lang, "hero.mockup.flowTitle")}</div>
                <div class="text-[11px] text-text-muted font-medium" data-i18n="hero.mockup.flowSub">{t(lang, "hero.mockup.flowSub")}</div>
                <!-- Mini chart -->
                <div class="flex items-end gap-1 h-8 pt-1">
                  <div class="flex-1 bg-primary/20 rounded-sm" style="height: 40%"></div>
                  <div class="flex-1 bg-primary/30 rounded-sm" style="height: 60%"></div>
                  <div class="flex-1 bg-primary/40 rounded-sm" style="height: 50%"></div>
                  <div class="flex-1 bg-primary/50 rounded-sm" style="height: 75%"></div>
                  <div class="flex-1 bg-primary/60 rounded-sm" style="height: 65%"></div>
                  <div class="flex-1 bg-primary rounded-sm" style="height: 100%"></div>
                </div>
              </div>
              <div class="flex flex-col gap-3">
                <div class="flex-1 p-3 bg-background rounded-xl border border-border/60 flex flex-col items-center justify-center text-center">
                  <div class="text-sm font-black text-text-primary" data-i18n="hero.mockup.stat1Value">{t(lang, "hero.mockup.stat1Value")}</div>
                  <div class="text-[9px] text-text-muted font-medium mt-0.5" data-i18n="hero.mockup.stat1Label">{t(lang, "hero.mockup.stat1Label")}</div>
                </div>
                <div class="flex-1 p-3 bg-green-500/10 border border-green-500/20 rounded-xl flex flex-col items-center justify-center text-center">
                  <div class="text-lg font-black text-green-500">24/7</div>
                  <div class="text-[9px] text-green-600 dark:text-green-400 font-medium mt-0.5" data-i18n="hero.mockup.stat2Label">{t(lang, "hero.mockup.stat2Label")}</div>
                </div>
              </div>
            </div>

            <!-- Visitor Journey Funnel -->
            <div class="p-4 bg-background rounded-xl border border-border/60 space-y-2">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-text-primary" data-i18n="hero.mockup.funnelTitle">{t(lang, "hero.mockup.funnelTitle")}</span>
                <span class="text-[10px] text-text-muted" data-i18n="hero.mockup.funnelSub">{t(lang, "hero.mockup.funnelSub")}</span>
              </div>
              <div class="space-y-2.5">
                <div class="flex items-center gap-3">
                  <span class="text-[10px] text-text-muted w-24 shrink-0" data-i18n="hero.mockup.step1Label">{t(lang, "hero.mockup.step1Label")}</span>
                  <div class="flex-1 h-2.5 bg-primary/15 rounded-full overflow-hidden">
                    <div class="h-full bg-primary rounded-full" style="width: 100%"></div>
                  </div>
                  <span class="text-[10px] font-bold text-text-primary w-14 text-right" data-i18n="hero.mockup.step1Status">{t(lang, "hero.mockup.step1Status")}</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-[10px] text-text-muted w-24 shrink-0" data-i18n="hero.mockup.step2Label">{t(lang, "hero.mockup.step2Label")}</span>
                  <div class="flex-1 h-2.5 bg-primary/15 rounded-full overflow-hidden">
                    <div class="h-full bg-primary/70 rounded-full" style="width: 72%"></div>
                  </div>
                  <span class="text-[10px] font-bold text-text-primary w-14 text-right" data-i18n="hero.mockup.step2Status">{t(lang, "hero.mockup.step2Status")}</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-[10px] text-text-muted w-24 shrink-0" data-i18n="hero.mockup.step3Label">{t(lang, "hero.mockup.step3Label")}</span>
                  <div class="flex-1 h-2.5 bg-primary/15 rounded-full overflow-hidden">
                    <div class="h-full bg-green-500 rounded-full" style="width: 45%"></div>
                  </div>
                  <span class="text-[10px] font-bold text-green-500 w-14 text-right" data-i18n="hero.mockup.step3Status">{t(lang, "hero.mockup.step3Status")}</span>
                </div>
              </div>
            </div>

            <!-- CTA Row Simulation -->
            <div class="flex gap-2">
              <div class="flex-1 py-2.5 bg-primary text-primary-foreground rounded-lg text-[11px] font-bold text-center" data-i18n="hero.mockup.btn1">{t(lang, "hero.mockup.btn1")}</div>
              <div class="flex-1 py-2.5 bg-green-500/10 border border-green-500/30 text-green-500 rounded-lg text-[11px] font-bold text-center" data-i18n="hero.mockup.btn2">{t(lang, "hero.mockup.btn2")}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Floating Mobile Mockup -->
      <div class="hidden md:flex absolute -bottom-4 -left-10 w-36 bg-surface-elevated border border-border/80 rounded-[2rem] shadow-xl overflow-hidden flex-col z-20 animate-float-delayed">
        <div class="h-4 bg-black/60 flex justify-center items-end pb-0.5">
          <div class="w-10 h-2 bg-[#333] rounded-full"></div>
        </div>
        <div class="p-3 space-y-2 bg-background">
          <div class="text-[9px] font-bold text-primary" data-i18n="hero.mockup.notifTitle">{t(lang, "hero.mockup.notifTitle")}</div>
          <div class="p-2 bg-primary/10 border border-primary/20 rounded-lg text-[8px] text-text-primary font-medium leading-tight" data-i18n="hero.mockup.notifMsg">
            {t(lang, "hero.mockup.notifMsg")}
          </div>
          <div class="py-1.5 bg-green-500 text-white rounded-lg text-center text-[8px] font-bold" data-i18n="hero.mockup.notifBtn">{t(lang, "hero.mockup.notifBtn")}</div>
        </div>
      </div>

      <!-- Floating Conversion Badge -->
      <div class="hidden md:flex absolute -top-2 -right-6 bg-surface-elevated/95 backdrop-blur-md border border-border/80 p-3.5 rounded-2xl shadow-lg items-center gap-3 z-30 animate-float-fast">
        <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
        <div>
          <p class="text-[9px] text-text-muted font-bold uppercase tracking-wider" data-i18n="hero.mockup.badgeLabel">{t(lang, "hero.mockup.badgeLabel")}</p>
          <p class="text-sm font-black text-text-primary" data-i18n="hero.mockup.badgeTitle">{t(lang, "hero.mockup.badgeTitle")}</p>
        </div>
        <div class="absolute -top-1.5 -right-1.5 w-4 h-4 text-yellow-400 animate-pulse">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-14px); }
  }
  @keyframes float-delayed {
    0%, 100% { transform: translateY(0px) rotate(-2deg); }
    50% { transform: translateY(-18px) rotate(1deg); }
  }
  @keyframes float-fast {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-9px); }
  }
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(1.04); }
  }

  @media (min-width: 768px) {
    .animate-float { animation: float 6s ease-in-out infinite; }
    .animate-float-delayed { animation: float-delayed 7.5s ease-in-out infinite; }
    .animate-float-fast { animation: float-fast 4.5s ease-in-out infinite; }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }
  .animate-pulse-slow {
    animation: pulse-slow 9s infinite ease-in-out;
  }
</style>
