---
// src/components/Header.astro
import { Sun, Moon } from "lucide-astro";

const navLinks = [
  { name: "Home", href: "/" },
  { name: "Tentang", href: "/tentang" },
  { name: "Portfolio", href: "/portfolio" },
  { name: "Harga", href: "/pricing" },
  { name: "FAQ", href: "/faq" },
  { name: "Kontak", href: "/contact" },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 w-full py-6 md:py-8 transition-all duration-300">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <!-- Navbar Container -->
    <div
      id="nav-container"
      class="w-full flex items-center justify-between py-0 px-0 transition-all duration-300 rounded-none border border-transparent bg-transparent"
    >
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary rounded-lg">
        <img src="/favicon.png" alt="Galacode Logo" class="h-8 w-auto md:h-10 transition-transform duration-300 group-hover:scale-105" />
        <span class="text-xl sm:text-2xl font-poller tracking-[0.1em] text-text-primary transition-colors duration-300 group-hover:text-primary">
          GALACODE
        </span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navigasi Utama">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="relative py-2 text-sm font-medium text-text-secondary transition-colors duration-300 hover:text-text-primary nav-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary rounded-md"
              data-path={link.href}
            >
              {link.name}
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-primary to-secondary text-primary-foreground border border-border shadow-lg shadow-primary/25 scale-x-0 origin-right transition-transform duration-300 nav-indicator" />
            </a>
          ))
        }
      </nav>

            <div class="hidden md:flex items-center gap-4">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="flex items-center justify-center w-10 h-10 rounded-full border border-border bg-surface text-text-primary transition-all duration-300 hover:border-border hover:bg-surface-elevated hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary group"
          aria-label="Toggle Theme"
        >
          <Sun class="w-5 h-5 hidden dark:block text-text-primary group-hover:text-accent transition-colors" />
          <Moon class="w-5 h-5 block dark:hidden text-text-primary group-hover:text-primary transition-colors" />
        </button>

        <!-- CTA Button -->
        <a
          href="/contact"
          class="inline-block bg-primary hover:bg-secondary text-primary-foreground border border-border shadow-lg shadow-primary/25 text-primary-foreground text-sm font-semibold py-3 px-6 rounded-xl shadow-lg shadow-primary/25 transition-all duration-300 hover:scale-[1.02] hover:brightness-110 hover:shadow-xl shadow-primary/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Konsultasi Gratis
        </a>
      </div>

            <div class="md:hidden flex items-center gap-3">
        <!-- Mobile Theme Toggle -->
        <button
          id="mobile-theme-toggle"
          class="flex items-center justify-center w-10 h-10 rounded-full border border-border bg-surface text-text-primary transition-all duration-300 hover:border-border focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary group"
          aria-label="Toggle Theme"
        >
          <Sun class="w-5 h-5 hidden dark:block text-text-primary group-hover:text-accent transition-colors" />
          <Moon class="w-5 h-5 block dark:hidden text-text-primary group-hover:text-primary transition-colors" />
        </button>

        <!-- Hamburger Button -->
      <button
        id="menu-toggle"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl border border-border bg-surface text-text-primary transition-all duration-300 hover:border-border focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <svg
          class="w-6 h-6 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path id="hamburger-line-1" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16" class="origin-center transition-all duration-300"></path>
          <path id="hamburger-line-2" stroke-linecap="round" stroke-linejoin="round" d="M4 12h16" class="origin-center transition-all duration-300"></path>
          <path id="hamburger-line-3" stroke-linecap="round" stroke-linejoin="round" d="M4 18h16" class="origin-center transition-all duration-300"></path>
        </svg>
      </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-background z-40 flex flex-col justify-between px-8 py-24 transition-all duration-300 opacity-0 pointer-events-none translate-y-[-10px] md:hidden"
    aria-hidden="true"
  >
    <!-- Close Button -->
    <button
      id="mobile-menu-close"
      class="absolute top-6 right-4 sm:right-6 flex items-center justify-center w-10 h-10 rounded-full bg-surface border border-border text-text-secondary transition-all duration-300 hover:text-text-primary hover:border-border/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-label="Tutup menu navigasi"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <!-- Navigation Links -->
    <nav class="flex flex-col gap-6 text-center" aria-label="Navigasi Utama Mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-2xl font-bold text-text-secondary transition-colors duration-300 hover:text-primary mobile-nav-link"
            data-path={link.href}
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <!-- Bottom Mobile CTA -->
    <div class="w-full text-center">
      <a
        href="/contact"
        class="mobile-menu-cta w-full inline-block bg-primary hover:bg-secondary text-primary-foreground border border-border shadow-lg shadow-primary/25 text-primary-foreground font-semibold py-4 px-8 rounded-xl shadow-xl shadow-primary/30 transition-all duration-300 hover:brightness-110"
      >
        Konsultasi Gratis
      </a>
    </div>
  </div>
</header>



<script>
  // Event delegation to avoid issues with bubbling from SVG children
  document.addEventListener("click", (e) => {
    const toggleBtn = e.target.closest("#theme-toggle, #mobile-theme-toggle");
    if (toggleBtn) {
      e.preventDefault();
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      }
    }
  });

  // Handle active route highlighting
  const currentPath = window.location.pathname;
  document.querySelectorAll(".nav-link").forEach((link) => {
    if (link.getAttribute("href") === currentPath) {
      link.classList.add("text-text-primary");
      link.classList.remove("text-text-secondary");
      const indicator = link.querySelector(".nav-indicator");
      if (indicator) {
        indicator.classList.remove("scale-x-0");
        indicator.classList.add("scale-x-100");
      }
    }
  });

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    if (link.getAttribute("href") === currentPath) {
      link.classList.add("text-primary");
      link.classList.remove("text-text-secondary");
    }
  });

  // Handle scroll for floating navbar
  const header = document.getElementById("main-header");
  const navContainer = document.getElementById("nav-container");
  
  function handleScroll() {
    if (window.scrollY > 20) {
      if(header) {
        header.classList.add("py-3", "md:py-4");
        header.classList.remove("py-6", "md:py-8");
      }
      if(navContainer) {
        navContainer.classList.add("bg-surface/95", "backdrop-blur-md", "border-border", "shadow-lg", "shadow-black/50", "px-6", "py-3", "rounded-[24px]");
        navContainer.classList.remove("py-0", "px-0", "rounded-none", "border-transparent", "bg-transparent");
      }
    } else {
      if(header) {
        header.classList.add("py-6", "md:py-8");
        header.classList.remove("py-3", "md:py-4");
      }
      if(navContainer) {
        navContainer.classList.remove("bg-surface/95", "backdrop-blur-md", "border-border", "shadow-lg", "shadow-black/50", "px-6", "py-3", "rounded-[24px]");
        navContainer.classList.add("py-0", "px-0", "rounded-none", "border-transparent", "bg-transparent");
      }
    }
  }
  
  window.addEventListener("scroll", handleScroll);
  handleScroll(); // Initialize on load

  // Mobile menu toggle logic
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const line1 = document.getElementById("hamburger-line-1");
  const line2 = document.getElementById("hamburger-line-2");
  const line3 = document.getElementById("hamburger-line-3");
  
  let isMenuOpen = false;
  
  function toggleMobileMenu() {
    isMenuOpen = !isMenuOpen;
    if(menuToggle) menuToggle.setAttribute("aria-expanded", isMenuOpen ? "true" : "false");
    if(mobileMenu) mobileMenu.setAttribute("aria-hidden", isMenuOpen ? "false" : "true");

    if (isMenuOpen) {
      if(mobileMenu) {
        mobileMenu.classList.remove("opacity-0", "pointer-events-none", "translate-y-[-10px]");
        mobileMenu.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
      }
      document.body.style.overflow = "hidden";
      if(line1) line1.setAttribute("transform", "rotate(45) translate(6, -6)");
      if(line2) line2.classList.add("opacity-0");
      if(line3) line3.setAttribute("transform", "rotate(-45) translate(-6, -6)");
    } else {
      if(mobileMenu) {
        mobileMenu.classList.add("opacity-0", "pointer-events-none", "translate-y-[-10px]");
        mobileMenu.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      }
      document.body.style.overflow = "";
      if(line1) line1.removeAttribute("transform");
      if(line2) line2.classList.remove("opacity-0");
      if(line3) line3.removeAttribute("transform");
    }
  }

  if (menuToggle) {
    menuToggle.addEventListener("click", toggleMobileMenu);
  }

  const menuClose = document.getElementById("mobile-menu-close");
  if (menuClose) {
    menuClose.addEventListener("click", toggleMobileMenu);
  }

  document.querySelectorAll(".mobile-nav-link, .mobile-menu-cta").forEach((el) => {
    el.addEventListener("click", () => {
      if (isMenuOpen) toggleMobileMenu();
    });
  });
</script>
