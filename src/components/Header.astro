---
// src/components/Header.astro
import { Sun, Moon, Globe, ChevronDown, Check } from "lucide-astro";
import { t, getLocalizedPath, type Locale, type TranslationKey } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;

const navLinks: { key: TranslationKey; baseHref: string }[] = [
  { key: "nav.home", baseHref: "/" },
  { key: "nav.tentang", baseHref: "/tentang" },
  { key: "nav.layanan", baseHref: "/layanan" },
  { key: "nav.portfolio", baseHref: "/portfolio" },
  { key: "nav.pricing", baseHref: "/pricing" },
  { key: "nav.faq", baseHref: "/faq" },
  { key: "nav.contact", baseHref: "/contact" },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 w-full py-6 md:py-8 transition-all duration-300">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <!-- Navbar Container -->
    <div
      id="nav-container"
      class="w-full flex items-center justify-between py-0 px-0 transition-all duration-300 rounded-none border border-transparent bg-transparent"
    >
      <!-- Logo -->
      <a href={getLocalizedPath("/", lang)} data-base-href="/" class="flex items-center gap-3 group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary rounded-lg">
        <img src="/favicon.png" alt="Galacode Logo" class="h-8 w-auto md:h-10 transition-transform duration-300 group-hover:scale-105" />
        <span class="text-xl sm:text-2xl font-poller tracking-[0.1em] text-text-primary transition-colors duration-300 group-hover:text-primary">
          GALACODE
        </span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-7 lg:gap-8" aria-label="Navigasi Utama">
        {
          navLinks.map((link) => (
            <a
              href={getLocalizedPath(link.baseHref, lang)}
              data-base-href={link.baseHref}
              class="relative py-2 text-sm font-medium text-text-secondary transition-colors duration-300 hover:text-text-primary nav-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary rounded-md"
              data-path={link.baseHref}
            >
              <span data-i18n={link.key}>{t(lang, link.key)}</span>
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-primary to-secondary text-primary-foreground border border-border shadow-lg shadow-primary/25 scale-x-0 origin-right transition-transform duration-300 nav-indicator" />
            </a>
          ))
        }
      </nav>

      <div class="hidden md:flex items-center gap-3">
        <!-- Language Switcher Dropdown (Desktop) -->
        <div class="relative lang-switcher">
          <button
            type="button"
            class="lang-toggle flex items-center gap-1.5 h-10 px-3 rounded-full border border-border bg-surface text-text-primary text-xs font-bold tracking-wider transition-all duration-300 hover:bg-surface-elevated hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary cursor-pointer"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label={t(lang, "nav.langAria")}
            data-i18n-aria="nav.langAria"
          >
            <Globe class="w-4 h-4 text-primary shrink-0" />
            <span class="lang-current-label">{lang.toUpperCase()}</span>
            <ChevronDown class="w-3.5 h-3.5 text-text-muted transition-transform duration-200 lang-chevron" />
          </button>

          <div
            role="menu"
            class="lang-dropdown hidden absolute right-0 mt-2 w-36 rounded-2xl bg-surface-elevated border border-border shadow-xl p-1.5 z-50 origin-top-right transition-all duration-200"
          >
            <button
              type="button"
              role="menuitemradio"
              aria-checked={lang === "id" ? "true" : "false"}
              data-lang="id"
              class={`lang-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors cursor-pointer ${lang === "id" ? "text-primary bg-primary/10 font-bold" : "text-text-secondary hover:bg-surface hover:text-text-primary"}`}
            >
              <span>ID — Indonesia</span>
              <Check class={`w-3.5 h-3.5 lang-check ${lang === "id" ? "" : "opacity-0"}`} />
            </button>
            <button
              type="button"
              role="menuitemradio"
              aria-checked={lang === "en" ? "true" : "false"}
              data-lang="en"
              class={`lang-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors cursor-pointer ${lang === "en" ? "text-primary bg-primary/10 font-bold" : "text-text-secondary hover:bg-surface hover:text-text-primary"}`}
            >
              <span>EN — English</span>
              <Check class={`w-3.5 h-3.5 lang-check ${lang === "en" ? "" : "opacity-0"}`} />
            </button>
          </div>
        </div>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="flex items-center justify-center w-10 h-10 rounded-full border border-border bg-surface text-text-primary transition-all duration-300 hover:border-border hover:bg-surface-elevated hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary group"
          aria-label="Toggle Theme"
        >
          <Sun class="w-5 h-5 hidden dark:block text-text-primary group-hover:text-accent transition-colors" />
          <Moon class="w-5 h-5 block dark:hidden text-text-primary group-hover:text-primary transition-colors" />
        </button>

        <!-- CTA Button -->
        <a
          href={getLocalizedPath("/contact", lang)}
          data-base-href="/contact"
          data-i18n="nav.cta"
          class="inline-block bg-primary hover:bg-secondary text-primary-foreground border border-border shadow-lg shadow-primary/25 text-sm font-semibold py-3 px-6 rounded-xl transition-all duration-300 hover:scale-[1.02] hover:brightness-110 hover:shadow-xl shadow-primary/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {t(lang, "nav.cta")}
        </a>
      </div>

      <div class="md:hidden flex items-center gap-2">
        <!-- Mobile Language Switcher -->
        <div class="relative lang-switcher">
          <button
            type="button"
            class="lang-toggle flex items-center gap-1 h-10 px-2.5 rounded-full border border-border bg-surface text-text-primary text-xs font-bold tracking-wider transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary cursor-pointer"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label={t(lang, "nav.langAria")}
            data-i18n-aria="nav.langAria"
          >
            <Globe class="w-3.5 h-3.5 text-primary shrink-0" />
            <span class="lang-current-label">{lang.toUpperCase()}</span>
            <ChevronDown class="w-3 h-3 text-text-muted transition-transform duration-200 lang-chevron" />
          </button>

          <div
            role="menu"
            class="lang-dropdown hidden absolute right-0 mt-2 w-36 rounded-2xl bg-surface-elevated border border-border shadow-xl p-1.5 z-50 origin-top-right transition-all duration-200"
          >
            <button
              type="button"
              role="menuitemradio"
              aria-checked={lang === "id" ? "true" : "false"}
              data-lang="id"
              class={`lang-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors cursor-pointer ${lang === "id" ? "text-primary bg-primary/10 font-bold" : "text-text-secondary hover:bg-surface hover:text-text-primary"}`}
            >
              <span>ID — Indonesia</span>
              <Check class={`w-3.5 h-3.5 lang-check ${lang === "id" ? "" : "opacity-0"}`} />
            </button>
            <button
              type="button"
              role="menuitemradio"
              aria-checked={lang === "en" ? "true" : "false"}
              data-lang="en"
              class={`lang-option w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors cursor-pointer ${lang === "en" ? "text-primary bg-primary/10 font-bold" : "text-text-secondary hover:bg-surface hover:text-text-primary"}`}
            >
              <span>EN — English</span>
              <Check class={`w-3.5 h-3.5 lang-check ${lang === "en" ? "" : "opacity-0"}`} />
            </button>
          </div>
        </div>

        <!-- Mobile Theme Toggle -->
        <button
          id="mobile-theme-toggle"
          class="flex items-center justify-center w-10 h-10 rounded-full border border-border bg-surface text-text-primary transition-all duration-300 hover:border-border focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary group"
          aria-label="Toggle Theme"
        >
          <Sun class="w-5 h-5 hidden dark:block text-text-primary group-hover:text-accent transition-colors" />
          <Moon class="w-5 h-5 block dark:hidden text-text-primary group-hover:text-primary transition-colors" />
        </button>

        <!-- Hamburger Button -->
        <button
          id="menu-toggle"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl border border-border bg-surface text-text-primary transition-all duration-300 hover:border-border focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t(lang, "nav.openMenuAria")}
          data-i18n-aria="nav.openMenuAria"
        >
          <svg
            class="w-6 h-6 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path id="hamburger-line-1" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16" class="origin-center transition-all duration-300"></path>
            <path id="hamburger-line-2" stroke-linecap="round" stroke-linejoin="round" d="M4 12h16" class="origin-center transition-all duration-300"></path>
            <path id="hamburger-line-3" stroke-linecap="round" stroke-linejoin="round" d="M4 18h16" class="origin-center transition-all duration-300"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-background z-40 flex flex-col justify-between px-8 py-24 transition-all duration-300 opacity-0 pointer-events-none translate-y-[-10px] md:hidden"
    aria-hidden="true"
  >
    <!-- Close Button -->
    <button
      id="mobile-menu-close"
      class="absolute top-6 right-4 sm:right-6 flex items-center justify-center w-10 h-10 rounded-full bg-surface border border-border text-text-secondary transition-all duration-300 hover:text-text-primary hover:border-border/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-label={t(lang, "nav.closeMenuAria")}
      data-i18n-aria="nav.closeMenuAria"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <!-- Navigation Links -->
    <nav class="flex flex-col gap-6 text-center" aria-label="Navigasi Utama Mobile">
      {
        navLinks.map((link) => (
          <a
            href={getLocalizedPath(link.baseHref, lang)}
            data-base-href={link.baseHref}
            data-i18n={link.key}
            class="text-2xl font-bold text-text-secondary transition-colors duration-300 hover:text-primary mobile-nav-link"
            data-path={link.baseHref}
          >
            {t(lang, link.key)}
          </a>
        ))
      }
    </nav>

    <!-- Bottom Mobile CTA -->
    <div class="w-full text-center">
      <a
        href={getLocalizedPath("/contact", lang)}
        data-base-href="/contact"
        data-i18n="nav.cta"
        class="mobile-menu-cta w-full inline-block bg-primary hover:bg-secondary text-primary-foreground border border-border shadow-lg shadow-primary/25 font-semibold py-4 px-8 rounded-xl shadow-xl shadow-primary/30 transition-all duration-300 hover:brightness-110"
      >
        {t(lang, "nav.cta")}
      </a>
    </div>
  </div>
</header>

<script>
  import { applyLanguage } from "../i18n/client";
  import { stripLocalePrefix, type Locale } from "../i18n";

  // Theme & Language Switcher Dropdown Logic
  const closeAllLangDropdowns = () => {
    document.querySelectorAll(".lang-switcher").forEach((switcher) => {
      const btn = switcher.querySelector(".lang-toggle");
      const dropdown = switcher.querySelector(".lang-dropdown");
      const chevron = switcher.querySelector(".lang-chevron") as HTMLElement | null;
      btn?.setAttribute("aria-expanded", "false");
      dropdown?.classList.add("hidden");
      if (chevron) chevron.style.transform = "rotate(0deg)";
    });
  };

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    // Theme toggle
    const toggleBtn = target.closest("#theme-toggle, #mobile-theme-toggle");
    if (toggleBtn) {
      e.preventDefault();
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      }
      return;
    }

    // Language dropdown toggle
    const langToggle = target.closest(".lang-toggle");
    if (langToggle) {
      e.preventDefault();
      e.stopPropagation();
      const switcher = langToggle.closest(".lang-switcher");
      const dropdown = switcher?.querySelector(".lang-dropdown");
      const chevron = switcher?.querySelector(".lang-chevron") as HTMLElement | null;
      const isOpen = dropdown && !dropdown.classList.contains("hidden");

      closeAllLangDropdowns();
      if (!isOpen && dropdown) {
        dropdown.classList.remove("hidden");
        langToggle.setAttribute("aria-expanded", "true");
        if (chevron) chevron.style.transform = "rotate(180deg)";
      }
      return;
    }

    // Language option click
    const langOption = target.closest(".lang-option") as HTMLElement | null;
    if (langOption) {
      e.preventDefault();
      const newLang = langOption.getAttribute("data-lang") as Locale | null;
      if (newLang === "id" || newLang === "en") {
        applyLanguage(newLang, { updateUrl: true });
      }
      closeAllLangDropdowns();
      return;
    }

    // Click outside closes dropdowns
    if (!target.closest(".lang-switcher")) {
      closeAllLangDropdowns();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeAllLangDropdowns();
    }
  });

  // Handle active route highlighting (works for both /path and /en/path)
  const normalizedPath = stripLocalePrefix(window.location.pathname).replace(/\/$/, "") || "/";
  document.querySelectorAll(".nav-link").forEach((link) => {
    const linkBase = link.getAttribute("data-path") || "/";
    if (linkBase === normalizedPath) {
      link.classList.add("text-text-primary");
      link.classList.remove("text-text-secondary");
      const indicator = link.querySelector(".nav-indicator");
      if (indicator) {
        indicator.classList.remove("scale-x-0");
        indicator.classList.add("scale-x-100");
      }
    }
  });

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    const linkBase = link.getAttribute("data-path") || "/";
    if (linkBase === normalizedPath) {
      link.classList.add("text-primary");
      link.classList.remove("text-text-secondary");
    }
  });

  // Handle scroll for floating navbar
  const header = document.getElementById("main-header");
  const navContainer = document.getElementById("nav-container");
  
  function handleScroll() {
    if (window.scrollY > 20) {
      if(header) {
        header.classList.add("py-3", "md:py-4");
        header.classList.remove("py-6", "md:py-8");
      }
      if(navContainer) {
        navContainer.classList.add("bg-surface/95", "backdrop-blur-md", "border-border", "shadow-lg", "shadow-black/50", "px-6", "py-3", "rounded-[24px]");
        navContainer.classList.remove("py-0", "px-0", "rounded-none", "border-transparent", "bg-transparent");
      }
    } else {
      if(header) {
        header.classList.add("py-6", "md:py-8");
        header.classList.remove("py-3", "md:py-4");
      }
      if(navContainer) {
        navContainer.classList.remove("bg-surface/95", "backdrop-blur-md", "border-border", "shadow-lg", "shadow-black/50", "px-6", "py-3", "rounded-[24px]");
        navContainer.classList.add("py-0", "px-0", "rounded-none", "border-transparent", "bg-transparent");
      }
    }
  }
  
  window.addEventListener("scroll", handleScroll);
  handleScroll();

  // Mobile menu toggle logic
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const line1 = document.getElementById("hamburger-line-1");
  const line2 = document.getElementById("hamburger-line-2");
  const line3 = document.getElementById("hamburger-line-3");
  
  let isMenuOpen = false;
  
  function toggleMobileMenu() {
    isMenuOpen = !isMenuOpen;
    if(menuToggle) menuToggle.setAttribute("aria-expanded", isMenuOpen ? "true" : "false");
    if(mobileMenu) mobileMenu.setAttribute("aria-hidden", isMenuOpen ? "false" : "true");

    if (isMenuOpen) {
      if(mobileMenu) {
        mobileMenu.classList.remove("opacity-0", "pointer-events-none", "translate-y-[-10px]");
        mobileMenu.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
      }
      document.body.style.overflow = "hidden";
      if(line1) line1.setAttribute("transform", "rotate(45) translate(6, -6)");
      if(line2) line2.classList.add("opacity-0");
      if(line3) line3.setAttribute("transform", "rotate(-45) translate(-6, -6)");
    } else {
      if(mobileMenu) {
        mobileMenu.classList.add("opacity-0", "pointer-events-none", "translate-y-[-10px]");
        mobileMenu.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      }
      document.body.style.overflow = "";
      if(line1) line1.removeAttribute("transform");
      if(line2) line2.classList.remove("opacity-0");
      if(line3) line3.removeAttribute("transform");
    }
  }

  if (menuToggle) {
    menuToggle.addEventListener("click", toggleMobileMenu);
  }

  const menuClose = document.getElementById("mobile-menu-close");
  if (menuClose) {
    menuClose.addEventListener("click", toggleMobileMenu);
  }

  document.querySelectorAll(".mobile-nav-link, .mobile-menu-cta").forEach((el) => {
    el.addEventListener("click", () => {
      if (isMenuOpen) toggleMobileMenu();
    });
  });
</script>
