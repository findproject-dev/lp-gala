---
// src/components/WhyGalacode.astro
---

<section id="why-galacode" class="relative py-24 md:py-32 bg-background overflow-hidden">


  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-20">
      <div class="inline-flex items-center justify-center gap-2 px-3 py-1.5 mb-6 rounded-full border border-border bg-surface shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <span class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-text-primary">Standar Teknis</span>
      </div>
      
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight text-balance mb-4 md:mb-6">
        Dibangun dengan <span class="text-primary block md:inline mt-1 md:mt-0">Fondasi yang Benar</span>
      </h2>
      
      <p class="text-base sm:text-lg md:text-xl text-text-secondary leading-relaxed text-balance px-2 md:px-0">
        Dapatkan website tanpa jalan pintas. Dirancang rapi agar awet dan bisa diandalkan untuk jangka panjang.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Card 1 -->
      <div class="group bg-surface-elevated border border-border/50 rounded-2xl p-6 md:p-8 transition-all duration-300 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col">
        <div class="w-12 h-12 flex items-center justify-center text-primary mb-5 md:mb-6 rounded-xl bg-primary/5 border border-primary/10 transition-colors md:group-hover:bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        </div>
        <h3 class="text-lg md:text-xl font-bold text-text-primary mb-3">Halaman Terbuka Cepat</h3>
        <p class="text-text-secondary leading-relaxed text-sm">
          Loading cepat agar pengunjung tidak bosan menunggu.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="group bg-surface-elevated border border-border/50 rounded-2xl p-6 md:p-8 transition-all duration-300 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col">
        <div class="w-12 h-12 flex items-center justify-center text-primary mb-5 md:mb-6 rounded-xl bg-primary/5 border border-primary/10 transition-colors md:group-hover:bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
        </div>
        <h3 class="text-lg md:text-xl font-bold text-text-primary mb-3">Nyaman di HP</h3>
        <p class="text-text-secondary leading-relaxed text-sm">
          Tulisan dan gambar otomatis menyesuaikan layar. Tetap rapi saat dibuka dari smartphone.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="group bg-surface-elevated border border-border/50 rounded-2xl p-6 md:p-8 transition-all duration-300 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col">
        <div class="w-12 h-12 flex items-center justify-center text-primary mb-5 md:mb-6 rounded-xl bg-primary/5 border border-primary/10 transition-colors md:group-hover:bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <h3 class="text-lg md:text-xl font-bold text-text-primary mb-3">Mudah Ditemukan Google</h3>
        <p class="text-text-secondary leading-relaxed text-sm">
          Struktur data rapi agar nama bisnis Anda lebih mudah dikenali mesin pencari.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="group bg-surface-elevated border border-border/50 rounded-2xl p-6 md:p-8 transition-all duration-300 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col">
        <div class="w-12 h-12 flex items-center justify-center text-primary mb-5 md:mb-6 rounded-xl bg-primary/5 border border-primary/10 transition-colors md:group-hover:bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3 class="text-lg md:text-xl font-bold text-text-primary mb-3">Sistem Lebih Aman</h3>
        <p class="text-text-secondary leading-relaxed text-sm">
          Protokol keamanan standar untuk melindungi data penting operasional bisnis Anda.
        </p>
      </div>

      <!-- Card 5 -->
      <div class="group bg-surface-elevated border border-border/50 rounded-2xl p-6 md:p-8 transition-all duration-300 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col">
        <div class="w-12 h-12 flex items-center justify-center text-primary mb-5 md:mb-6 rounded-xl bg-primary/5 border border-primary/10 transition-colors md:group-hover:bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        </div>
        <h3 class="text-lg md:text-xl font-bold text-text-primary mb-3">Bebas Update Sendiri</h3>
        <p class="text-text-secondary leading-relaxed text-sm">
          Ubah teks atau foto sendiri lewat panel admin. Tidak perlu panggil teknisi untuk hal kecil.
        </p>
      </div>

      <!-- Card 6 -->
      <div class="group bg-surface-elevated border border-border/50 rounded-2xl p-6 md:p-8 transition-all duration-300 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col">
        <div class="w-12 h-12 flex items-center justify-center text-primary mb-5 md:mb-6 rounded-xl bg-primary/5 border border-primary/10 transition-colors md:group-hover:bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        </div>
        <h3 class="text-lg md:text-xl font-bold text-text-primary mb-3">Hosting Stabil</h3>
        <p class="text-text-secondary leading-relaxed text-sm">
          Infrastruktur andal agar website terus online dan siap menerima kunjungan kapan pun.
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  import { animate, inView } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const section = document.querySelector("#why-galacode .max-w-7xl");
    if (section) {
      // Prepare initial state to prevent flash
      section.style.opacity = "0";
      
      let animated = false;
      inView(section, () => {
        if (animated) return;
        animated = true;
        
        const isMobile = window.innerWidth < 768;
        const yOffset = isMobile ? 16 : 32;
        
        animate(
          section,
          { opacity: [0, 1], y: [yOffset, 0] },
          { duration: 0.7, easing: [0.22, 1, 0.36, 1] }
        );
      }, { margin: "-15% 0px" });
    }
  }
</script>
