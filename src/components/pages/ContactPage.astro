---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { MessageSquare, ArrowRight, ChevronDown, Zap, Handshake, Sparkles } from "lucide-astro";
import { t, getLocalizedPath, type Locale } from "../../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;

const waCtaUrl = `https://wa.me/6281919564548?text=${encodeURIComponent(t(lang, "contact.cta.waMsg"))}`;
---

<Layout lang={lang} pageKey="contact">
  <Header lang={lang} />
  <main class="min-h-screen pt-24 md:pt-32 pb-24 relative overflow-hidden">
    <!-- Background Decor -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
      <div class="absolute -top-[10%] -right-[5%] w-[60%] h-[60%] rounded-full bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-border/80 to-transparent blur-[32px] transform-gpu"></div>
      <div class="absolute top-[30%] -left-[5%] w-[40%] h-[40%] rounded-full bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/30 to-transparent blur-[32px] transform-gpu"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 md:space-y-32">
      
      <!-- 1. Hero Section -->
      <section class="text-center max-w-3xl mx-auto flex flex-col items-center pt-8 md:pt-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-border/50 border border-border text-text-primary font-medium text-sm mb-8 animate-fade-in-up">
          <span>💬</span> <span data-i18n="contact.badge">{t(lang, "contact.badge")}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-text-primary tracking-tight mb-6 animate-fade-in-up leading-tight" style="animation-delay: 100ms;" data-i18n="contact.title">
          {t(lang, "contact.title")}
        </h1>
        <p class="text-lg md:text-xl text-text-secondary leading-relaxed animate-fade-in-up max-w-2xl mx-auto" style="animation-delay: 200ms;" data-i18n="contact.subtitle">
          {t(lang, "contact.subtitle")}
        </p>
      </section>

      <!-- 2. Consultation Form -->
      <div class="max-w-4xl mx-auto w-full">
        <section class="animate-fade-in-up" style="animation-delay: 300ms;">
          <div class="bg-surface rounded-[2.5rem] border border-border shadow-xl shadow-primary/5 p-8 md:p-12 lg:p-16 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-white/40 dark:from-white/5 to-transparent pointer-events-none"></div>
            <div class="relative z-10">
              <form id="wa-form" data-track="form_submit" class="space-y-8">
                <!-- Form Row 1 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="space-y-2 relative">
                    <label class="text-sm font-semibold text-text-secondary ml-1"><span data-i18n="contact.form.nameLabel">{t(lang, "contact.form.nameLabel")}</span> <span class="text-red-500">*</span></label>
                    <input type="text" id="wa-name" placeholder={t(lang, "contact.form.namePlaceholder")} data-i18n-placeholder="contact.form.namePlaceholder" class="form-input w-full bg-background border-2 border-glass-10 rounded-2xl px-5 py-3.5 focus:outline-none focus:border-accent/40 focus:ring-4 focus:ring-accent/10 transition-all text-text-primary" />
                    <span class="error-msg absolute -bottom-5 left-2 text-xs font-medium text-red-500 opacity-0 transition-opacity" data-i18n="contact.form.nameError">{t(lang, "contact.form.nameError")}</span>
                  </div>
                  <div class="space-y-2 relative">
                    <label class="text-sm font-semibold text-text-secondary ml-1"><span data-i18n="contact.form.businessLabel">{t(lang, "contact.form.businessLabel")}</span> <span class="text-red-500">*</span></label>
                    <input type="text" id="wa-business" placeholder={t(lang, "contact.form.businessPlaceholder")} data-i18n-placeholder="contact.form.businessPlaceholder" class="form-input w-full bg-background border-2 border-glass-10 rounded-2xl px-5 py-3.5 focus:outline-none focus:border-accent/40 focus:ring-4 focus:ring-accent/10 transition-all text-text-primary" />
                    <span class="error-msg absolute -bottom-5 left-2 text-xs font-medium text-red-500 opacity-0 transition-opacity" data-i18n="contact.form.businessError">{t(lang, "contact.form.businessError")}</span>
                  </div>
                </div>

                <!-- Form Row 2 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="space-y-2 relative">
                    <label class="text-sm font-semibold text-text-secondary ml-1"><span data-i18n="contact.form.typeLabel">{t(lang, "contact.form.typeLabel")}</span> <span class="text-red-500">*</span></label>
                    <select id="wa-type" class="form-input w-full bg-background border-2 border-glass-10 rounded-2xl px-5 py-3.5 focus:outline-none focus:border-accent/40 focus:ring-4 focus:ring-accent/10 transition-all text-text-primary cursor-pointer">
                      <option value="" disabled selected data-i18n="contact.form.typeDefault">{t(lang, "contact.form.typeDefault")}</option>
                      <option value="Lead Generation Website" data-i18n="contact.form.typeOpt1">{t(lang, "contact.form.typeOpt1")}</option>
                      <option value="Booking Website" data-i18n="contact.form.typeOpt2">{t(lang, "contact.form.typeOpt2")}</option>
                      <option value="Sales Website" data-i18n="contact.form.typeOpt3">{t(lang, "contact.form.typeOpt3")}</option>
                      <option value="Business Website" data-i18n="contact.form.typeOpt4">{t(lang, "contact.form.typeOpt4")}</option>
                      <option value="Other / Not Sure Yet" data-i18n="contact.form.typeOpt5">{t(lang, "contact.form.typeOpt5")}</option>
                    </select>
                    <span class="error-msg absolute -bottom-5 left-2 text-xs font-medium text-red-500 opacity-0 transition-opacity" data-i18n="contact.form.typeError">{t(lang, "contact.form.typeError")}</span>
                  </div>
                  <div class="space-y-2 relative">
                    <label class="text-sm font-semibold text-text-secondary ml-1"><span data-i18n="contact.form.budgetLabel">{t(lang, "contact.form.budgetLabel")}</span> <span class="text-red-500">*</span></label>
                    <select id="wa-budget" class="form-input w-full bg-background border-2 border-glass-10 rounded-2xl px-5 py-3.5 focus:outline-none focus:border-accent/40 focus:ring-4 focus:ring-accent/10 transition-all text-text-primary cursor-pointer">
                      <option value="" disabled selected data-i18n="contact.form.budgetDefault">{t(lang, "contact.form.budgetDefault")}</option>
                      <option value="< Rp2 Juta" data-i18n="contact.form.budgetOpt1">{t(lang, "contact.form.budgetOpt1")}</option>
                      <option value="Rp2–5 Juta" data-i18n="contact.form.budgetOpt2">{t(lang, "contact.form.budgetOpt2")}</option>
                      <option value="Rp5–10 Juta" data-i18n="contact.form.budgetOpt3">{t(lang, "contact.form.budgetOpt3")}</option>
                      <option value="> Rp10 Juta" data-i18n="contact.form.budgetOpt4">{t(lang, "contact.form.budgetOpt4")}</option>
                    </select>
                    <span class="error-msg absolute -bottom-5 left-2 text-xs font-medium text-red-500 opacity-0 transition-opacity" data-i18n="contact.form.budgetError">{t(lang, "contact.form.budgetError")}</span>
                  </div>
                </div>

                <!-- Form Row 3 -->
                <div class="space-y-2 relative">
                  <label class="text-sm font-semibold text-text-primary/80 ml-1"><span data-i18n="contact.form.descLabel">{t(lang, "contact.form.descLabel")}</span> <span class="text-red-500">*</span></label>
                  <textarea id="wa-desc" rows="4" placeholder={t(lang, "contact.form.descPlaceholder")} data-i18n-placeholder="contact.form.descPlaceholder" class="form-input w-full bg-background border-2 border-glass-10 rounded-2xl px-5 py-3.5 focus:outline-none focus:border-accent/40 focus:ring-4 focus:ring-accent/10 transition-all text-text-primary resize-none"></textarea>
                  <span class="error-msg absolute -bottom-5 left-2 text-xs font-medium text-red-500 opacity-0 transition-opacity" data-i18n="contact.form.descError">{t(lang, "contact.form.descError")}</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="wa-submit" class="w-full bg-primary hover:bg-secondary text-primary-foreground shadow-lg shadow-primary/25 border border-border font-bold rounded-2xl py-3.5 mt-2 hover:bg-surface-elevated/90 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 text-base relative overflow-hidden group focus:outline-none focus:ring-4 focus:ring-secondary/30">
                  <span class="btn-text flex items-center gap-2 transition-opacity"><span data-i18n="contact.form.submit">{t(lang, "contact.form.submit")}</span> <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" /></span>
                  <span class="btn-loader absolute inset-0 bg-surface-elevated flex items-center justify-center opacity-0 pointer-events-none transition-opacity">
                    <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span data-i18n="contact.form.processing">{t(lang, "contact.form.processing")}</span>
                  </span>
                </button>
              </form>
            </div>
          </div>
        </section>
      </div>

      <!-- 3. Why Consult with Galacode -->
      <section class="max-w-5xl mx-auto scroll-reveal opacity-0 translate-y-8 pt-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 lg:gap-8">
          <div class="bg-surface rounded-3xl p-8 lg:p-10 border border-border shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-white/40 dark:from-white/5 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative z-10 flex flex-col items-start">
              <div class="w-14 h-14 rounded-2xl bg-border/50 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all duration-300">
                <Sparkles class="w-7 h-7 text-text-primary group-hover:text-accent transition-colors" />
              </div>
              <h3 class="text-xl font-bold text-text-primary mb-3" data-i18n="contact.benefit1.title">{t(lang, "contact.benefit1.title")}</h3>
              <p class="text-text-secondary leading-relaxed text-base" data-i18n="contact.benefit1.desc">{t(lang, "contact.benefit1.desc")}</p>
            </div>
          </div>
          <div class="bg-surface rounded-3xl p-8 lg:p-10 border border-border shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-white/40 dark:from-white/5 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative z-10 flex flex-col items-start">
              <div class="w-14 h-14 rounded-2xl bg-border/50 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all duration-300">
                <Zap class="w-7 h-7 text-text-primary group-hover:text-accent transition-colors" />
              </div>
              <h3 class="text-xl font-bold text-text-primary mb-3" data-i18n="contact.benefit2.title">{t(lang, "contact.benefit2.title")}</h3>
              <p class="text-text-secondary leading-relaxed text-base" data-i18n="contact.benefit2.desc">{t(lang, "contact.benefit2.desc")}</p>
            </div>
          </div>
          <div class="bg-surface rounded-3xl p-8 lg:p-10 border border-border shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-white/40 dark:from-white/5 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative z-10 flex flex-col items-start">
              <div class="w-14 h-14 rounded-2xl bg-border/50 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all duration-300">
                <Handshake class="w-7 h-7 text-text-primary group-hover:text-accent transition-colors" />
              </div>
              <h3 class="text-xl font-bold text-text-primary mb-3" data-i18n="contact.benefit3.title">{t(lang, "contact.benefit3.title")}</h3>
              <p class="text-text-secondary leading-relaxed text-base" data-i18n="contact.benefit3.desc">{t(lang, "contact.benefit3.desc")}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Mini FAQ -->
      <section class="max-w-3xl mx-auto scroll-reveal opacity-0 translate-y-8 pt-8">
        <div class="text-center mb-10 md:mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary" data-i18n="contact.faq.title">{t(lang, "contact.faq.title")}</h2>
        </div>
        <div class="space-y-4">
          <div class="mini-faq-item bg-surface rounded-2xl border border-border p-6 md:p-8 shadow-sm hover:shadow-md transition-all duration-300">
            <button class="mini-faq-trigger flex items-center justify-between w-full text-left group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg" aria-expanded="false">
              <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors pr-4" data-i18n="contact.faq.1.q">{t(lang, "contact.faq.1.q")}</h3>
              <div class="w-10 h-10 rounded-full bg-border flex items-center justify-center group-hover:bg-primary/20 transition-colors shrink-0">
                <ChevronDown class="mini-faq-icon w-5 h-5 text-text-primary group-hover:text-accent transition-transform duration-300" />
              </div>
            </button>
            <div class="mini-faq-content overflow-hidden h-0 opacity-0">
              <p class="text-text-secondary leading-relaxed pt-5" data-i18n="contact.faq.1.a">{t(lang, "contact.faq.1.a")}</p>
            </div>
          </div>
          <div class="mini-faq-item bg-surface rounded-2xl border border-border p-6 md:p-8 shadow-sm hover:shadow-md transition-all duration-300">
            <button class="mini-faq-trigger flex items-center justify-between w-full text-left group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg" aria-expanded="false">
              <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors pr-4" data-i18n="contact.faq.2.q">{t(lang, "contact.faq.2.q")}</h3>
              <div class="w-10 h-10 rounded-full bg-border flex items-center justify-center group-hover:bg-primary/20 transition-colors shrink-0">
                <ChevronDown class="mini-faq-icon w-5 h-5 text-text-primary group-hover:text-accent transition-transform duration-300" />
              </div>
            </button>
            <div class="mini-faq-content overflow-hidden h-0 opacity-0">
              <p class="text-text-secondary leading-relaxed pt-5" data-i18n="contact.faq.2.a">{t(lang, "contact.faq.2.a")}</p>
            </div>
          </div>
          <div class="mini-faq-item bg-surface rounded-2xl border border-border p-6 md:p-8 shadow-sm hover:shadow-md transition-all duration-300">
            <button class="mini-faq-trigger flex items-center justify-between w-full text-left group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg" aria-expanded="false">
              <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors pr-4" data-i18n="contact.faq.3.q">{t(lang, "contact.faq.3.q")}</h3>
              <div class="w-10 h-10 rounded-full bg-border flex items-center justify-center group-hover:bg-primary/20 transition-colors shrink-0">
                <ChevronDown class="mini-faq-icon w-5 h-5 text-text-primary group-hover:text-accent transition-transform duration-300" />
              </div>
            </button>
            <div class="mini-faq-content overflow-hidden h-0 opacity-0">
              <p class="text-text-secondary leading-relaxed pt-5" data-i18n="contact.faq.3.a">{t(lang, "contact.faq.3.a")}</p>
            </div>
          </div>
        </div>
        
        <div class="text-center mt-10 md:mt-12">
          <a href={getLocalizedPath("/faq", lang)} data-base-href="/faq" class="inline-flex items-center gap-3 bg-surface border-2 border-glass-10 text-text-primary px-8 py-3.5 rounded-2xl font-bold hover:border-accent/50 hover:bg-primary/20 hover:text-accent transition-all hover:-translate-y-1 hover:shadow-lg focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/20 group">
            <span data-i18n="contact.faq.allBtn">{t(lang, "contact.faq.allBtn")}</span> <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </section>

      <!-- 5. Final CTA -->
      <section class="scroll-reveal opacity-0 translate-y-8 max-w-3xl mx-auto w-full">
        <div class="w-full bg-surface border-2 border-glass-10 rounded-[2rem] p-8 md:p-10 text-center shadow-lg relative overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent pointer-events-none transition-opacity duration-700 opacity-50 group-hover:opacity-100"></div>
          <div class="absolute -top-[50%] -left-[10%] w-[60%] h-[150%] rounded-full bg-[radial-gradient(ellipse,_var(--tw-gradient-stops))] from-primary/30 to-transparent blur-[32px] pointer-events-none transform-gpu group-hover:translate-x-12 transition-transform duration-1000 ease-out"></div>
          <div class="absolute -bottom-[50%] -right-[10%] w-[50%] h-[150%] rounded-full bg-[radial-gradient(ellipse,_var(--tw-gradient-stops))] from-border/70 to-transparent blur-[32px] pointer-events-none transform-gpu group-hover:-translate-x-12 transition-transform duration-1000 ease-out"></div>
          
          <div class="relative z-10 max-w-xl mx-auto flex flex-col items-center">
            <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-4 tracking-tight" data-i18n="contact.cta.title">{t(lang, "contact.cta.title")}</h2>
            <p class="text-text-secondary text-sm md:text-base mb-8 leading-relaxed" data-i18n="contact.cta.desc">{t(lang, "contact.cta.desc")}</p>
            
            <a 
              href={waCtaUrl}
              data-i18n-wa="contact.cta.waMsg"
              target="_blank" 
              rel="noopener noreferrer"
              data-track="whatsapp_click"
              class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-primary-foreground shadow-lg shadow-primary/25 border border-border px-6 py-3.5 rounded-xl font-bold text-sm md:text-base hover:bg-surface-elevated/90 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-secondary/20 focus:outline-none focus-visible:ring-4 focus-visible:ring-secondary/30 active:scale-95 group/btn"
              aria-label={t(lang, "contact.cta.btn")}
              data-i18n-aria="contact.cta.btn"
            >
              <MessageSquare class="w-4 h-4 group-hover/btn:scale-110 transition-transform" aria-hidden="true" />
              <span data-i18n="contact.cta.btn">{t(lang, "contact.cta.btn")}</span>
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer lang={lang} />

  <style>
    @keyframes fade-in-up {
      0% { opacity: 0; transform: translateY(25px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
      opacity: 0;
      animation: fade-in-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
  </style>

  <script>
    import { animate, inView } from "motion";

    document.addEventListener("DOMContentLoaded", () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealElements = document.querySelectorAll(".scroll-reveal");

      if (!prefersReducedMotion) {
        revealElements.forEach((el) => {
          inView(el, () => {
            animate(
              el as any,
              { opacity: [0, 1], y: [32, 0] } as any,
              { duration: 0.7, easing: "ease-out" } as any
            );
          }, { margin: "-10% 0px" });
        });
      } else {
        revealElements.forEach((el) => {
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.transform = 'none';
        });
      }

      // WhatsApp Form Logic
      const form = document.getElementById('wa-form') as HTMLFormElement;
      const submitBtn = document.getElementById('wa-submit') as HTMLButtonElement;
      
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          
          const nameInput = document.getElementById('wa-name') as HTMLInputElement;
          const businessInput = document.getElementById('wa-business') as HTMLInputElement;
          const typeInput = document.getElementById('wa-type') as HTMLSelectElement;
          const budgetInput = document.getElementById('wa-budget') as HTMLSelectElement;
          const descInput = document.getElementById('wa-desc') as HTMLTextAreaElement;
          
          let isValid = true;
          const inputs = [nameInput, businessInput, typeInput, budgetInput, descInput];
          
          inputs.forEach(input => {
            const errorMsg = input.nextElementSibling?.classList.contains('error-msg') ? input.nextElementSibling as HTMLElement : input.parentElement?.querySelector('.error-msg') as HTMLElement;
            if (!input.value.trim()) {
              isValid = false;
              input.classList.add('border-red-400', 'ring-red-100', 'focus:border-red-400', 'focus:ring-red-100');
              input.classList.remove('border-glass-10', 'focus:border-accent/40', 'focus:ring-accent/10');
              if (errorMsg) errorMsg.style.opacity = '1';
            } else {
              input.classList.remove('border-red-400', 'ring-red-100', 'focus:border-red-400', 'focus:ring-red-100');
              input.classList.add('border-glass-10', 'focus:border-accent/40', 'focus:ring-accent/10');
              if (errorMsg) errorMsg.style.opacity = '0';
            }
          });
          
          inputs.forEach(input => {
            input.addEventListener('input', () => {
              const errorMsg = input.nextElementSibling?.classList.contains('error-msg') ? input.nextElementSibling as HTMLElement : input.parentElement?.querySelector('.error-msg') as HTMLElement;
              input.classList.remove('border-red-400', 'ring-red-100', 'focus:border-red-400', 'focus:ring-red-100');
              input.classList.add('border-glass-10', 'focus:border-accent/40', 'focus:ring-accent/10');
              if (errorMsg) errorMsg.style.opacity = '0';
            }, { once: true });
          });

          if (!isValid) return;
          
          submitBtn.disabled = true;
          const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
          const btnLoader = submitBtn.querySelector('.btn-loader') as HTMLElement;
          if (btnText) btnText.style.opacity = '0';
          if (btnLoader) btnLoader.style.opacity = '1';

          const isEn = document.documentElement.lang === 'en';
          const selectedTypeText = typeInput.options[typeInput.selectedIndex]?.text || typeInput.value;
          const selectedBudgetText = budgetInput.options[budgetInput.selectedIndex]?.text || budgetInput.value;

          const text = isEn
            ? `Hi Galacode 👋\n\nName: ${nameInput.value}\nBusiness Name: ${businessInput.value}\nWebsite Type: ${selectedTypeText}\nEstimated Budget: ${selectedBudgetText}\nProject Requirements: ${descInput.value}\n\nI would like to consult regarding this project.\n\nThank you.`
            : `Halo Galacode 👋\n\nNama: ${nameInput.value}\nNama Bisnis: ${businessInput.value}\nJenis Website: ${selectedTypeText}\nBudget: ${selectedBudgetText}\nKebutuhan: ${descInput.value}\n\nSaya ingin berkonsultasi mengenai proyek ini.\n\nTerima kasih.`;
          
          setTimeout(() => {
            window.open(`https://wa.me/6281919564548?text=${encodeURIComponent(text)}`, '_blank');
            
            submitBtn.disabled = false;
            if (btnText) btnText.style.opacity = '1';
            if (btnLoader) btnLoader.style.opacity = '0';
            form.reset();
          }, 800);
        });
      }

      // Mini FAQ Logic
      const miniFaqItems = document.querySelectorAll('.mini-faq-item');
      let activeMiniFaq: HTMLElement | null = null;
      
      const openMiniFaq = (item: HTMLElement) => {
        const trigger = item.querySelector('.mini-faq-trigger');
        const content = item.querySelector('.mini-faq-content');
        const icon = item.querySelector('.mini-faq-icon');
        
        trigger?.setAttribute('aria-expanded', 'true');
        item.classList.add('shadow-md');
        item.classList.remove('shadow-sm');
        
        if (icon && !prefersReducedMotion) (icon as HTMLElement).style.transform = 'rotate(180deg)';
        
        if (content) {
          (content as HTMLElement).style.height = 'auto';
          const targetHeight = (content as HTMLElement).offsetHeight;
          (content as HTMLElement).style.height = '0px';
          
          if (!prefersReducedMotion) {
            animate(
              content, 
              { height: ["0px", `${targetHeight}px`], opacity: [0, 1] }, 
              { duration: 0.4, easing: [0.22, 1, 0.36, 1] }
            ).finished.then(() => {
              (content as HTMLElement).style.height = 'auto';
            });
          } else {
            (content as HTMLElement).style.height = 'auto';
            (content as HTMLElement).style.opacity = '1';
          }
        }
      };
      
      const closeMiniFaq = (item: HTMLElement) => {
        const trigger = item.querySelector('.mini-faq-trigger');
        const content = item.querySelector('.mini-faq-content');
        const icon = item.querySelector('.mini-faq-icon');
        
        trigger?.setAttribute('aria-expanded', 'false');
        item.classList.remove('shadow-md');
        item.classList.add('shadow-sm');
        
        if (icon && !prefersReducedMotion) (icon as HTMLElement).style.transform = 'rotate(0deg)';
        
        if (content) {
          const currentHeight = (content as HTMLElement).offsetHeight;
          (content as HTMLElement).style.height = `${currentHeight}px`;
          
          if (!prefersReducedMotion) {
            animate(
              content, 
              { height: [`${currentHeight}px`, "0px"], opacity: [1, 0] }, 
              { duration: 0.3, easing: [0.22, 1, 0.36, 1] }
            ).finished.then(() => {
              (content as HTMLElement).style.height = '0px';
            });
          } else {
            (content as HTMLElement).style.height = '0px';
            (content as HTMLElement).style.opacity = '0';
          }
        }
      };

      miniFaqItems.forEach(item => {
        const el = item as HTMLElement;
        const trigger = el.querySelector('.mini-faq-trigger');
        trigger?.addEventListener('click', () => {
          if (activeMiniFaq === el) {
            closeMiniFaq(el);
            activeMiniFaq = null;
          } else {
            if (activeMiniFaq) closeMiniFaq(activeMiniFaq);
            openMiniFaq(el);
            activeMiniFaq = el;
          }
        });
      });
    });
  </script>
</Layout>
