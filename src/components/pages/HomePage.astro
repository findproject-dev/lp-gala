---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Hero from "../Hero.astro";
import Problem from "../Problem.astro";
import Services from "../Services.astro";
import HowWeWork from "../HowWeWork.astro";
import PortfolioPreview from "../PortfolioPreview.astro";
import CTA from "../CTA.astro";
import Footer from "../Footer.astro";
import type { Locale } from "../../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;
---

<Layout lang={lang} pageKey="home">
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Problem lang={lang} />
    <Services lang={lang} />
    <HowWeWork lang={lang} />
    <PortfolioPreview lang={lang} />
    <CTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
