---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import PortfolioHero from "../portfolio/PortfolioHero.astro";
import PortfolioGrid from "../portfolio/PortfolioGrid.astro";
import CTA from "../CTA.astro";
import Footer from "../Footer.astro";
import type { Locale } from "../../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;
---

<Layout lang={lang} pageKey="portfolio">
  <Header lang={lang} />
  <main class="flex-grow pt-32 pb-24 space-y-24 md:space-y-32">
    <PortfolioHero lang={lang} />
    <PortfolioGrid lang={lang} />
    <CTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
