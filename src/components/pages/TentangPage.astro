---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import CTA from "../CTA.astro";
import Footer from "../Footer.astro";
import { t, getLocalizedPath, type Locale } from "../../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;
---

<Layout lang={lang} pageKey="tentang">
  <Header lang={lang} />

  <main class="overflow-x-hidden pt-24 md:pt-28">

    <!-- SECTION 1: HERO (Brand Identity) -->
    <section id="hero" class="relative py-16 md:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden bg-background">
      <div class="absolute top-[10%] left-[5%] w-[380px] sm:w-[550px] h-[380px] sm:h-[550px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/20 via-secondary/10 to-transparent rounded-full blur-[80px] -z-10 pointer-events-none transform-gpu"></div>
      <div class="absolute bottom-[5%] right-[5%] w-[320px] sm:w-[480px] h-[320px] sm:h-[480px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-accent/15 via-primary/5 to-transparent rounded-full blur-[70px] -z-10 pointer-events-none transform-gpu"></div>

      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Copy -->
        <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-primary/25 bg-primary/10 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.15em] text-primary" data-i18n="tentang.hero.badge">
              {t(lang, "tentang.hero.badge")}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-black text-text-primary leading-[1.12] tracking-tight text-balance" data-i18n-html="tentang.hero.headline" set:html={t(lang, "tentang.hero.headline")} />

          <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-xl mx-auto lg:mx-0" data-i18n-html="tentang.hero.desc" set:html={t(lang, "tentang.hero.desc")} />

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
            <a href={getLocalizedPath("/contact", lang)} data-base-href="/contact" class="w-full sm:w-auto inline-flex justify-center items-center gap-2.5 bg-primary hover:bg-accent text-primary-foreground font-bold text-sm sm:text-base min-h-[52px] py-3.5 px-7 rounded-xl shadow-lg shadow-primary/20 transition-all duration-300 md:hover:scale-[1.03] active:scale-95">
              <span data-i18n="tentang.hero.cta1">{t(lang, "tentang.hero.cta1")}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href={getLocalizedPath("/layanan", lang)} data-base-href="/layanan" class="w-full sm:w-auto inline-flex justify-center items-center gap-2 border border-border/70 text-text-primary font-bold text-sm sm:text-base min-h-[52px] py-3.5 px-7 rounded-xl bg-surface hover:bg-surface-elevated transition-all duration-300 shadow-sm" data-i18n="tentang.hero.cta2">
              {t(lang, "tentang.hero.cta2")}
            </a>
          </div>
        </div>

        <!-- Right Visual: Studio Growth Philosophy Card -->
        <div class="lg:col-span-6">
          <div class="bg-surface-elevated border border-border/80 rounded-3xl p-6 sm:p-8 shadow-soft-lg space-y-6">
            <div class="flex items-center justify-between border-b border-border/60 pb-4">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
                <span class="ml-2 text-xs font-mono text-text-muted">galacode-mindset.ts</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-primary/10 text-primary border border-primary/20" data-i18n="tentang.hero.codeTag">{t(lang, "tentang.hero.codeTag")}</span>
            </div>

            <div class="bg-surface rounded-2xl p-5 font-mono text-xs text-text-secondary space-y-2 border border-border/60 overflow-x-auto">
              <div class="text-text-muted" data-i18n="tentang.hero.codeComment">{t(lang, "tentang.hero.codeComment")}</div>
              <div><span class="text-primary font-bold">const</span> websiteStrategy = &#123;</div>
              <div class="pl-4">goal: <span class="text-green-500" data-i18n="tentang.hero.codeGoal">{t(lang, "tentang.hero.codeGoal")}</span>,</div>
              <div class="pl-4">design: <span class="text-accent font-bold" data-i18n="tentang.hero.codeDesign">{t(lang, "tentang.hero.codeDesign")}</span>,</div>
              <div class="pl-4">experience: <span class="text-secondary font-bold" data-i18n="tentang.hero.codeExp">{t(lang, "tentang.hero.codeExp")}</span>,</div>
              <div class="pl-4">trackingReady: <span class="text-green-500">true</span></div>
              <div>&#125;;</div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="p-4 rounded-xl bg-background border border-border/60">
                <div class="text-[10px] font-bold uppercase tracking-wider text-text-muted" data-i18n="tentang.hero.stat1Label">{t(lang, "tentang.hero.stat1Label")}</div>
                <div class="text-sm font-extrabold text-text-primary mt-1" data-i18n="tentang.hero.stat1Val">{t(lang, "tentang.hero.stat1Val")}</div>
              </div>
              <div class="p-4 rounded-xl bg-background border border-border/60">
                <div class="text-[10px] font-bold uppercase tracking-wider text-text-muted" data-i18n="tentang.hero.stat2Label">{t(lang, "tentang.hero.stat2Label")}</div>
                <div class="text-sm font-extrabold text-text-primary mt-1" data-i18n="tentang.hero.stat2Val">{t(lang, "tentang.hero.stat2Val")}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: WHY PURPOSE MATTERS -->
    <section id="purpose" class="py-20 md:py-28 bg-surface border-t border-border/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

          <div class="lg:col-span-5 space-y-5">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-border bg-background text-[11px] font-bold uppercase tracking-wider text-primary" data-i18n="tentang.purpose.badge">
              {t(lang, "tentang.purpose.badge")}
            </span>
            <h2 class="text-3xl sm:text-4xl font-black text-text-primary leading-tight tracking-tight" data-i18n-html="tentang.purpose.headline" set:html={t(lang, "tentang.purpose.headline")} />
            <p class="text-base text-text-secondary leading-relaxed" data-i18n="tentang.purpose.p1">
              {t(lang, "tentang.purpose.p1")}
            </p>
            <p class="text-base text-text-secondary leading-relaxed" data-i18n="tentang.purpose.p2">
              {t(lang, "tentang.purpose.p2")}
            </p>
          </div>

          <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-sm">01</div>
              <h3 class="text-lg font-bold text-text-primary" data-i18n="tentang.purpose.1.title">{t(lang, "tentang.purpose.1.title")}</h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.purpose.1.desc">
                {t(lang, "tentang.purpose.1.desc")}
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-black text-sm">02</div>
              <h3 class="text-lg font-bold text-text-primary" data-i18n="tentang.purpose.2.title">{t(lang, "tentang.purpose.2.title")}</h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.purpose.2.desc">
                {t(lang, "tentang.purpose.2.desc")}
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center font-black text-sm">03</div>
              <h3 class="text-lg font-bold text-text-primary" data-i18n="tentang.purpose.3.title">{t(lang, "tentang.purpose.3.title")}</h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.purpose.3.desc">
                {t(lang, "tentang.purpose.3.desc")}
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-background border border-border/70 space-y-3">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-sm">04</div>
              <h3 class="text-lg font-bold text-text-primary" data-i18n="tentang.purpose.4.title">{t(lang, "tentang.purpose.4.title")}</h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.purpose.4.desc">
                {t(lang, "tentang.purpose.4.desc")}
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 3: VISION, MISSION & PRINCIPLES -->
    <section id="vision-mission" class="py-20 md:py-28 bg-background border-t border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <div class="lg:col-span-6 bg-surface-elevated border border-border/80 rounded-3xl p-8 sm:p-10 relative overflow-hidden shadow-soft">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary via-secondary to-accent"></div>
            <div class="space-y-5">
              <span class="inline-flex px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider" data-i18n="tentang.vision.badge">{t(lang, "tentang.vision.badge")}</span>
              <blockquote class="text-2xl sm:text-3xl font-black text-text-primary leading-snug" data-i18n="tentang.vision.quote">
                {t(lang, "tentang.vision.quote")}
              </blockquote>
            </div>
          </div>

          <div class="lg:col-span-6 space-y-4">
            <span class="inline-flex px-3 py-1 rounded-full bg-secondary/10 text-secondary text-xs font-bold uppercase tracking-wider" data-i18n="tentang.mission.badge">{t(lang, "tentang.mission.badge")}</span>
            <div class="space-y-3">
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface border border-border/60">
                <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-xs shrink-0">1</div>
                <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.mission.1">{t(lang, "tentang.mission.1")}</p>
              </div>
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface border border-border/60">
                <div class="w-7 h-7 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-bold text-xs shrink-0">2</div>
                <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.mission.2">{t(lang, "tentang.mission.2")}</p>
              </div>
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface border border-border/60">
                <div class="w-7 h-7 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center font-bold text-xs shrink-0">3</div>
                <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.mission.3">{t(lang, "tentang.mission.3")}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 4 Core Principles -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.principle.1.title">{t(lang, "tentang.principle.1.title")}</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed" data-i18n="tentang.principle.1.desc">{t(lang, "tentang.principle.1.desc")}</p>
          </div>
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.principle.2.title">{t(lang, "tentang.principle.2.title")}</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed" data-i18n="tentang.principle.2.desc">{t(lang, "tentang.principle.2.desc")}</p>
          </div>
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.principle.3.title">{t(lang, "tentang.principle.3.title")}</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed" data-i18n="tentang.principle.3.desc">{t(lang, "tentang.principle.3.desc")}</p>
          </div>
          <div class="bg-surface border border-border/70 rounded-2xl p-6 space-y-2">
            <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.principle.4.title">{t(lang, "tentang.principle.4.title")}</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed" data-i18n="tentang.principle.4.desc">{t(lang, "tentang.principle.4.desc")}</p>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 4: STATS -->
    <section id="stats" class="py-16 md:py-20 bg-surface border-t border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-border bg-background text-[11px] font-bold uppercase tracking-wider text-primary" data-i18n="tentang.stats.badge">
            {t(lang, "tentang.stats.badge")}
          </span>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
          {[1, 2, 3, 4].map((i) => (
            <div class="text-center p-6 rounded-2xl bg-background border border-border/70 space-y-1">
              <div class="text-3xl sm:text-4xl font-black text-primary" data-i18n={`tentang.stats.${i}.value`}>
                {t(lang, `tentang.stats.${i}.value` as any)}
              </div>
              <div class="text-sm font-bold text-text-primary" data-i18n={`tentang.stats.${i}.label`}>
                {t(lang, `tentang.stats.${i}.label` as any)}
              </div>
              <div class="text-xs text-text-muted" data-i18n={`tentang.stats.${i}.sub`}>
                {t(lang, `tentang.stats.${i}.sub` as any)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 5: LAYANAN OVERVIEW -->
    <section id="layanan-overview" class="py-20 md:py-28 bg-background border-t border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-14 space-y-4">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-border bg-background text-[11px] font-bold uppercase tracking-wider text-primary" data-i18n="tentang.services.badge">
            {t(lang, "tentang.services.badge")}
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-text-primary leading-tight tracking-tight" data-i18n-html="tentang.services.headline" set:html={t(lang, "tentang.services.headline")} />
          <p class="text-base text-text-secondary leading-relaxed" data-i18n="tentang.services.desc">
            {t(lang, "tentang.services.desc")}
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {/* Service Card 1 */}
          <div class="group relative bg-surface-elevated border border-border/80 rounded-2xl p-6 space-y-4 hover:border-primary/40 hover:shadow-soft transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.services.1.title">
                {t(lang, "tentang.services.1.title")}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.services.1.desc">
                {t(lang, "tentang.services.1.desc")}
              </p>
            </div>
            <div class="pt-2 border-t border-border/50">
              <span class="text-xs text-text-muted font-medium" data-i18n="tentang.services.1.example">
                {t(lang, "tentang.services.1.example")}
              </span>
            </div>
          </div>

          {/* Service Card 2 */}
          <div class="group relative bg-surface-elevated border border-border/80 rounded-2xl p-6 space-y-4 hover:border-accent/40 hover:shadow-soft transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.services.2.title">
                {t(lang, "tentang.services.2.title")}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.services.2.desc">
                {t(lang, "tentang.services.2.desc")}
              </p>
            </div>
            <div class="pt-2 border-t border-border/50">
              <span class="text-xs text-text-muted font-medium" data-i18n="tentang.services.2.example">
                {t(lang, "tentang.services.2.example")}
              </span>
            </div>
          </div>

          {/* Service Card 3 */}
          <div class="group relative bg-surface-elevated border border-border/80 rounded-2xl p-6 space-y-4 hover:border-secondary/40 hover:shadow-soft transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.services.3.title">
                {t(lang, "tentang.services.3.title")}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.services.3.desc">
                {t(lang, "tentang.services.3.desc")}
              </p>
            </div>
            <div class="pt-2 border-t border-border/50">
              <span class="text-xs text-text-muted font-medium" data-i18n="tentang.services.3.example">
                {t(lang, "tentang.services.3.example")}
              </span>
            </div>
          </div>

          {/* Service Card 4 */}
          <div class="group relative bg-surface-elevated border border-border/80 rounded-2xl p-6 space-y-4 hover:border-primary/40 hover:shadow-soft transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="text-base font-extrabold text-text-primary" data-i18n="tentang.services.4.title">
                {t(lang, "tentang.services.4.title")}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed" data-i18n="tentang.services.4.desc">
                {t(lang, "tentang.services.4.desc")}
              </p>
            </div>
            <div class="pt-2 border-t border-border/50">
              <span class="text-xs text-text-muted font-medium" data-i18n="tentang.services.4.example">
