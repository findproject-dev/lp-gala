---
// src/components/pricing/PricingFAQ.astro
import { ChevronDown } from 'lucide-astro';
import { t, type Locale, type TranslationKey } from '../../i18n';

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;

const faqs = Array.from({ length: 8 }, (_, idx) => ({
  qKey: `pricing.faq.${idx + 1}.q` as TranslationKey,
  aKey: `pricing.faq.${idx + 1}.a` as TranslationKey,
}));

const half = Math.ceil(faqs.length / 2);
const leftFaqs = faqs.slice(0, half);
const rightFaqs = faqs.slice(half);
---

<section class="relative w-full px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto pt-24 md:pt-32 pb-24">
  <div class="text-center mb-16 md:mb-20">
    <h2 class="text-3xl md:text-5xl font-bold text-text-primary tracking-tight mb-4" data-i18n="pricing.faq.title">{t(lang, "pricing.faq.title")}</h2>
    <p class="text-text-secondary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed" data-i18n-html="pricing.faq.subtitle" set:html={t(lang, "pricing.faq.subtitle")} />
  </div>

  <div id="pricing-faq-container" class="faq-container w-full grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-start">
    {/* Left Column */}
    <div class="space-y-6">
      {leftFaqs.map((faq) => (
        <div class="faq-card group bg-surface rounded-2xl border border-border shadow-sm hover:shadow-md hover:-translate-y-1 hover:border-glass-10 transition-all duration-300 ease-out overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-b from-white/40 dark:from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <button 
            type="button"
            aria-expanded="false"
            class="faq-trigger flex w-full items-start justify-between p-6 md:p-8 text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20 rounded-2xl z-10 relative"
          >
            <span class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors pr-8 leading-snug" data-i18n={faq.qKey}>{t(lang, faq.qKey)}</span>
            <div class="w-8 h-8 rounded-full bg-border/50 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-primary/20 transition-colors">
              <ChevronDown class="faq-icon h-5 w-5 text-text-primary group-hover:text-accent transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]" aria-hidden="true" />
            </div>
          </button>
          
          <div class="faq-content h-0 overflow-hidden opacity-0 relative z-10">
            <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-text-secondary leading-relaxed text-base" data-i18n={faq.aKey}>
               {t(lang, faq.aKey)}
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Right Column */}
    <div class="space-y-6">
      {rightFaqs.map((faq) => (
        <div class="faq-card group bg-surface rounded-2xl border border-border shadow-sm hover:shadow-md hover:-translate-y-1 hover:border-glass-10 transition-all duration-300 ease-out overflow-hidden relative">
          <div class="absolute inset-0 bg-gradient-to-b from-white/40 dark:from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <button 
            type="button"
            aria-expanded="false"
            class="faq-trigger flex w-full items-start justify-between p-6 md:p-8 text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20 rounded-2xl z-10 relative"
          >
            <span class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors pr-8 leading-snug" data-i18n={faq.qKey}>{t(lang, faq.qKey)}</span>
            <div class="w-8 h-8 rounded-full bg-border/50 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-primary/20 transition-colors">
              <ChevronDown class="faq-icon h-5 w-5 text-text-primary group-hover:text-accent transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]" aria-hidden="true" />
            </div>
          </button>
          
          <div class="faq-content h-0 overflow-hidden opacity-0 relative z-10">
            <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-text-secondary leading-relaxed text-base" data-i18n={faq.aKey}>
               {t(lang, faq.aKey)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    import { animate, inView, stagger } from "motion";

    document.addEventListener("DOMContentLoaded", () => {
      const cards = document.querySelectorAll(".faq-card");
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && cards.length > 0) {
        cards.forEach(card => {
          (card as HTMLElement).style.opacity = '0';
          (card as HTMLElement).style.transform = 'translateY(20px)';
        });
        
        inView("#pricing-faq-container", () => {
          animate(
            ".faq-card", 
            { opacity: [0, 1], y: [20, 0] }, 
            { duration: 0.6, delay: stagger(0.1), easing: "ease-out" }
          );
        }, { margin: "-10% 0px" });
      } else {
        cards.forEach(card => {
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.transform = 'none';
        });
      }

      cards.forEach(card => {
        const trigger = card.querySelector(".faq-trigger");
        const content = card.querySelector(".faq-content");
        const icon = card.querySelector(".faq-icon") as HTMLElement | null;
        let isOpen = false;

        const toggleAccordion = () => {
          if (!isOpen) {
            isOpen = true;
            trigger?.setAttribute("aria-expanded", "true");
            card.classList.add("shadow-md");
            card.classList.remove("shadow-sm");
            
            if (icon && !prefersReducedMotion) icon.style.transform = "rotate(180deg)";
            
            if (content) {
              (content as HTMLElement).style.height = "auto";
              const targetHeight = (content as HTMLElement).offsetHeight;
              (content as HTMLElement).style.height = "0px";
              
              if (!prefersReducedMotion) {
                animate(
                  content, 
                  { height: ["0px", `${targetHeight}px`], opacity: [0, 1] }, 
                  { duration: 0.4, easing: [0.22, 1, 0.36, 1] }
                ).finished.then(() => { (content as HTMLElement).style.height = "auto"; });
              } else {
                (content as HTMLElement).style.height = "auto";
                (content as HTMLElement).style.opacity = "1";
              }
            }
          } else {
            isOpen = false;
            trigger?.setAttribute("aria-expanded", "false");
            card.classList.remove("shadow-md");
            card.classList.add("shadow-sm");
            
            if (icon && !prefersReducedMotion) icon.style.transform = "rotate(0deg)";
            
            if (content) {
              const currentHeight = (content as HTMLElement).offsetHeight;
              (content as HTMLElement).style.height = `${currentHeight}px`;
              
              if (!prefersReducedMotion) {
                animate(
                  content, 
                  { height: [`${currentHeight}px`, "0px"], opacity: [1, 0] }, 
                  { duration: 0.3, easing: [0.22, 1, 0.36, 1] }
                );
              } else {
                (content as HTMLElement).style.height = "0px";
                (content as HTMLElement).style.opacity = "0";
              }
            }
          }
        };

        trigger?.addEventListener("click", toggleAccordion);
      });
    });
  </script>
</section>
