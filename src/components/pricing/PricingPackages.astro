---

<section class="relative w-full px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col items-center">
  <!-- Category Segmented Tabs -->
  <div class="mb-12 md:mb-16 flex justify-center w-full">
    <div role="tablist" aria-label="Kategori Layanan Harga" class="inline-flex flex-wrap sm:flex-nowrap items-center justify-center gap-1.5 p-1.5 rounded-2xl sm:rounded-full bg-surface-elevated border border-border/80 shadow-sm">
      <button
        type="button"
        role="tab"
        id="tab-website"
        aria-selected="true"
        aria-controls="panel-website"
        data-tab="website"
        data-i18n="pricing.tabs.website"
        class="pricing-tab-btn px-5 sm:px-7 py-2.5 sm:py-3 rounded-xl sm:rounded-full text-sm font-semibold transition-all duration-300 bg-primary text-primary-foreground shadow-sm cursor-pointer"
      >
        {t(lang, "pricing.tabs.website")}
      </button>
      <button
        type="button"
        role="tab"
        id="tab-redesign"
        aria-selected="false"
        aria-controls="panel-redesign"
        data-tab="redesign"
        data-i18n="pricing.tabs.redesign"
        class="pricing-tab-btn px-5 sm:px-7 py-2.5 sm:py-3 rounded-xl sm:rounded-full text-sm font-semibold transition-all duration-300 text-text-secondary hover:text-text-primary hover:bg-surface/80 cursor-pointer"
      >
        {t(lang, "pricing.tabs.redesign")}
      </button>
    </div>
  </div>

  <!-- Panel 1: Pembuatan Website (Default Active) -->
  <div id="panel-website" role="tabpanel" aria-labelledby="tab-website" class="pricing-tab-panel w-full flex flex-col items-center">
    <div id="pricing-packages-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch pricing-grid relative z-10 w-full">
      {packageConfigs.map(config => (
        <PricingCard lang={lang} {...config} />
      ))}
    </div>

    <div class="mt-12 text-center text-[13px] text-text-muted max-w-2xl mx-auto space-y-2">
      <p data-i18n="pricing.website.note1">{t(lang, "pricing.website.note1")}</p>
      <p data-i18n="pricing.website.note2">{t(lang, "pricing.website.note2")}</p>
    </div>
  </div>

  <!-- Panel 2: Redesign & Rebuild Website -->
  <div id="panel-redesign" role="tabpanel" aria-labelledby="tab-redesign" class="pricing-tab-panel hidden w-full flex-col items-center">
    <div id="redesign-packages-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch pricing-grid relative z-10 w-full">
      {redesignConfigs.map(config => (
        <PricingCard lang={lang} {...config} />
      ))}
    </div>

    <div class="mt-12 text-center text-[13px] text-text-muted max-w-2xl mx-auto space-y-2">
      <p data-i18n="pricing.redesign.note1">{t(lang, "pricing.redesign.note1")}</p>
    </div>
  </div>

  {packageConfigs.map(config => (
    <PricingModal lang={lang} {...config} />
  ))}

  {redesignConfigs.map(config => (
    <PricingModal lang={lang} {...config} />
  ))}

  <script>
    import { animate, stagger, hover, inView } from "motion";

    document.addEventListener("DOMContentLoaded", () => {
      const websiteCards = document.querySelectorAll("#panel-website .pricing-card");
      const allCards = document.querySelectorAll(".pricing-card");
      const section = document.querySelector("#pricing-packages-grid") as HTMLElement;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && section) {
        websiteCards.forEach(c => {
          (c as HTMLElement).style.opacity = '0';
          (c as HTMLElement).style.transform = 'translateY(40px)';
        });
        
        inView(section, () => {
          animate(
            websiteCards,
            { opacity: [0, 1], y: [40, 0] },
            { delay: stagger(0.1), duration: 0.6, easing: "ease-out" }
          );
        }, { margin: "-10% 0px" });
      } else {
        websiteCards.forEach(c => { (c as HTMLElement).style.opacity = '1'; (c as HTMLElement).style.transform = 'none'; });
      }

      allCards.forEach((card, index) => {
        if (!prefersReducedMotion) {
          hover(card, (element) => {
            const rotateAmt = index % 2 === 0 ? 0.5 : -0.5;
            animate(element, { y: -8, rotate: rotateAmt }, { duration: 0.3, easing: [0.22, 1, 0.36, 1] });
            return () => {
              animate(element, { y: 0, rotate: 0 }, { duration: 0.5, easing: [0.22, 1, 0.36, 1] });
            };
          });
        }
      });

      const tabBtns = document.querySelectorAll(".pricing-tab-btn");
      const panelWebsite = document.getElementById("panel-website");
      const panelRedesign = document.getElementById("panel-redesign");
      const comparisonSection = document.getElementById("pricing-comparison");

      const activeBtnClasses = ["bg-primary", "text-primary-foreground", "shadow-sm"];
      const inactiveBtnClasses = ["text-text-secondary", "hover:text-text-primary", "hover:bg-surface/80"];

      tabBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const targetTab = btn.getAttribute("data-tab");
          if (!targetTab) return;

          const isAlreadyActive = btn.getAttribute("aria-selected") === "true";
          if (isAlreadyActive) return;

          tabBtns.forEach(b => {
            const isTarget = b === btn;
            b.setAttribute("aria-selected", isTarget ? "true" : "false");
            if (isTarget) {
              b.classList.remove(...inactiveBtnClasses);
              b.classList.add(...activeBtnClasses);
            } else {
              b.classList.remove(...activeBtnClasses);
              b.classList.add(...inactiveBtnClasses);
            }
          });

          const showPanel = targetTab === "website" ? panelWebsite : panelRedesign;
          const hidePanel = targetTab === "website" ? panelRedesign : panelWebsite;

          if (hidePanel) {
            hidePanel.classList.add("hidden");
            hidePanel.classList.remove("flex");
          }
          if (showPanel) {
            showPanel.classList.remove("hidden");
            showPanel.classList.add("flex");

            if (!prefersReducedMotion) {
              const targetCards = showPanel.querySelectorAll(".pricing-card");
              targetCards.forEach(c => {
                (c as HTMLElement).style.opacity = '0';
                (c as HTMLElement).style.transform = 'translateY(20px)';
              });
              animate(
                targetCards,
                { opacity: [0, 1], y: [20, 0] },
                { delay: stagger(0.06), duration: 0.45, easing: "ease-out" }
              );
            }
          }

          if (comparisonSection) {
            if (targetTab === "website") {
              comparisonSection.classList.remove("hidden");
            } else {
              comparisonSection.classList.add("hidden");
            }
          }
        });
      });

      const openModalBtns = document.querySelectorAll('.open-modal-btn');
      const closeBtns = document.querySelectorAll('.close-modal');
      const modals = document.querySelectorAll('dialog.pricing-modal');

      openModalBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-modal-target');
          if (!targetId) return;
          const modal = document.getElementById(targetId) as HTMLDialogElement;
          if (modal) {
            modal.showModal();
            document.body.style.overflow = 'hidden';
          }
        });
      });

      const closeModal = (modal: HTMLDialogElement) => {
        modal.classList.add('closing');
        setTimeout(() => {
          modal.close();
          modal.classList.remove('closing');
          document.body.style.overflow = '';
        }, 200);
      };

      closeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const modal = btn.closest('dialog');
          if (modal) closeModal(modal);
        });
      });

      modals.forEach(modal => {
        const dialog = modal as HTMLDialogElement;
        dialog.addEventListener('click', (e) => {
          const dialogDimensions = dialog.getBoundingClientRect();
          if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
          ) {
            closeModal(dialog);
          }
        });
        
        dialog.addEventListener('cancel', (e) => {
          e.preventDefault();
          closeModal(dialog);
        });
      });
    });
  </script>
</section>
