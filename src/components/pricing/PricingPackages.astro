<section class="relative w-full px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col items-center">
  <div id="pricing-packages-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch pricing-grid relative z-10 w-full">
    {packageConfigs.map(config => (
      <PricingCard {...config} />
    ))}
  </div>

  <div class="mt-12 text-center text-[13px] text-text-muted max-w-2xl mx-auto space-y-2">
    <p>* Integrasi payment gateway, domain, email service, dan layanan pihak ketiga lainnya tersedia. Biaya layanan pihak ketiga ditanggung oleh client.</p>
    <p>** Domain .com gratis untuk tahun pertama. Perpanjangan domain pada tahun berikutnya mengikuti biaya renewal.</p>
  </div>

  {packageConfigs.map(config => (
    <PricingModal {...config} />
  ))}

  <script>
    import { animate, stagger, hover, inView } from "motion";

    document.addEventListener("DOMContentLoaded", () => {
      const cards = document.querySelectorAll(".pricing-card");
      const section = document.querySelector("#pricing-packages-grid") as HTMLElement;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Entry Animation
      if (!prefersReducedMotion) {
        cards.forEach(c => {
          (c as HTMLElement).style.opacity = '0';
          (c as HTMLElement).style.transform = 'translateY(40px)';
        });
        
        inView(section, () => {
          animate(
            cards,
            { opacity: [0, 1], y: [40, 0] },
            { delay: stagger(0.1), duration: 0.6, easing: "ease-out" }
          );
        }, { margin: "-10% 0px" });
      } else {
        cards.forEach(c => { (c as HTMLElement).style.opacity = '1'; (c as HTMLElement).style.transform = 'none'; });
      }

      // Hover Interaction
      cards.forEach((card, index) => {
        if (!prefersReducedMotion) {
          hover(card, (element) => {
            const rotateAmt = index % 2 === 0 ? 0.5 : -0.5;
            animate(element, { y: -8, rotate: rotateAmt }, { duration: 0.3, easing: [0.22, 1, 0.36, 1] });
            return () => {
              animate(element, { y: 0, rotate: 0 }, { duration: 0.5, easing: [0.22, 1, 0.36, 1] });
            };
          });
        }
      });

      // Modal Logic
      const openModalBtns = document.querySelectorAll('.open-modal-btn');
      const closeBtns = document.querySelectorAll('.close-modal');
      const modals = document.querySelectorAll('dialog.pricing-modal');

      openModalBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-modal-target');
          if (!targetId) return;
          const modal = document.getElementById(targetId) as HTMLDialogElement;
          if (modal) {
            modal.showModal();
            document.body.style.overflow = 'hidden'; // Prevent background scrolling
          }
        });
      });

      const closeModal = (modal: HTMLDialogElement) => {
        modal.classList.add('closing');
        setTimeout(() => {
          modal.close();
          modal.classList.remove('closing');
          document.body.style.overflow = '';
        }, 200); // Wait for animation
      };

      closeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const modal = btn.closest('dialog');
          if (modal) closeModal(modal);
        });
      });

      // Click outside to close
      modals.forEach(modal => {
        const dialog = modal as HTMLDialogElement;
        dialog.addEventListener('click', (e) => {
          const dialogDimensions = dialog.getBoundingClientRect();
          if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
          ) {
            closeModal(dialog);
          }
        });
        
        // Handle ESC key animation properly (native close bypasses animation, so we intercept)
        dialog.addEventListener('cancel', (e) => {
          e.preventDefault();
          closeModal(dialog);
        });
      });
    });
  </script>
</section>
