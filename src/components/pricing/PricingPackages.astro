interface PackageConfig {
  id: string;
  nameKey: TranslationKey;
  priceKey: TranslationKey;
  isBestSeller?: boolean;
  taglineKey: TranslationKey;
  descriptionKey: TranslationKey;
  buttonTextKey: TranslationKey;
  cardClasses: string;
  shadowClass: string;
  ringClass: string;
  iconWrapperClass: string;
  iconClass: string;
  nameClass?: string;
  priceClass?: string;
  buttonClass: string;
  accentText: string;
  featureGroups: FeatureGroup[];
  revisionKey: TranslationKey;
  deliveryKey: TranslationKey;
  whatsappKey: TranslationKey;
}

function makeGroups(id: string, counts: number[]): FeatureGroup[] {
  return counts.map((count, gIdx) => ({
    groupKey: `pkg.${id}.g${gIdx}` as TranslationKey,
    itemKeys: Array.from({ length: count }, (_, fIdx) => `pkg.${id}.g${gIdx}.f${fIdx}` as TranslationKey),
  }));
}

