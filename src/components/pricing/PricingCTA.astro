---
// src/components/pricing/PricingCTA.astro
---

<section id="pricing-cta-section" class="relative w-full px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto py-16 md:py-24">
  <div class="cta-box relative rounded-[2rem] md:rounded-[3rem] bg-surface-elevated border border-border overflow-hidden shadow-sm hover:shadow-md transition-all duration-500 text-center flex flex-col items-center p-8 md:p-14 lg:p-16">
    
    <!-- Subtle Galaxy Gradient Accent -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-full max-w-2xl bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary/15 via-accent/10 to-transparent blur-[32px] rounded-full pointer-events-none z-0 transform-gpu"></div>

    <div class="relative z-10 w-full max-w-3xl mx-auto flex flex-col items-center">
      
      <!-- Headline -->
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-text-primary tracking-tight text-balance mb-3 md:mb-4">
        Masih Bingung Memilih Paket?
      </h2>
      
      <!-- Short description -->
      <p class="text-base md:text-lg text-text-secondary text-balance max-w-2xl mb-8 md:mb-10 leading-relaxed">
        Setiap bisnis memiliki kebutuhan yang berbeda. Mari diskusikan fitur apa saja yang benar-benar Anda perlukan sebelum mengambil keputusan.
      </p>
      
      <!-- 3 Small Trust Points (Horizontal on Desktop, Stacked on Mobile) -->
      <div class="flex flex-col md:flex-row justify-center items-center gap-4 md:gap-8 w-full mb-10 md:mb-12">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="text-sm md:text-base text-text-primary font-medium">Konsultasi Gratis</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="text-sm md:text-base text-text-primary font-medium">Tanpa Komitmen</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="text-sm md:text-base text-text-primary font-medium">Solusi Sesuai Kebutuhan Bisnis</span>
        </div>
      </div>
      
      <!-- One Primary CTA Button -->
      <a href="/contact" class="w-full sm:w-auto inline-flex justify-center items-center gap-3 bg-primary hover:bg-secondary text-primary-foreground font-bold py-4 px-10 rounded-xl min-h-[56px] shadow-sm transition-all duration-300 md:hover:scale-105 md:hover:shadow-md active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary group">
        <span>Konsultasi Gratis</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 md:group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      
    </div>
  </div>

  <script>
    import { animate, inView } from "motion";

    document.addEventListener("DOMContentLoaded", () => {
      const section = document.querySelector("#pricing-cta-section") as HTMLElement;
      const ctaBox = document.querySelector(".cta-box") as HTMLElement;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && ctaBox) {
        ctaBox.style.opacity = '0';
        ctaBox.style.transform = 'translateY(20px)';
        
        inView(section || ctaBox, () => {
          animate(ctaBox, { opacity: [0, 1], y: [20, 0] }, { duration: 0.7, easing: "ease-out" });
        }, { margin: "-10% 0px" });
      }
    });
  </script>
</section>
