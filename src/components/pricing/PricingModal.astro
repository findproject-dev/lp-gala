---
// src/components/pricing/PricingModal.astro
import { Zap, Rocket, TrendingUp, ShoppingCart, Building2, Briefcase, Paintbrush, Sparkles, Layers, Wrench, Check, Clock, RefreshCcw, X } from 'lucide-astro';
import { t, type Locale, type TranslationKey } from '../../i18n';
import type { FeatureGroup } from './PricingCard.astro';

export interface Props {
  lang?: Locale;
  id: string;
  nameKey: TranslationKey;
  isBestSeller?: boolean;
  priceKey: TranslationKey;
  taglineKey?: TranslationKey;
  descriptionKey: TranslationKey;
  buttonTextKey: TranslationKey;
  
  featureGroups: FeatureGroup[];
  revisionKey: TranslationKey;
  deliveryKey: TranslationKey;
  whatsappKey: TranslationKey;
  
  iconWrapperClass: string;
  iconClass: string;
  nameClass?: string;
  priceClass?: string;
  buttonClass: string;
  accentText?: string;
}

const { 
  lang = "id",
  id, 
  nameKey, 
  isBestSeller = false,
  priceKey, 
  taglineKey,
  descriptionKey,
  buttonTextKey,
  featureGroups,
  revisionKey,
  deliveryKey,
  whatsappKey,
  iconWrapperClass,
  iconClass,
  nameClass = "text-text-primary",
  priceClass = "text-text-primary",
  buttonClass,
  accentText = "text-text-secondary"
} = Astro.props;

const icons = {
  spark: Zap,
  starter: Rocket,
  growth: TrendingUp,
  scale: ShoppingCart,
  enterprise: Building2,
  custom: Briefcase,
  "minor-refresh": Paintbrush,
  "landing-refresh": Sparkles,
  "visual-refresh": Layers,
  "website-rebuild": RefreshCcw,
  "system-rebuild": Wrench
};

const Icon = icons[id as keyof typeof icons] || Zap;
---

<dialog id={`modal-${id}`} class="pricing-modal group fixed inset-0 z-50 bg-transparent m-0 h-[100dvh] max-h-[100dvh] w-screen max-w-[100vw] items-center justify-center p-4 sm:p-6 backdrop:bg-black/40 backdrop:backdrop-blur-sm hidden open:flex">
  
  <div class="modal-content relative flex w-full max-w-2xl flex-col overflow-hidden rounded-[2rem] bg-surface shadow-2xl transition-all max-h-[90dvh]">
    
    {/* Close Button */}
    <button type="button" class="close-modal absolute right-4 top-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-glass-10 text-text-muted hover:bg-glass-20 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/20">
      <X class="w-5 h-5" />
      <span class="sr-only" data-i18n="pricing.modal.closeAria">{t(lang, "pricing.modal.closeAria")}</span>
    </button>

    <div class="flex-grow overflow-y-auto px-5 py-6 sm:px-8 sm:py-6 no-scrollbar">
      {/* Header */}
      <div class="flex items-start gap-4 sm:gap-5">
        <div class={`w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex-shrink-0 flex items-center justify-center border ${iconWrapperClass}`}>
          <Icon class={`w-6 h-6 sm:w-7 sm:h-7 ${iconClass}`} aria-hidden="true" />
        </div>
        <div>
          <div class="flex items-center gap-3">
            <h3 class={`text-xl sm:text-2xl font-bold ${nameClass}`} data-i18n={nameKey}>{t(lang, nameKey)}</h3>
            {isBestSeller && (
              <span class="rounded-full bg-primary/20 px-2.5 py-1 text-[10px] sm:text-xs font-bold text-accent uppercase tracking-wide" data-i18n="pricing.card.bestSeller">
                {t(lang, "pricing.card.bestSeller")}
              </span>
            )}
          </div>
          {taglineKey && <p class={`text-xs sm:text-sm font-semibold mt-1 ${accentText}`} data-i18n={taglineKey}>{t(lang, taglineKey)}</p>}
          <div class={`text-2xl sm:text-3xl font-extrabold tracking-tight mt-2 ${priceClass}`} data-i18n={priceKey}>{t(lang, priceKey)}</div>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed mt-2" data-i18n={descriptionKey}>{t(lang, descriptionKey)}</p>
        </div>
      </div>

      <hr class="border-glass-10 my-6" />

      {/* Features */}
      <div class="space-y-6">
        {featureGroups.map((group) => (
          <div class="space-y-3">
            <h5 class="text-[13px] font-bold text-text-secondary uppercase tracking-wider" data-i18n={group.groupKey}>{t(lang, group.groupKey)}</h5>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-x-6 sm:gap-y-3">
              {group.itemKeys.map((featKey) => (
                <li class="flex items-start gap-2.5">
                  <Check class={`w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 ${accentText} mt-0.5 sm:mt-0`} />
                  <span class="text-text-secondary text-[13px] sm:text-sm leading-relaxed" data-i18n={featKey}>{t(lang, featKey)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <hr class="border-glass-10 my-6" />

      {/* Logistics */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="flex items-start gap-3 sm:gap-4">
          <RefreshCcw class={`w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 mt-0.5 ${accentText}`} />
          <div>
            <p class="text-[11px] sm:text-xs text-text-muted font-medium uppercase tracking-wider" data-i18n="pricing.modal.revisionLabel">{t(lang, "pricing.modal.revisionLabel")}</p>
            <p class="font-semibold text-text-primary text-[13px] sm:text-sm" data-i18n={revisionKey}>{t(lang, revisionKey)}</p>
          </div>
        </div>

        <div class="flex items-start gap-3 sm:gap-4">
          <Clock class={`w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 mt-0.5 ${accentText}`} />
          <div>
            <p class="text-[11px] sm:text-xs text-text-muted font-medium uppercase tracking-wider" data-i18n="pricing.modal.deliveryLabel">{t(lang, "pricing.modal.deliveryLabel")}</p>
            <p class="font-semibold text-text-primary text-[13px] sm:text-sm" data-i18n={deliveryKey}>{t(lang, deliveryKey)}</p>
          </div>
        </div>
      </div>
    </div>

    {/* Sticky Footer CTA */}
    <div class="border-t border-glass-10 bg-surface/90 p-5 sm:px-8 backdrop-blur-md">
      <a 
        href={`https://wa.me/6281919564548?text=${encodeURIComponent(t(lang, whatsappKey))}`}
        data-i18n-wa={whatsappKey}
        target="_blank"
        rel="noopener noreferrer"
        class={`flex w-full items-center justify-center rounded-2xl py-3.5 text-sm font-semibold transition-all hover:scale-[1.02] shadow-sm ${buttonClass}`}
        data-i18n={buttonTextKey}
      >
        {t(lang, buttonTextKey)}
      </a>
    </div>

  </div>
</dialog>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  dialog[open] {
    animation: fade-in 0.3s ease-out normal forwards;
  }
  
  dialog[open] .modal-content {
    animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) normal forwards;
  }

  dialog.closing {
    animation: fade-out 0.2s ease-in normal forwards;
  }
  
  dialog.closing .modal-content {
    animation: slide-down 0.2s ease-in normal forwards;
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes slide-down {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to { opacity: 0; transform: translateY(10px) scale(0.98); }
  }
</style>
