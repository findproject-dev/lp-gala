---
// src/components/pricing/PricingComparison.astro
import { Minus } from 'lucide-astro';
import { t, type Locale, type TranslationKey } from '../../i18n';

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;

const plans = [
  { id: 'spark', name: 'Spark', highlight: false },
  { id: 'starter', name: 'Starter', highlight: true },
  { id: 'growth', name: 'Growth', highlight: false },
  { id: 'scale', name: 'Scale', highlight: false },
  { id: 'enterprise', name: 'Enterprise', highlight: false },
  { id: 'custom', name: 'Custom', highlight: false }
] as const;

type PlanId = (typeof plans)[number]['id'];

const comparisonData: { rowKey: TranslationKey; values: Record<PlanId, TranslationKey | '-'> }[] = [
  {
    rowKey: 'pricing.comp.row.price',
    values: {
      spark: 'pkg.spark.price',
      starter: 'pkg.starter.price',
      growth: 'pkg.growth.price',
      scale: 'pkg.scale.price',
      enterprise: 'pkg.enterprise.price',
      custom: 'pkg.custom.price'
    }
  },
  {
    rowKey: 'pricing.comp.row.suitable',
    values: {
      spark: 'pricing.comp.suitable.spark',
      starter: 'pricing.comp.suitable.starter',
      growth: 'pricing.comp.suitable.growth',
      scale: 'pricing.comp.suitable.scale',
      enterprise: 'pricing.comp.suitable.enterprise',
      custom: 'pricing.comp.suitable.custom'
    }
  },
  {
    rowKey: 'pricing.comp.row.pages',
    values: {
      spark: 'pricing.comp.pages.spark',
      starter: 'pricing.comp.pages.starter',
      growth: 'pricing.comp.pages.growth',
      scale: 'pricing.comp.pages.scale',
      enterprise: 'pricing.comp.pages.enterprise',
      custom: 'pricing.comp.pages.custom'
    }
  },
  {
    rowKey: 'pricing.comp.row.sections',
    values: {
      spark: 'pricing.comp.sections.spark',
      starter: 'pricing.comp.sections.starter',
      growth: '-',
      scale: '-',
      enterprise: '-',
      custom: '-'
    }
  },
  {
    rowKey: 'pricing.comp.row.design',
    values: {
      spark: 'pricing.comp.design.spark',
      starter: 'pricing.comp.design.starter',
      growth: 'pricing.comp.design.growth',
      scale: 'pricing.comp.design.scale',
      enterprise: 'pricing.comp.design.enterprise',
      custom: 'pricing.comp.design.custom'
    }
  },
  {
    rowKey: 'pricing.comp.row.features',
    values: {
      spark: 'pricing.comp.features.spark',
      starter: 'pricing.comp.features.starter',
      growth: 'pricing.comp.features.growth',
      scale: 'pricing.comp.features.scale',
      enterprise: 'pricing.comp.features.enterprise',
      custom: 'pricing.comp.features.custom'
    }
  },
  {
    rowKey: 'pricing.comp.row.seo',
    values: {
      spark: 'pricing.comp.seo.basic',
      starter: 'pricing.comp.seo.basic',
      growth: 'pricing.comp.seo.basic',
      scale: 'pricing.comp.seo.basic',
      enterprise: 'pricing.comp.seo.basic',
      custom: 'pricing.comp.seo.custom'
    }
  },
  {
    rowKey: 'pricing.comp.row.revision',
    values: {
      spark: 'pkg.spark.rev',
      starter: 'pkg.starter.rev',
      growth: 'pkg.growth.rev',
      scale: 'pkg.scale.rev',
      enterprise: 'pkg.enterprise.rev',
      custom: 'pkg.custom.rev'
    }
  },
  {
    rowKey: 'pricing.comp.row.delivery',
    values: {
      spark: 'pkg.spark.del',
      starter: 'pkg.starter.del',
      growth: 'pkg.growth.del',
      scale: 'pkg.scale.del',
      enterprise: 'pricing.comp.del.enterprise',
      custom: 'pricing.comp.del.custom'
    }
  }
];
---

<section id="pricing-comparison" class="relative w-full px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto pt-12 md:pt-20">
  <div class="text-center mb-16 max-w-3xl mx-auto">
    <h2 class="text-3xl md:text-5xl font-bold text-text-primary tracking-tight" data-i18n="pricing.comp.title">
      {t(lang, "pricing.comp.title")}
    </h2>
    <p class="mt-6 text-text-secondary text-lg" data-i18n="pricing.comp.subtitle">
      {t(lang, "pricing.comp.subtitle")}
    </p>
  </div>

  <!-- Desktop View (lg and up): Full Comparison Table -->
  <div class="hidden lg:block relative border border-border bg-surface-elevated rounded-[2.5rem] shadow-sm comparison-desktop">
    <div class="overflow-x-auto rounded-[2.5rem] custom-scrollbar">
      <table class="w-full text-left border-collapse min-w-[1000px]">
        <caption class="sr-only" data-i18n="pricing.comp.title">{t(lang, "pricing.comp.title")}</caption>
        <thead class="sticky top-0 z-30 bg-surface/95 backdrop-blur-md shadow-sm border-b border-glass-10">
          <tr>
            <th class="p-8 font-semibold text-text-primary w-1/5 text-lg" data-i18n="pricing.comp.summary">{t(lang, "pricing.comp.summary")}</th>
            {plans.map(plan => (
              <th class={`p-8 text-center relative ${plan.highlight ? 'bg-accent/[0.03] border-b-2 border-accent' : ''}`}>
                {plan.highlight && (
                  <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent px-4 py-1 text-[10px] font-bold text-accent-foreground uppercase tracking-widest shadow-md" data-i18n="pricing.card.bestSeller">
                    {t(lang, "pricing.card.bestSeller")}
                  </div>
                )}
                <div class={`text-xl font-bold ${plan.highlight ? 'text-accent' : 'text-text-primary'}`}>
                  {plan.name}
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {comparisonData.map((row, idx) => (
            <tr class={`group transition-colors duration-300 hover:bg-primary/[0.04] ${idx !== comparisonData.length - 1 ? 'border-b border-glass-10' : ''}`}>
              
              <!-- Row Header -->
              <td class="p-6 pl-8 font-medium text-text-secondary transition-colors sticky left-0 z-20 bg-surface-elevated group-hover:bg-primary/[0.02]" data-i18n={row.rowKey}>
                {t(lang, row.rowKey)}
              </td>
              
              <!-- Values -->
              {plans.map(plan => {
                const valKey = row.values[plan.id];
                
                return (
                  <td class={`p-6 text-center text-sm transition-colors relative ${plan.highlight ? 'bg-accent/[0.02] group-hover:bg-accent/[0.04]' : ''}`}>
                    {plan.highlight && (
                       <div class="absolute inset-y-0 left-0 w-px bg-primary/20"></div>
                    )}
                    {plan.highlight && (
                       <div class="absolute inset-y-0 right-0 w-px bg-primary/20"></div>
                    )}
                    
                    <div class={`inline-flex items-center gap-1.5 justify-center ${plan.highlight ? 'font-semibold text-text-primary' : 'text-text-primary/75'}`}>
                      {valKey === '-' ? (
                        <Minus class="w-4 h-4 text-text-muted" />
                      ) : (
                        <span data-i18n={valKey}>{t(lang, valKey)}</span>
                      )}
                    </div>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile/Tablet View (< lg): Stacked Cards -->
  <div class="block lg:hidden space-y-8 comparison-mobile">
    {plans.map(plan => (
      <div class={`comparison-card relative rounded-3xl border ${plan.highlight ? 'border-accent bg-surface shadow-xl' : 'border-glass-10 bg-surface/50'} p-6 sm:p-8 overflow-hidden`}>
        {plan.highlight && (
          <div class="absolute top-0 right-0 bg-accent text-accent-foreground px-4 py-1.5 rounded-bl-2xl text-xs font-bold uppercase tracking-wider shadow-sm" data-i18n="pricing.card.bestSeller">
            {t(lang, "pricing.card.bestSeller")}
          </div>
        )}
        <div class="mb-8">
          <h3 class={`text-2xl font-bold ${plan.highlight ? 'text-accent' : 'text-text-primary'}`}>{plan.name}</h3>
        </div>
        
        <div class="space-y-4">
          {comparisonData.map(row => {
            const valKey = row.values[plan.id];
            
            return (
              <div class="flex justify-between items-center py-4 border-b border-glass-10 last:border-0 last:pb-0">
                <span class="text-text-muted text-sm" data-i18n={row.rowKey}>{t(lang, row.rowKey)}</span>
                <div class="flex items-center gap-1.5 text-right max-w-[60%]">
                  {valKey === '-' ? (
                    <Minus class="w-4 h-4 text-text-muted flex-shrink-0" />
                  ) : (
                    <span class={`text-sm ${plan.highlight ? 'font-semibold text-text-primary' : 'font-medium text-text-secondary'}`} data-i18n={valKey}>
                      {t(lang, valKey)}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

</section>

<script>
  import { animate, stagger, inView } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    const tableWrapper = document.querySelector(".comparison-desktop") as HTMLElement;
    const mobileCards = document.querySelectorAll(".comparison-card");
    const section = document.querySelector("#pricing-comparison") as HTMLElement;
    
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion && section) {
      if (tableWrapper) {
         tableWrapper.style.opacity = '0';
         tableWrapper.style.transform = 'translateY(30px)';
      }
      mobileCards.forEach(c => {
         (c as HTMLElement).style.opacity = '0';
         (c as HTMLElement).style.transform = 'translateY(20px)';
      });

      inView(section, () => {
        if (tableWrapper) {
           animate(tableWrapper, { opacity: [0, 1], y: [30, 0] }, { duration: 0.8, easing: "ease-out" });
        }
        if (mobileCards.length) {
           animate(
             mobileCards, 
             { opacity: [0, 1], y: [20, 0] }, 
             { delay: stagger(0.1), duration: 0.6, easing: "ease-out" }
           );
        }
      }, { margin: "-10% 0px" });
    }
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #C0C6CC;
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #A0A6AC;
  }
</style>
