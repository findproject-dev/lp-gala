---
// src/components/pricing/PricingIncluded.astro
import { Globe, Lock, Smartphone, Zap, MessageCircle } from 'lucide-astro';
import { t, type Locale, type TranslationKey } from '../../i18n';

interface Props {
  lang?: Locale;
}

const { lang = "id" } = Astro.props;

const includedFeatures: { titleKey: TranslationKey; descKey: TranslationKey; icon: any; color: string; bg: string }[] = [
  {
    titleKey: "pricing.inc.1.title",
    descKey: "pricing.inc.1.desc",
    icon: Globe,
    color: "text-blue-500",
    bg: "bg-blue-500/10"
  },
  {
    titleKey: "pricing.inc.2.title",
    descKey: "pricing.inc.2.desc",
    icon: Lock,
    color: "text-emerald-500",
    bg: "bg-emerald-500/10"
  },
  {
    titleKey: "pricing.inc.3.title",
    descKey: "pricing.inc.3.desc",
    icon: Smartphone,
    color: "text-orange-500",
    bg: "bg-orange-500/10"
  },
  {
    titleKey: "pricing.inc.4.title",
    descKey: "pricing.inc.4.desc",
    icon: Zap,
    color: "text-yellow-500",
    bg: "bg-yellow-500/10"
  },
  {
    titleKey: "pricing.inc.5.title",
    descKey: "pricing.inc.5.desc",
    icon: MessageCircle,
    color: "text-green-500",
    bg: "bg-green-500/10"
  }
];
---

<section class="relative w-full px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto pt-12">
  <div class="text-center mb-16 max-w-2xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary tracking-tight" data-i18n="pricing.inc.title">
      {t(lang, "pricing.inc.title")}
    </h2>
    <p class="mt-4 text-text-secondary text-lg leading-relaxed" data-i18n="pricing.inc.subtitle">
      {t(lang, "pricing.inc.subtitle")}
    </p>
  </div>

  <div id="pricing-included-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
    {includedFeatures.map((feature) => {
      const Icon = feature.icon;
      return (
        <div class="included-card group relative flex flex-col p-6 md:p-8 rounded-[2rem] bg-surface/90 shadow-sm border border-border/60 overflow-hidden cursor-default transition-all duration-500 hover:shadow-md hover:bg-surface/95">
          
          <div class="absolute -inset-px rounded-[2rem] bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

          <div class={`included-icon-wrapper w-12 h-12 md:w-14 md:h-14 rounded-2xl ${feature.bg} flex items-center justify-center mb-6 relative z-10 transition-transform duration-300`}>
            <Icon class={`included-icon w-6 h-6 md:w-7 md:h-7 ${feature.color}`} />
          </div>
          
          <div class="relative z-10 space-y-3">
            <h4 class="text-base md:text-xl font-bold text-text-primary" data-i18n={feature.titleKey}>{t(lang, feature.titleKey)}</h4>
            <p class="text-xs md:text-sm text-text-secondary leading-relaxed font-medium" data-i18n={feature.descKey}>
              {t(lang, feature.descKey)}
            </p>
          </div>
          
        </div>
      );
    })}
  </div>

  <script>
    import { animate, stagger, hover, inView } from "motion";

    document.addEventListener("DOMContentLoaded", () => {
      const cards = document.querySelectorAll(".included-card");
      const section = document.querySelector("#pricing-included-grid") as HTMLElement;
      
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      
      if (!prefersReducedMotion && section) {
        cards.forEach(c => { 
          (c as HTMLElement).style.opacity = '0'; 
          (c as HTMLElement).style.transform = 'translateY(20px) scale(0.95)'; 
        });
        inView(section, () => {
          animate(
            cards,
            { opacity: [0, 1], scale: [0.95, 1], y: [20, 0] },
            { delay: stagger(0.1, { startDelay: 0.2 }), duration: 0.6, easing: [0.22, 1, 0.36, 1] }
          );
        }, { margin: "-10% 0px" });
      } else {
         cards.forEach(c => { (c as HTMLElement).style.opacity = '1'; (c as HTMLElement).style.transform = 'none'; });
      }

      if (!prefersReducedMotion) {
        cards.forEach((card) => {
          const iconWrapper = card.querySelector(".included-icon-wrapper");
          const icon = card.querySelector(".included-icon");
          
          hover(card, () => {
            animate(card, { y: -5 }, { duration: 0.3, easing: "ease-out" });
            
            if (iconWrapper && icon) {
              animate(
                iconWrapper, 
                { scale: [1, 1.15, 1], rotate: [0, -10, 10, -5, 0] }, 
                { duration: 0.5, easing: "ease-out" }
              );
            }
            
            return () => {
              animate(card, { y: 0 }, { duration: 0.4, easing: "ease-out" });
            };
          });
        });
      }
    });
  </script>
</section>
