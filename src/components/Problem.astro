---
// src/components/Problem.astro
---
<section class="py-16 md:py-32 bg-background relative overflow-hidden">

  <!-- Background Decorative Blurs -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <div class="absolute top-[10%] left-[-10%] w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-red-500/10 to-transparent rounded-full blur-[32px] md:blur-[48px] opacity-70 transform-gpu"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="problem-header max-w-2xl mx-auto text-center mb-10 md:mb-20">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-red-500/20 bg-red-500/10 text-red-400 font-bold tracking-widest uppercase text-[10px] md:text-xs mb-4 md:mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Tantangan Bisnis
      </span>
      <h2 class="text-3xl md:text-5xl font-black text-text-primary leading-[1.15] md:leading-[1.1] text-balance tracking-tight">
        Media Sosial Saja <br class="hidden sm:block" /> <span class="text-red-500">Tidak Pernah Cukup.</span>
      </h2>
      <p class="mt-4 md:mt-6 text-base md:text-xl text-text-secondary leading-relaxed text-balance font-medium">
        Jangan bangun bisnis di tanah sewaan. Anda butuh pondasi digital yang 100% Anda kendalikan.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 lg:gap-8">
      
      <!-- Card 1 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-[2rem] p-5 md:p-8 xl:p-10 md:hover:-translate-y-1 md:hover:shadow-sm md:hover:border-red-500/30 md:hover:bg-surface-elevated/40 active:scale-[0.98] active:bg-surface-elevated/80 flex flex-col overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/10 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>
        
        <div class="relative z-10 flex flex-row md:flex-col gap-4 md:gap-0 h-full">
          <!-- Icon -->
          <div class="shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 md:mb-6 md:group-hover:scale-110 md:group-hover:bg-red-500/20 md:group-hover:shadow-[0_0_20px_rgba(239,68,68,0.2)] transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          
          <!-- Text Content -->
          <div class="flex flex-col flex-1">
            <h3 class="text-lg md:text-xl font-bold text-text-primary mb-1.5 md:mb-3 md:group-hover:text-red-400 transition-colors duration-300 tracking-tight leading-tight">
              Pembeli Butuh Kepastian
            </h3>
            <p class="text-text-secondary text-[14px] md:text-[15px] leading-relaxed mb-4 md:mb-8 font-medium">
              Banyak calon pembeli ragu transfer jika Anda tidak memiliki profil website resmi.
            </p>
            
            <!-- Highlight -->
            <div class="mt-auto pt-3 md:pt-5 border-t border-glass-5 md:group-hover:border-glass-10 transition-colors duration-300">
              <div class="inline-flex items-center gap-2 text-[12px] md:text-[13px] font-semibold text-text-muted md:group-hover:text-text-primary transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-400"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Naikkan kredibilitas instan
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-[2rem] p-5 md:p-8 xl:p-10 md:hover:-translate-y-1 md:hover:shadow-sm md:hover:border-red-500/30 md:hover:bg-surface-elevated/40 active:scale-[0.98] active:bg-surface-elevated/80 flex flex-col overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/10 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>
        
        <div class="relative z-10 flex flex-row md:flex-col gap-4 md:gap-0 h-full">
          <div class="shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 md:mb-6 md:group-hover:scale-110 md:group-hover:bg-red-500/20 md:group-hover:shadow-[0_0_20px_rgba(239,68,68,0.2)] transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          
          <div class="flex flex-col flex-1">
            <h3 class="text-lg md:text-xl font-bold text-text-primary mb-1.5 md:mb-3 md:group-hover:text-red-400 transition-colors duration-300 tracking-tight leading-tight">
              Lelah Menjawab DM
            </h3>
            <p class="text-text-secondary text-[14px] md:text-[15px] leading-relaxed mb-4 md:mb-8 font-medium">
              Waktu habis membalas pertanyaan yang sama. Biarkan website menerima pesanan 24 jam penuh.
            </p>
            
            <div class="mt-auto pt-3 md:pt-5 border-t border-glass-5 md:group-hover:border-glass-10 transition-colors duration-300">
              <div class="inline-flex items-center gap-2 text-[12px] md:text-[13px] font-semibold text-text-muted md:group-hover:text-text-primary transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-400"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                Hemat waktu operasional
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-[2rem] p-5 md:p-8 xl:p-10 md:hover:-translate-y-1 md:hover:shadow-sm md:hover:border-red-500/30 md:hover:bg-surface-elevated/40 active:scale-[0.98] active:bg-surface-elevated/80 flex flex-col overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/10 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>
        
        <div class="relative z-10 flex flex-row md:flex-col gap-4 md:gap-0 h-full">
          <div class="shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 md:mb-6 md:group-hover:scale-110 md:group-hover:bg-red-500/20 md:group-hover:shadow-[0_0_20px_rgba(239,68,68,0.2)] transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          
          <div class="flex flex-col flex-1">
            <h3 class="text-lg md:text-xl font-bold text-text-primary mb-1.5 md:mb-3 md:group-hover:text-red-400 transition-colors duration-300 tracking-tight leading-tight">
              Sulit Tembus Klien B2B
            </h3>
            <p class="text-text-secondary text-[14px] md:text-[15px] leading-relaxed mb-4 md:mb-8 font-medium">
              Klien korporat mencari profil Anda di Google. Tanpa website, penawaran Anda mudah diremehkan.
            </p>
            
            <div class="mt-auto pt-3 md:pt-5 border-t border-glass-5 md:group-hover:border-glass-10 transition-colors duration-300">
              <div class="inline-flex items-center gap-2 text-[12px] md:text-[13px] font-semibold text-text-muted md:group-hover:text-text-primary transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-400"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Tampil profesional & meyakinkan
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-[2rem] p-5 md:p-8 xl:p-10 md:hover:-translate-y-1 md:hover:shadow-sm md:hover:border-red-500/30 md:hover:bg-surface-elevated/40 active:scale-[0.98] active:bg-surface-elevated/80 flex flex-col overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/10 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>
        
        <div class="relative z-10 flex flex-row md:flex-col gap-4 md:gap-0 h-full">
          <div class="shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 md:mb-6 md:group-hover:scale-110 md:group-hover:bg-red-500/20 md:group-hover:shadow-[0_0_20px_rgba(239,68,68,0.2)] transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/></svg>
          </div>
          
          <div class="flex flex-col flex-1">
            <h3 class="text-lg md:text-xl font-bold text-text-primary mb-1.5 md:mb-3 md:group-hover:text-red-400 transition-colors duration-300 tracking-tight leading-tight">
              Algoritma Sering Berubah
            </h3>
            <p class="text-text-secondary text-[14px] md:text-[15px] leading-relaxed mb-4 md:mb-8 font-medium">
              Jangkauan konten bisa anjlok tiba-tiba. Anda butuh aset digital mandiri yang 100% aman.
            </p>
            
            <div class="mt-auto pt-3 md:pt-5 border-t border-glass-5 md:group-hover:border-glass-10 transition-colors duration-300">
              <div class="inline-flex items-center gap-2 text-[12px] md:text-[13px] font-semibold text-text-muted md:group-hover:text-text-primary transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-400"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Pegang kendali penuh
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const header = document.querySelector(".problem-header");
    const cards = document.querySelectorAll(".problem-card");
    const section = document.querySelector("#problem-section") || header; // Or just observe the header

    if (header) header.style.opacity = "0";
    cards.forEach(c => (c as HTMLElement).style.opacity = "0");

    let animated = false;
    inView(header, () => {
      if (animated) return;
      animated = true;

      const isMobile = window.innerWidth < 768;
      const yOffset = isMobile ? 16 : 32;

      // Animate header first
      animate(
        header,
        { opacity: [0, 1], y: [yOffset, 0] },
        { duration: 0.6, easing: [0.22, 1, 0.36, 1] }
      );

      // Animate cards with stagger slightly after header starts
      setTimeout(() => {
        animate(
          ".problem-card",
          { opacity: [0, 1], y: [yOffset, 0] },
          { duration: 0.6, delay: stagger(isMobile ? 0.05 : 0.1), easing: [0.22, 1, 0.36, 1] }
        );
      }, 200);

    }, { margin: "-15% 0px" });
  }
</script>