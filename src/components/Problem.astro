---
// src/components/Problem.astro — Masalah Bisnis di Lapangan
---
<section class="py-20 md:py-32 bg-background relative overflow-hidden">

  <!-- Background Decorative Blur -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <div class="absolute top-[10%] left-[-10%] w-[400px] md:w-[600px] h-[400px] md:h-[600px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-red-500/8 to-transparent rounded-full blur-[48px] md:blur-[64px] opacity-70 transform-gpu"></div>
    <div class="absolute bottom-[10%] right-[-5%] w-[300px] h-[300px] bg-[radial-gradient(circle,_var(--tw-gradient-stops))] from-primary/8 to-transparent rounded-full blur-[48px] transform-gpu"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="problem-header max-w-2xl mx-auto text-center mb-12 md:mb-20">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-red-500/20 bg-red-500/10 text-red-400 font-bold tracking-widest uppercase text-[10px] md:text-xs mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Masalah di Lapangan
      </span>
      <h2 class="text-3xl md:text-5xl font-black text-text-primary leading-[1.15] md:leading-[1.1] text-balance tracking-tight">
        Masalah yang Sering <br class="hidden sm:block"/><span class="text-red-500">Dialami Pemilik Usaha.</span>
      </h2>
      <p class="mt-4 md:mt-6 text-base md:text-lg text-text-secondary leading-relaxed text-balance">
        Kalau sistem digitalnya belum rapi, banyak calon pelanggan yang akhirnya batal atau pindah ke tempat lain.
      </p>
    </div>

    <!-- Row 1: 2 cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 mb-5 md:mb-6">

      <!-- Problem Card 1 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-3xl overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-red-500/30 active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/8 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="p-6 md:p-8 relative z-10">
          <div class="flex items-start gap-4 mb-5">
            <div class="shrink-0 w-11 h-11 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-red-400/80 block mb-1">Masalah</span>
              <h3 class="text-base md:text-lg font-bold text-text-primary leading-snug">Pelanggan harus nanya berkali-kali cuma buat tahu harga dan layanan</h3>
            </div>
          </div>
          <div class="pl-[60px] space-y-3">
            <p class="text-text-secondary text-sm leading-relaxed">Waktu habis buat balas chat yang pertanyaannya itu-itu saja. Kalau balasnya agak lama, calon pembeli keburu cari tempat lain.</p>
            <div class="flex items-center gap-2 pt-2 border-t border-border/40">
              <div class="w-6 h-6 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-xs font-semibold text-text-primary">Website kasih info harga &amp; layanan 24 jam tanpa harus nunggu balasan admin</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Problem Card 2 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-3xl overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-red-500/30 active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/8 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="p-6 md:p-8 relative z-10">
          <div class="flex items-start gap-4 mb-5">
            <div class="shrink-0 w-11 h-11 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-red-400/80 block mb-1">Masalah</span>
              <h3 class="text-base md:text-lg font-bold text-text-primary leading-snug">Info bisnis kepencar di berbagai platform dan susah dicari</h3>
            </div>
          </div>
          <div class="pl-[60px] space-y-3">
            <p class="text-text-secondary text-sm leading-relaxed">Harga ada di WhatsApp, foto produk di Instagram, alamat di Google Maps. Calon pelanggan jadi bingung mau lihat info lengkapnya di mana.</p>
            <div class="flex items-center gap-2 pt-2 border-t border-border/40">
              <div class="w-6 h-6 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-xs font-semibold text-text-primary">Satu website jadi pusat info lengkap bisnis Anda</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Row 2: 3 cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">

      <!-- Problem Card 3 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-3xl overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-red-500/30 active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/8 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="p-6 md:p-7 relative z-10 h-full flex flex-col">
          <div class="shrink-0 w-11 h-11 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-red-400/80 block mb-2">Masalah</span>
          <h3 class="text-base font-bold text-text-primary mb-3 leading-snug">Calon pelanggan ribet pas mau pesan</h3>
          <p class="text-text-secondary text-sm leading-relaxed flex-1">Alur pesannya masih manual dan kepanjangan. Banyak yang tadinya sudah niat beli, tapi malah batal di tengah jalan.</p>
          <div class="flex items-center gap-2 pt-4 mt-4 border-t border-border/40">
            <div class="w-6 h-6 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-xs font-semibold text-text-primary">Alur pemesanan jadi simpel dan jelas</span>
          </div>
        </div>
      </div>

      <!-- Problem Card 4 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-3xl overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-red-500/30 active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/8 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="p-6 md:p-7 relative z-10 h-full flex flex-col">
          <div class="shrink-0 w-11 h-11 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/></svg>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-red-400/80 block mb-2">Masalah</span>
          <h3 class="text-base font-bold text-text-primary mb-3 leading-snug">Bisnis cuma ngandelin media sosial</h3>
          <p class="text-text-secondary text-sm leading-relaxed flex-1">Algoritma bisa berubah kapan saja. Jangkauan postingan bisa tiba-tiba turun tanpa bisa Anda atur.</p>
          <div class="flex items-center gap-2 pt-4 mt-4 border-t border-border/40">
            <div class="w-6 h-6 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-xs font-semibold text-text-primary">Punya aset digital sendiri yang 100% Anda pegang</span>
          </div>
        </div>
      </div>

      <!-- Problem Card 5 -->
      <div class="problem-card group relative bg-surface-elevated border border-border rounded-2xl md:rounded-3xl overflow-hidden transition-all duration-300 md:hover:-translate-y-1 md:hover:border-red-500/30 active:scale-[0.98]">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/8 via-transparent to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="p-6 md:p-7 relative z-10 h-full flex flex-col">
          <div class="shrink-0 w-11 h-11 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-red-400/80 block mb-2">Masalah</span>
          <h3 class="text-base font-bold text-text-primary mb-3 leading-snug">Banyak yang lihat produk, tapi nggak lanjut beli</h3>
          <p class="text-text-secondary text-sm leading-relaxed flex-1">Kalau tombol ajakan (CTA) nggak jelas dan infonya tanggung, pengunjung cuma lihat-lihat lalu pergi begitu saja.</p>
          <div class="flex items-center gap-2 pt-4 mt-4 border-t border-border/40">
            <div class="w-6 h-6 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-xs font-semibold text-text-primary">Tampilan yang ngarahin pengunjung buat ambil tindakan</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const header = document.querySelector(".problem-header");
    const cards = document.querySelectorAll(".problem-card");

    if (header) (header as HTMLElement).style.opacity = "0";
    cards.forEach(c => (c as HTMLElement).style.opacity = "0");

    let animated = false;
    if (header) {
      inView(header, () => {
        if (animated) return;
        animated = true;

        const isMobile = window.innerWidth < 768;
        const yOffset = isMobile ? 16 : 28;

        animate(
          header,
          { opacity: [0, 1], y: [yOffset, 0] },
          { duration: 0.6, easing: [0.22, 1, 0.36, 1] }
        );

        setTimeout(() => {
          animate(
            ".problem-card",
            { opacity: [0, 1], y: [yOffset, 0] },
            { duration: 0.55, delay: stagger(isMobile ? 0.04 : 0.08), easing: [0.22, 1, 0.36, 1] }
          );
        }, 200);
      }, { margin: "-15% 0px" });
    }
  }
</script>
