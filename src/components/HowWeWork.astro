---
// src/components/HowWeWork.astro
---

<section id="how-we-work" class="py-24 md:py-32 bg-background relative overflow-hidden">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="hww-header max-w-3xl mx-auto text-center mb-16 md:mb-24 px-2 md:px-0">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 mb-6 rounded-full border border-border bg-surface shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-text-primary">Alur Kerja</span>
      </div>
      
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight text-balance mb-4 md:mb-6">
        Proses Kerja yang Jelas
      </h2>
      
      <p class="text-base sm:text-lg text-text-secondary leading-relaxed text-balance">
        Dari awal diskusi sampai website jadi, setiap langkah berjalan transparan dan bisa Anda pantau.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="hww-timeline relative">
      
      <!-- Subtle Connector Lines (Hidden behind cards, visible in gaps) -->
      <div class="absolute inset-0 z-0 pointer-events-none">
        <!-- Desktop Horizontal Line -->
        <div class="hidden lg:block absolute top-[56px] left-[5%] right-[5%] h-[1px] bg-gradient-to-r from-transparent via-border to-transparent"></div>
        
        <!-- Mobile Vertical Line -->
        <div class="block md:hidden absolute top-[5%] bottom-[5%] left-[48px] w-[1px] bg-gradient-to-b from-transparent via-border to-transparent"></div>
      </div>

      <!-- Steps Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 relative z-10">
        
        <!-- Step 1: Diskusi -->
        <div class="group relative bg-surface-elevated border border-border/50 rounded-2xl p-6 lg:p-8 transition-all duration-500 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col h-full">
          
          <div class="flex items-center justify-between mb-6 md:mb-8">
            <div class="w-12 h-12 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary group-hover:text-primary transition-all duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="px-3 py-1 text-[10px] md:text-xs font-bold uppercase tracking-wider rounded-full bg-surface border border-border text-text-muted group-hover:text-text-primary transition-colors duration-500">
              Langkah 1
            </div>
          </div>
          
          <h3 class="text-lg md:text-xl font-bold text-text-primary mb-2 md:mb-3">Ngobrol Kebutuhan</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Ceritakan apa yang bisnis Anda butuhkan. Kami bantu susun fitur utama tanpa memaksa tambahan yang tak perlu.
          </p>
        </div>

        <!-- Step 2: Desain -->
        <div class="group relative bg-surface-elevated border border-border/50 rounded-2xl p-6 lg:p-8 transition-all duration-500 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col h-full">
          
          <div class="flex items-center justify-between mb-6 md:mb-8">
            <div class="w-12 h-12 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary group-hover:text-primary transition-all duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div class="px-3 py-1 text-[10px] md:text-xs font-bold uppercase tracking-wider rounded-full bg-surface border border-border text-text-muted group-hover:text-text-primary transition-colors duration-500">
              Langkah 2
            </div>
          </div>
          
          <h3 class="text-lg md:text-xl font-bold text-text-primary mb-2 md:mb-3">Cek Desain Awal</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Kami menyiapkan konsep tampilan atau wireframe sederhana sebagai acuan. Untuk project yang lebih kompleks, desain dibuat lebih detail sebelum proses pengembangan dimulai.
          </p>
        </div>

        <!-- Step 3: Development -->
        <div class="group relative bg-surface-elevated border border-border/50 rounded-2xl p-6 lg:p-8 transition-all duration-500 md:hover:-translate-y-1 md:hover:border-border md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col h-full">
          
          <div class="flex items-center justify-between mb-6 md:mb-8">
            <div class="w-12 h-12 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary group-hover:text-primary transition-all duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <div class="px-3 py-1 text-[10px] md:text-xs font-bold uppercase tracking-wider rounded-full bg-surface border border-border text-text-muted group-hover:text-text-primary transition-colors duration-500">
              Langkah 3
            </div>
          </div>
          
          <h3 class="text-lg md:text-xl font-bold text-text-primary mb-2 md:mb-3">Mulai Koding</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Tim kami merancang sistem dengan kode rapi agar website berjalan ringan tanpa error.
          </p>
        </div>

        <!-- Step 4: Launch -->
        <div class="group relative bg-surface-elevated border border-primary/20 rounded-2xl p-6 lg:p-8 transition-all duration-500 md:hover:-translate-y-1 md:hover:border-primary/50 md:hover:shadow-soft-lg active:scale-[0.98] flex flex-col h-full">
          
          <div class="flex items-center justify-between mb-6 md:mb-8">
            <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-primary-foreground shadow-sm group-hover:scale-110 transition-transform duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15a2.18 2.18 0 0 0-2.91-.09c-.79.78-.81 2.07-.09 2.91 1.26 1.5 5 2 5 2s-.5-3.74-2-5"/><path d="M9 12a2.18 2.18 0 0 0-2.91-.09c-.79.78-.81 2.07-.09 2.91 1.26 1.5 5 2 5 2s-.5-3.74-2-5"/><path d="M15 12a2.18 2.18 0 0 0-2.91-.09c-.79.78-.81 2.07-.09 2.91 1.26 1.5 5 2 5 2s-.5-3.74-2-5"/><path d="M22 2 7 17"/></svg>
            </div>
            <div class="px-3 py-1 text-[10px] md:text-xs font-bold uppercase tracking-wider rounded-full bg-surface border border-primary/20 text-primary transition-colors duration-500">
              Langkah 4
            </div>
          </div>
          
          <h3 class="text-lg md:text-xl font-bold text-text-primary mb-2 md:mb-3">Cek Akhir & Rilis</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Setelah semua fitur dipastikan berjalan normal, website resmi diserahkan kepada Anda.
          </p>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  import { animate, inView } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const header = document.querySelector(".hww-header");
    const timeline = document.querySelector(".hww-timeline");

    if (header) header.style.opacity = "0";
    if (timeline) timeline.style.opacity = "0";

    let animated = false;
    inView("#how-we-work", () => {
      if (animated) return;
      animated = true;

      const isMobile = window.innerWidth < 768;
      const yOffset = isMobile ? 16 : 32;

      if (header) {
        animate(
          header,
          { opacity: [0, 1], y: [yOffset, 0] },
          { duration: 0.6, easing: [0.22, 1, 0.36, 1] }
        );
      }

      if (timeline) {
        setTimeout(() => {
          animate(
            timeline,
            { opacity: [0, 1], y: [yOffset, 0] },
            { duration: 0.6, easing: [0.22, 1, 0.36, 1] }
          );
        }, 200);
      }

    }, { margin: "-15% 0px" });
  }
</script>
