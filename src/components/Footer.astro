---
import { Instagram } from 'lucide-astro';
import { t, getLocalizedPath, type Locale, type TranslationKey } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'id' } = Astro.props;

const footerLinks: { key: TranslationKey; baseHref: string }[] = [
  { key: "nav.home", baseHref: "/" },
  { key: "nav.tentang", baseHref: "/tentang" },
  { key: "nav.layanan", baseHref: "/layanan" },
  { key: "nav.portfolio", baseHref: "/portfolio" },
  { key: "nav.pricing", baseHref: "/pricing" },
  { key: "nav.faq", baseHref: "/faq" },
  { key: "nav.contact", baseHref: "/contact" },
];
---
<footer class="bg-surface border-t border-border py-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-start gap-8">
      <!-- Brand -->
      <div>
        <span class="text-xl font-black tracking-widest text-primary uppercase">GALACODE</span>
        <p class="text-sm text-text-secondary mt-2" data-i18n="footer.tagline">{t(lang, "footer.tagline")}</p>
        <p class="text-sm text-text-secondary mt-1" data-i18n="footer.copyright">{t(lang, "footer.copyright")}</p>
      </div>
      <!-- Nav Links -->
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        {footerLinks.map((link) => (
          <a
            href={getLocalizedPath(link.baseHref, lang)}
            data-base-href={link.baseHref}
            data-i18n={link.key}
            class="text-sm text-text-muted hover:text-text-primary transition-colors"
          >
            {t(lang, link.key)}
          </a>
        ))}
      </div>
      <!-- Social -->
      <div class="flex gap-5">
        <a href="https://instagram.com/galacode.id" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-text-muted hover:text-primary transition-transform hover:-translate-y-1">
          <Instagram class="w-6 h-6" />
        </a>
        <a href="https://tiktok.com/@galacode.id" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-text-muted hover:text-primary transition-transform hover:-translate-y-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.01.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.22-1.15 4.39-2.95 5.67-1.8 1.28-4.22 1.63-6.29 1.11-2.07-.52-3.83-1.95-4.73-3.89-.9-1.94-.85-4.28.14-6.19 1.05-2 3.12-3.4 5.38-3.69v4.06c-1.07.16-2.09.79-2.67 1.69-.58.91-.66 2.08-.2 3.07.45.99 1.45 1.7 2.54 1.83 1.09.12 2.21-.24 2.96-1.01.76-.77 1.13-1.88 1.14-2.98.02-3.64.01-7.29.01-10.94.02-3.64.01-7.29.02-10.94z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
